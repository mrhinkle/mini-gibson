{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-gibson.invalid/schemas/exclusion-registry.v1.schema.json",
  "title": "Mini Gibson real-repository exclusion registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "source_digests", "entries"],
  "properties": {
    "schema_version": {"const": "mini-gibson-exclusion-registry/v1"},
    "registry_id": {"type": "string", "minLength": 1},
    "source_digests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value", "source"],
        "properties": {
          "kind": {
            "enum": [
              "instance_id", "repo", "repo_pr", "repo_issue", "base_commit",
              "merge_commit", "image_cluster_sha256", "patch_sha256",
              "test_patch_sha256", "issue_text_sha256", "changed_files_sha256",
              "ast_edits_sha256", "episode_id", "statement_token"
            ]
          },
          "value": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
