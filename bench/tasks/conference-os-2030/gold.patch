+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+interface ScheduleTrackGuideProps {
+  tracks: Array<{
+    id: string;
+    name: string;
+    /** Public presentation copy; organizer descriptions must not be passed here. */
+    marketingDescription?: string | null;
+  }>;
+  selectedTrackId: string | null;
+}
+
+export function ScheduleTrackGuide({ tracks, selectedTrackId }: ScheduleTrackGuideProps) {
+  const describedTracks = tracks.flatMap((track) => {
+    const description = track.marketingDescription?.trim();
+    if (!description || (selectedTrackId !== null && track.id !== selectedTrackId)) {
+      return [];
+    }
+    return [{ id: track.id, name: track.name, description }];
+  });
+
+  if (describedTracks.length === 0) return null;
+
+  return (
+    <details open className="mb-8 rounded-xl border border-gray-200 bg-white p-5 sm:p-6">
+      <summary className="cursor-pointer rounded-sm text-base font-semibold text-gray-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nebula-500 focus-visible:ring-offset-4">
+        About the tracks
+      </summary>
+      <dl className="mt-5 grid gap-x-8 gap-y-6 md:grid-cols-2">
+        {describedTracks.map((track) => (
+          <div key={track.id} className="min-w-0">
+            <dt className="break-words font-semibold text-gray-900">{track.name}</dt>
+            <dd className="mt-1.5 whitespace-pre-line break-words text-sm leading-relaxed text-gray-600">
+              {track.description}
+            </dd>
+          </div>
+        ))}
+      </dl>
+    </details>
+  );
+}
