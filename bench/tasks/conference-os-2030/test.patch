+ * via any medium, is strictly prohibited.
+ */
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { fireEvent } from '@testing-library/react';
+import { describe, expect, it } from 'vitest';
+import { render, screen, within } from '../helpers/component-render';
+import ScheduleClient from '../../src/app/(public)/events/[eventSlug]/schedule/schedule-client';
+import { ScheduleTrackGuide } from '../../src/app/(public)/events/[eventSlug]/schedule/schedule-track-guide';
+
+const tracks = [
+  { id: 'builders', name: 'Builders', color: '#0055ff', marketingDescription: 'Build useful AI products.' },
+  { id: 'users', name: 'Users', color: '#0055ff', marketingDescription: 'Use AI in your daily work.' },
+  { id: 'keynote', name: 'Keynote', color: null, marketingDescription: null },
+];
+
+describe('public schedule track guide', () => {
+  it('includes all public descriptions in initial HTML as escaped, untruncated text', () => {
+    const description = '<script>alert("test")</script>\n' + 'Full public copy. '.repeat(30);
+    const html = renderToStaticMarkup(createElement(ScheduleTrackGuide, {
+      tracks: [...tracks, { id: 'long', name: 'Long <track>', marketingDescription: description }],
+      selectedTrackId: null,
+    }));
+    const document = new DOMParser().parseFromString(html, 'text/html');
+    expect(document.querySelector('details')?.open).toBe(true);
+    expect(document.querySelectorAll('dt')).toHaveLength(3);
+    expect(Array.from(document.querySelectorAll('dd'), (item) => item.textContent)).toEqual([
+      tracks[0].marketingDescription, tracks[1].marketingDescription, description.trim(),
+    ]);
+    expect(document.querySelector('script')).toBeNull();
+  });
+
+  it.each([null, '', ' \n\t ', undefined])('omits an empty guide for %j public copy', (copy) => {
+    const html = renderToStaticMarkup(createElement(ScheduleTrackGuide, {
+      tracks: [{ id: 'empty', name: 'Empty', marketingDescription: copy }], selectedTrackId: null,
+    }));
+    expect(html).toBe('');
+  });
+
+  it.each(['keynote', 'unknown'])('omits the guide for a selection with no public copy: %s', (id) => {
+    expect(renderToStaticMarkup(createElement(ScheduleTrackGuide, {
+      tracks, selectedTrackId: id,
+    }))).toBe('');
+  });
+
+  it.each(['table', 'grid', 'broadside'] as const)('keeps descriptions in sync with %s track filters', (view) => {
+    render(createElement(ScheduleClient, {
+      eventSlug: 'test-event', timezone: 'UTC', tracks, sessions: [],
+      visualTemplate: view === 'broadside' ? 'broadside' : 'orbit',
+    }));
+    if (view === 'grid') fireEvent.click(screen.getByRole('button', { name: 'Grid' }));
+
+    expect(screen.getByText('Build useful AI products.')).toBeTruthy();
+    expect(screen.getByText('Use AI in your daily work.')).toBeTruthy();
+    const filters = within(screen.getByRole('group', { name: 'Tracks' }));
+    fireEvent.click(filters.getByRole('button', { name: 'Users' }));
+    expect(screen.getByText('Use AI in your daily work.')).toBeTruthy();
+    expect(screen.queryByText('Build useful AI products.')).toBeNull();
+
+    fireEvent.click(filters.getByRole('button', { name: 'Keynote' }));
+    expect(screen.queryByText('About the tracks')).toBeNull();
+    fireEvent.click(filters.getByRole('button', { name: 'All Tracks' }));
+    expect(screen.getByText('Build useful AI products.')).toBeTruthy();
+    expect(screen.getByText('Use AI in your daily work.')).toBeTruthy();
+  });
+});
