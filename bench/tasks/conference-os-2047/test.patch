+  it('pins PLACE map town labels and sector headings above 4.5 to 1 on their real surfaces (#2037)', () => {
+    const placeSource = readFileSync(
+      join(process.cwd(), 'src/components/homepage/place.tsx'),
+      'utf8',
+    );
+    const mapSource = readFileSync(
+      join(process.cwd(), 'src/components/homepage/place-triangle-map.tsx'),
+      'utf8',
+    );
+    const globalCss = readFileSync(
+      join(process.cwd(), 'src/app/globals.css'),
+      'utf8',
+    );
+    const space900 = readColorToken(globalCss, '--color-space-900');
+    const openSurface = composite(WHITE, space900, 0.04);
+    const renderedWhite50OnOpen = composite(WHITE, openSurface, 0.5);
+    const renderedWhite50OnSection = composite(WHITE, space900, 0.5);
+    const renderedWhite45OnOpen = composite(WHITE, openSurface, 0.45);
+    const renderedWhite45OnSection = composite(WHITE, space900, 0.45);
+
+    expect(placeSource).toContain('bg-space-900');
+    expect(mapSource).toContain('open:bg-white/[0.04]');
+    expect(mapSource).toContain('shrink-0 text-xs text-white/50');
+    expect(mapSource).toContain(
+      'text-xs uppercase tracking-[0.18em] text-white/50',
+    );
+    expect(mapSource).not.toContain('shrink-0 text-xs text-white/45');
+    expect(mapSource).not.toContain(
+      'text-xs uppercase tracking-[0.18em] text-white/45',
+    );
+    expect(contrastRatio(renderedWhite45OnOpen, openSurface)).toBeLessThan(4.5);
+    expect(contrastRatio(renderedWhite45OnSection, space900)).toBeLessThan(4.5);
+    expect(
+      contrastRatio(renderedWhite50OnOpen, openSurface),
+    ).toBeGreaterThanOrEqual(4.5);
+    expect(
+      contrastRatio(renderedWhite50OnSection, space900),
+    ).toBeGreaterThanOrEqual(4.5);
+  });
+
+  it('pins TRACKS outro eyebrow above 4.5 to 1 on the tinted card, and leaves the icon at /45 (#2037)', () => {
+    const tracksSource = readFileSync(
+      join(process.cwd(), 'src/components/homepage/tracks.tsx'),
+      'utf8',
+    );
+    const globalCss = readFileSync(
+      join(process.cwd(), 'src/app/globals.css'),
+      'utf8',
+    );
+    const space900 = readColorToken(globalCss, '--color-space-900');
+    const cardSurface = composite(WHITE, space900, 0.04);
+    const iconSurface = composite(WHITE, cardSurface, 0.04);
+    const renderedWhite50 = composite(WHITE, cardSurface, 0.5);
+    const renderedWhite45 = composite(WHITE, cardSurface, 0.45);
+    const renderedIcon45 = composite(WHITE, iconSurface, 0.45);
+
+    expect(tracksSource).toContain('bg-space-900');
+    expect(tracksSource).toContain('bg-white/[0.04]');
+    expect(tracksSource).toContain(
+      'text-xs uppercase tracking-[0.18em] text-white/50',
+    );
+    expect(tracksSource).not.toContain(
+      'text-xs uppercase tracking-[0.18em] text-white/45',
+    );
+    expect(tracksSource).toContain(
+      'rounded-full bg-white/[0.04] text-white/45',
+    );
+    expect(contrastRatio(renderedWhite45, cardSurface)).toBeLessThan(4.5);
+    expect(contrastRatio(renderedWhite50, cardSurface)).toBeGreaterThanOrEqual(
+      4.5,
+    );
+    expect(contrastRatio(renderedIcon45, iconSurface)).toBeGreaterThanOrEqual(3);
+  });
 });
