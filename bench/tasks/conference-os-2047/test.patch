+describe('EventsDirectory EventCard accessible names (#2037)', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mocks.fetchDisplayMeetupEvents.mockResolvedValue([]);
+  });
+
+  it('keeps an upcoming Register CTA, event name, and type chip in the link contents', async () => {
+    const event: DirectoryEvent = {
+      id: 'evt-upcoming-named',
+      slug: 'upcoming-named',
+      name: 'Triangle AI Summit',
+      description: 'A conference for operators and builders.',
+      status: 'PUBLISHED',
+      startDate: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000),
+      endDate: new Date(Date.now() + 9 * 24 * 60 * 60 * 1000),
+      eventType: 'CONFERENCE',
+      websiteUrl: 'https://example.test/upcoming-named',
+      venue: null,
+      _count: { registrations: 12, sessions: 4, tracks: 2 },
+      sessions: [],
+    };
+
+    const markup = await renderDirectory(event);
+    const card = cardByHref(markup, '/events/upcoming-named');
+
+    expectNameFromVisibleText(card, {
+      name: 'Triangle AI Summit',
+      cta: 'Register',
+      typeChip: 'Conference',
+    });
+    expect(card.textContent).toContain('A conference for operators and builders.');
+    expect(card.textContent).toContain('Online');
+    expect(card.hasAttribute('target')).toBe(false);
+  });
+
+  it('keeps a past View Event CTA in the link contents', async () => {
+    const event: DirectoryEvent = {
+      id: 'evt-past-named',
+      slug: 'past-named',
+      name: 'Past Native Conference',
+      status: 'COMPLETED',
+      startDate: new Date('2020-06-01T00:00:00.000Z'),
+      endDate: new Date('2020-06-03T00:00:00.000Z'),
+      eventType: 'CONFERENCE',
+      websiteUrl: 'https://example.test/past-named',
+      venue: null,
+      _count: { registrations: 4, sessions: 2, tracks: 1 },
+      sessions: [],
+    };
+
+    const markup = await renderDirectory(event);
+    const card = cardByHref(markup, '/events/past-named');
+
+    expectNameFromVisibleText(card, {
+      name: 'Past Native Conference',
+      cta: 'View Event',
+      typeChip: 'Conference',
+    });
+    expect(card.getAttribute('href')).toBe('/events/past-named');
+  });
+
+  it('deep-links a recap card with replays and keeps Watch replays discoverable', async () => {
+    const event: DirectoryEvent = {
+      id: 'evt-recap-replays',
+      slug: 'recap-replays',
+      name: 'Replay Conference',
+      status: 'COMPLETED',
+      startDate: new Date('2025-04-01T00:00:00.000Z'),
+      endDate: new Date('2025-04-03T00:00:00.000Z'),
+      eventType: 'CONFERENCE',
+      websiteUrl: 'https://example.test/recap-replays',
+      venue: null,
+      _count: { registrations: 20, sessions: 3, tracks: 1 },
+      sessions: [
+        {
+          id: 'sess-replay-1',
+          recordingUrl: 'https://example.test/recording.mp4',
+          virtualSession: { recordingUrl: null },
+        },
+      ],
+    };
+
+    const markup = await renderDirectory(event);
+    const card = cardByHref(markup, '/events/recap-replays/recap');
+
+    expectNameFromVisibleText(card, {
+      name: 'Replay Conference',
+      cta: 'Watch replays',
+      typeChip: 'Conference',
+    });
+    expect(card.hasAttribute('target')).toBe(false);
+    expect(card.getAttribute('href')).toBe('/events/recap-replays/recap');
+  });
+
+  it('keeps an external pre-platform import on websiteUrl with target=_blank', async () => {
+    const event: DirectoryEvent = {
+      id: 'evt-import-named',
+      slug: 'import-named',
+      name: 'Imported Recap Conference',
+      status: 'COMPLETED',
+      startDate: new Date('2019-01-01T00:00:00.000Z'),
+      endDate: new Date('2019-01-03T00:00:00.000Z'),
+      eventType: 'CONFERENCE',
+      websiteUrl: 'https://example.test/imported',
+      venue: null,
+      _count: { registrations: 0, sessions: 0, tracks: 0 },
+      sessions: [],
+    };
+
+    const markup = await renderDirectory(event);
+    const card = cardByHref(markup, 'https://example.test/imported');
+
+    expect(card.getAttribute('target')).toBe('_blank');
+    expect(card.getAttribute('rel')).toBe('noopener noreferrer');
+    expectNameFromVisibleText(card, {
+      name: 'Imported Recap Conference',
+      cta: 'View Recap',
+      typeChip: 'Conference',
+    });
+  });
+});
