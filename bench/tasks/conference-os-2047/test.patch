+/** #2037: name comes from visible contents, not aria-label / aria-labelledby. */
+function expectNameFromVisibleText(
+  card: HTMLAnchorElement,
+  expected: { name: string; cta: string; typeChip?: string }
+): void {
+  expect(card.hasAttribute('aria-label')).toBe(false);
+  expect(card.hasAttribute('aria-labelledby')).toBe(false);
+  const text = card.textContent ?? '';
+  expect(text).toContain(expected.name);
+  expect(text).toContain(expected.cta);
+  if (expected.typeChip) expect(text).toContain(expected.typeChip);
+  const nameIndex = text.indexOf(expected.name);
+  const ctaIndex = text.lastIndexOf(expected.cta);
+  expect(nameIndex).toBeGreaterThanOrEqual(0);
+  expect(ctaIndex).toBeGreaterThan(nameIndex);
+}
