+/**
+ * Track/event ownership and room-venue membership for create/edit session
+ * actions. Room *availability* (isActive + venue hosts this event) is
+ * enforced separately by assertSessionRoomPlacement.
+ */
+export async function validateSessionRelations(
+  eventId: string,
+  relations: { trackId?: string | null; roomId?: string | null }
+) {
+  if (relations.trackId) {
+    const track = await prisma.track.findFirst({
+      where: buildEventScopedTrackWhere(eventId, relations.trackId),
+      select: { id: true },
+    });
+    if (!track) {
+      throw new Error('The selected track does not belong to this event.');
+    }
+  }
+
+  if (relations.roomId) {
+    const [event, room] = await Promise.all([
+      prisma.event.findUnique({
+        where: { id: eventId },
+        select: { venueId: true },
+      }),
+      prisma.room.findUnique({
+        where: { id: relations.roomId },
+        select: { venueId: true },
+      }),
+    ]);
+    if (!event || !room || !roomBelongsToEventVenue(event.venueId, room.venueId)) {
+      throw new Error('The selected room does not belong to this event venue.');
+    }
+  }
+}
