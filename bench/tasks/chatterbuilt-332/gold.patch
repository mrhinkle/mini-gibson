+/** Unresolved template placeholder token like `{REVIEWS_URL}` (whole value). */
+const TOKEN_ONLY_RE = /^\{[A-Z][A-Z0-9_]*\}$/;
+
+/**
+ * Usable URL-ish string: non-empty after trim and not a leftover `{TOKEN}`
+ * placeholder. Mirrors business-brain's usability bar (#331) — fail closed,
+ * never emit an empty or unresolved review link into a customer site.
+ */
+function isUsableUrlString(value: unknown): value is string {
+  if (typeof value !== "string") return false;
+  const t = value.trim();
+  if (!t) return false;
+  if (TOKEN_ONLY_RE.test(t)) return false;
+  return true;
+}
