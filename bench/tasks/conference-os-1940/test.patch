+
+function jsonShape(value: unknown): unknown {
+  return JSON.parse(JSON.stringify(value));
+}
+
+function rendererParsed(
+  type: ConfigEditableHomepageSectionType,
+  input: Record<string, unknown>,
+): object | null {
+  switch (type) {
+    case 'HERO':
+      return { slides: parseHeroPhotoSlides(input) };
+    case 'AUDIENCE_BAND':
+      return parseAudienceBandConfig(input);
+    case 'SPEAKERS':
+      return parseSpeakersConfig(input);
+    case 'MANIFESTO':
+      return parseManifestoConfig(input);
+    case 'PLACE':
+      return parsePlaceConfig(input);
+    case 'COMMITMENT':
+      return parseCommitmentConfig(input);
+    case 'TRACKS':
+      return parseTracksConfig(input);
+    case 'PROGRAM_DAYS':
+      return parseProgramDaysConfig(input);
+    case 'TICKETS':
+      return parseTicketsConfig(input);
+    case 'SESSION_LIBRARY':
+      return parseSessionLibraryConfig(input);
+  }
+}
+
+function nestedObject(containerDepth: number): Record<string, unknown> {
+  let value: unknown = 'leaf';
+  for (let index = 0; index < containerDepth; index += 1) {
+    value = { child: value };
+  }
+  return value as Record<string, unknown>;
+}
+
+function utf8Bytes(value: unknown): number {
+  return new TextEncoder().encode(JSON.stringify(value)).byteLength;
+}
+
+function sizedPaddingConfig(targetBytes: number, multibyte = false) {
+  const empty = { padding: '' };
+  const available = targetBytes - utf8Bytes(empty);
+  if (!multibyte) return { padding: 'x'.repeat(available) };
+  return {
+    padding: `${'é'.repeat(Math.floor(available / 2))}${
+      available % 2 === 0 ? '' : 'x'
+    }`,
+  };
+}
+
+function resolveLocalImport(fromFile: string, specifier: string): string | null {
+  let base: string;
+  if (specifier.startsWith('@/')) {
+    base = join(process.cwd(), 'src', specifier.slice(2));
+  } else if (specifier.startsWith('.')) {
+    base = resolve(dirname(fromFile), specifier);
+  } else {
+    return null;
+  }
+
+  const candidates = extname(base)
+    ? [base]
+    : [`${base}.ts`, `${base}.tsx`, join(base, 'index.ts'), join(base, 'index.tsx')];
+  return candidates.find(existsSync) ?? null;
+}
+
+function runtimeImportClosure(entry: string): readonly string[] {
+  const pending = [entry];
+  const visited = new Set<string>();
+  while (pending.length > 0) {
+    const path = pending.pop();
+    if (!path || visited.has(path)) continue;
+    visited.add(path);
+    const source = readFileSync(path, 'utf8');
+    const parsed = ts.createSourceFile(
+      path,
+      source,
+      ts.ScriptTarget.Latest,
+      true,
+      path.endsWith('.tsx') ? ts.ScriptKind.TSX : ts.ScriptKind.TS,
+    );
+
+    const visit = (node: ts.Node) => {
+      if (ts.isImportDeclaration(node)) {
+        const clause = node.importClause;
+        const bindings = clause?.namedBindings;
+        const namedImportsAreTypeOnly =
+          bindings &&
+          ts.isNamedImports(bindings) &&
+          bindings.elements.length > 0 &&
+          bindings.elements.every((element) => element.isTypeOnly);
+        const isTypeOnly =
+          clause?.isTypeOnly === true ||
+          (!clause?.name && namedImportsAreTypeOnly === true);
+        if (!isTypeOnly && ts.isStringLiteral(node.moduleSpecifier)) {
+          const local = resolveLocalImport(path, node.moduleSpecifier.text);
+          if (local) pending.push(local);
+        }
+      }
+      if (
+        ts.isCallExpression(node) &&
+        node.expression.kind === ts.SyntaxKind.ImportKeyword
+      ) {
+        throw new Error(`dynamic import in config registry closure: ${path}`);
+      }
+      ts.forEachChild(node, visit);
+    };
+    visit(parsed);
+  }
+  return [...visited].sort();
+}
