+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+interface ManifestoFigure {
+  imageUrl: string;
+  alt: string;
+}
+
+export interface ManifestoConfig {
+  eyebrow: string;
+  title: string;
+  question: string;
+  body: string[];
+  figure: ManifestoFigure | null;
+}
+
+const DEFAULT_MANIFESTO: Readonly<ManifestoConfig> = {
+  eyebrow: 'The 2027 theme',
+  title: 'Make AI Work for You',
+  question:
+    'Every talk has to answer one question. What do you do differently on Monday?',
+  body: [
+    'It is not a tagline, it is a mission. We help people become the one in the room who knows what to do — and we want everyone to leave able to do something they could not do when they walked in.',
+    'The future of AI is only bright if the people using it understand it. That means teaching users and leaders to make AI work for them, rather than the other way around. We want the AI future to look more like the Jetsons than the Terminator.',
+    'And the question is the acceptance filter, not a slogan: every submission to the call for speakers is judged against it, and a session that only describes what a model can do gets declined — however good the demo is.',
+  ],
+  figure: null,
+};
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function nonEmptyString(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const trimmed = value.trim();
+  return trimmed.length > 0 ? trimmed : null;
+}
+
+function parseBody(value: unknown): string[] | null {
+  if (!Array.isArray(value) || value.length < 1 || value.length > 4) {
+    return null;
+  }
+  const paragraphs = value.map(nonEmptyString);
+  return paragraphs.every((paragraph): paragraph is string => paragraph !== null)
+    ? paragraphs
+    : null;
+}
+
+function parseFigure(value: unknown): ManifestoFigure | null {
+  if (!isRecord(value)) return null;
+  const imageUrl = nonEmptyString(value.imageUrl);
+  const alt = nonEmptyString(value.alt);
+  return imageUrl && alt ? { imageUrl, alt } : null;
+}
+
+function freshManifestoDefaults(): ManifestoConfig {
+  return {
+    eyebrow: DEFAULT_MANIFESTO.eyebrow,
+    title: DEFAULT_MANIFESTO.title,
+    question: DEFAULT_MANIFESTO.question,
+    body: [...DEFAULT_MANIFESTO.body],
+    figure: null,
+  };
+}
+
+export function parseManifestoConfig(config: unknown): ManifestoConfig {
+  try {
+    const input = isRecord(config) ? config : {};
+    const defaults = freshManifestoDefaults();
+    return {
+      eyebrow: nonEmptyString(input.eyebrow) ?? defaults.eyebrow,
+      title: nonEmptyString(input.title) ?? defaults.title,
+      question: nonEmptyString(input.question) ?? defaults.question,
+      body: parseBody(input.body) ?? defaults.body,
+      figure: parseFigure(input.figure),
+    };
+  } catch {
+    return freshManifestoDefaults();
+  }
+}
