@@ -0,0 +1,216 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import {
+  DEFAULT_HTTP_URL_MAX_LENGTH,
+  normalizeOptionalHttpUrl,
+} from '@/lib/url-validation';
+
+export interface PlaceGraphic {
+  src: string;
+  alt: string;
+  caption: string | null;
+}
+
+export interface PlaceFact {
+  value: string;
+  label: string;
+  sourceLabel: string;
+  sourceHref: string;
+}
+
+export interface PlaceOrganization {
+  name: string;
+  sourceLabel: string;
+  sourceHref: string;
+}
+
+export interface PlaceSector {
+  label: string;
+  organizations: PlaceOrganization[];
+}
+
+export interface PlaceConfig {
+  eyebrow: string | null;
+  title: string;
+  intro: string | null;
+  graphic: PlaceGraphic | null;
+  facts: PlaceFact[];
+  sectors: PlaceSector[];
+}
+
+const MAX_FACTS = 8;
+const MAX_SECTORS = 8;
+const MAX_ORGANIZATIONS_PER_SECTOR = 12;
+const INVALID_PROPERTY = Symbol('invalid-place-config-property');
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  try {
+    return value !== null && typeof value === 'object' && !Array.isArray(value);
+  } catch {
+    return false;
+  }
+}
+
+/** Read own data properties without invoking organizer-supplied accessors. */
+function ownValue(value: unknown, key: string): unknown {
+  if (!isRecord(value) && !isArray(value)) return INVALID_PROPERTY;
+  try {
+    const descriptor = Object.getOwnPropertyDescriptor(value, key);
+    return descriptor && Object.hasOwn(descriptor, 'value')
+      ? descriptor.value
+      : INVALID_PROPERTY;
+  } catch {
+    return INVALID_PROPERTY;
+  }
+}
+
+function isArray(value: unknown): value is unknown[] {
+  try {
+    return Array.isArray(value);
+  } catch {
+    return false;
+  }
+}
+
+function boundedArray(value: unknown, maximum: number): unknown[] | null {
+  if (!isArray(value)) return null;
+  const length = ownValue(value, 'length');
+  if (
+    typeof length !== 'number' ||
+    !Number.isSafeInteger(length) ||
+    length < 0 ||
+    length > maximum
+  ) {
+    return null;
+  }
+
+  const items: unknown[] = [];
+  for (let index = 0; index < length; index += 1) {
+    items.push(ownValue(value, String(index)));
+  }
+  return items;
+}
+
+function nonEmptyString(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const trimmed = value.trim();
+  return trimmed.length > 0 ? trimmed : null;
+}
+
+function publicHttpsUrl(value: unknown): string | null {
+  try {
+    return normalizeOptionalHttpUrl(value, {
+      label: 'Source URL',
+      maxLength: DEFAULT_HTTP_URL_MAX_LENGTH,
+      kind: 'image',
+    });
+  } catch {
+    return null;
+  }
+}
+
+function graphicSource(value: unknown): string | null {
+  if (typeof value !== 'string' || value.length > DEFAULT_HTTP_URL_MAX_LENGTH) {
+    return null;
+  }
+  const trimmed = value.trim();
+  if (!trimmed || /[\s\u0000-\u001f\u007f-\u009f\\]/u.test(trimmed)) {
+    return null;
+  }
+  if (trimmed.startsWith('/')) {
+    return trimmed.startsWith('//') ? null : trimmed;
+  }
+  return publicHttpsUrl(trimmed);
+}
+
+function parseGraphic(value: unknown): PlaceGraphic | null {
+  if (!isRecord(value)) return null;
+  const src = graphicSource(ownValue(value, 'src'));
+  const alt = nonEmptyString(ownValue(value, 'alt'));
+  if (!src || !alt) return null;
+  return {
+    src,
+    alt,
+    caption: nonEmptyString(ownValue(value, 'caption')),
+  };
+}
+
+function parseFact(value: unknown): PlaceFact | null {
+  if (!isRecord(value)) return null;
+  const factValue = nonEmptyString(ownValue(value, 'value'));
+  const label = nonEmptyString(ownValue(value, 'label'));
+  const sourceLabel = nonEmptyString(ownValue(value, 'sourceLabel'));
+  const sourceHref = publicHttpsUrl(ownValue(value, 'sourceHref'));
+  if (!factValue || !label || !sourceLabel || !sourceHref) return null;
+  return { value: factValue, label, sourceLabel, sourceHref };
+}
+
+function parseFacts(value: unknown): PlaceFact[] {
+  const items = boundedArray(value, MAX_FACTS);
+  if (!items) return [];
+  return items
+    .map(parseFact)
+    .filter((fact): fact is PlaceFact => fact !== null);
+}
+
+function parseOrganization(value: unknown): PlaceOrganization | null {
+  if (!isRecord(value)) return null;
+  const name = nonEmptyString(ownValue(value, 'name'));
+  const sourceLabel = nonEmptyString(ownValue(value, 'sourceLabel'));
+  const sourceHref = publicHttpsUrl(ownValue(value, 'sourceHref'));
+  if (!name || !sourceLabel || !sourceHref) return null;
+  return { name, sourceLabel, sourceHref };
+}
+
+function parseSector(value: unknown): PlaceSector | null {
+  if (!isRecord(value)) return null;
+  const label = nonEmptyString(ownValue(value, 'label'));
+  const organizationItems = boundedArray(
+    ownValue(value, 'organizations'),
+    MAX_ORGANIZATIONS_PER_SECTOR,
+  );
+  if (!label || !organizationItems) return null;
+  const organizations = organizationItems
+    .map(parseOrganization)
+    .filter(
+      (organization): organization is PlaceOrganization =>
+        organization !== null,
+    );
+  return organizations.length > 0 ? { label, organizations } : null;
+}
+
+function parseSectors(value: unknown): PlaceSector[] {
+  const items = boundedArray(value, MAX_SECTORS);
+  if (!items) return [];
+  return items
+    .map(parseSector)
+    .filter((sector): sector is PlaceSector => sector !== null);
+}
+
+export function parsePlaceConfig(config: unknown): PlaceConfig | null {
+  try {
+    if (!isRecord(config)) return null;
+    const title = nonEmptyString(ownValue(config, 'title'));
+    if (!title) return null;
+
+    const graphic = parseGraphic(ownValue(config, 'graphic'));
+    const facts = parseFacts(ownValue(config, 'facts'));
+    const sectors = parseSectors(ownValue(config, 'sectors'));
+    if (!graphic && facts.length === 0 && sectors.length === 0) return null;
+
+    return {
+      eyebrow: nonEmptyString(ownValue(config, 'eyebrow')),
+      title,
+      intro: nonEmptyString(ownValue(config, 'intro')),
+      graphic,
+      facts,
+      sectors,
+    };
+  } catch {
+    return null;
+  }
+}
