+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+export interface TracksConfig {
+  eyebrow: string;
+  title: string;
+  intro: string | null;
+  outroEyebrow: string | null;
+  outroTitle: string | null;
+  outroBody: string | null;
+}
+
+const DEFAULT_TRACKS_CONFIG = {
+  eyebrow: 'Conference day · Tuesday 20 April',
+  title: 'Ten tracks, so you never have to sit through the wrong one.',
+  intro:
+    'Twenty-five minute talks on a thirty-minute grid. More speakers, tighter talks, and a track for the job you actually do.',
+  outroEyebrow: 'Whoever you are',
+  outroTitle: 'Ten tracks, so nobody has to sit at the kids’ table.',
+  outroBody:
+    'A CFO, a state legislator, an NC State senior and a veteran retraining for a new career are in the same building on purpose. That only works if each of them can find a room where the level is right — technical depth for the people who want it, plain language for the people who need it, and no one made to feel tested. If you leave without the thing you came for, we got it wrong.',
+} as const satisfies Readonly<TracksConfig>;
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function nonEmptyString(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const trimmed = value.trim();
+  return trimmed.length > 0 ? trimmed : null;
+}
+
+function optionalCopy(value: unknown, fallback: string): string | null {
+  if (value === null) return null;
+  return nonEmptyString(value) ?? fallback;
+}
+
+function freshTracksDefaults(): TracksConfig {
+  return { ...DEFAULT_TRACKS_CONFIG };
+}
+
+export function parseTracksConfig(config: unknown): TracksConfig {
+  try {
+    const input = isRecord(config) ? config : {};
+    const defaults = freshTracksDefaults();
+    return {
+      eyebrow: nonEmptyString(input.eyebrow) ?? defaults.eyebrow,
+      title: nonEmptyString(input.title) ?? defaults.title,
+      intro: optionalCopy(input.intro, DEFAULT_TRACKS_CONFIG.intro),
+      outroEyebrow: optionalCopy(
+        input.outroEyebrow,
+        DEFAULT_TRACKS_CONFIG.outroEyebrow,
+      ),
+      outroTitle: optionalCopy(
+        input.outroTitle,
+        DEFAULT_TRACKS_CONFIG.outroTitle,
+      ),
+      outroBody: optionalCopy(input.outroBody, DEFAULT_TRACKS_CONFIG.outroBody),
+    };
+  } catch {
+    return freshTracksDefaults();
+  }
+}
