+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+export interface TicketsConfig {
+  publishFloorPrice: boolean;
+  publishOnSaleDate: boolean;
+}
+
+const MISSING = Symbol('missing-own-property');
+
+function isRecord(value: unknown): value is Record<PropertyKey, unknown> {
+  try {
+    return value !== null && typeof value === 'object' && !Array.isArray(value);
+  } catch {
+    return false;
+  }
+}
+
+function readOwn(value: object, key: PropertyKey): unknown | typeof MISSING {
+  try {
+    if (!Object.prototype.hasOwnProperty.call(value, key)) return MISSING;
+    return Reflect.get(value, key);
+  } catch {
+    return MISSING;
+  }
+}
+
+function readOwnTrue(value: unknown, key: keyof TicketsConfig): boolean {
+  if (!isRecord(value)) return false;
+  return readOwn(value, key) === true;
+}
+
+/** Empty, false, malformed, and inherited values never opt a tenant in. */
+export function parseTicketsConfig(config: unknown): TicketsConfig | null {
+  const publishFloorPrice = readOwnTrue(config, 'publishFloorPrice');
+  const publishOnSaleDate = readOwnTrue(config, 'publishOnSaleDate');
+  if (!publishFloorPrice && !publishOnSaleDate) return null;
+  return { publishFloorPrice, publishOnSaleDate };
+}
