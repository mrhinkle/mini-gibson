+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+export interface ProgramDaysConfig {
+  eyebrow: string;
+  title: string;
+}
+
+const DEFAULT_CONFIG: Readonly<ProgramDaysConfig> = Object.freeze({
+  eyebrow: 'What the event looks like',
+  title: 'Four days in Raleigh, and a head start in March.',
+});
+
+function ownNonEmptyString(
+  config: unknown,
+  key: keyof ProgramDaysConfig,
+): string | null {
+  if (!config || typeof config !== 'object' || Array.isArray(config)) return null;
+
+  try {
+    if (!Object.prototype.hasOwnProperty.call(config, key)) return null;
+    const value = Reflect.get(config, key);
+    if (typeof value !== 'string') return null;
+    const trimmed = value.trim();
+    return trimmed.length > 0 ? trimmed : null;
+  } catch {
+    return null;
+  }
+}
+
+export function parseProgramDaysConfig(
+  config: Record<string, unknown>,
+): ProgramDaysConfig {
+  return {
+    eyebrow: ownNonEmptyString(config, 'eyebrow') ?? DEFAULT_CONFIG.eyebrow,
+    title: ownNonEmptyString(config, 'title') ?? DEFAULT_CONFIG.title,
+  };
+}
