+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+export const FEATURED_EVENT_TRACK_COUNT = 'FEATURED_EVENT_TRACK_COUNT' as const;
+
+interface AudienceBandLiteralTile {
+  value: string;
+  metric?: never;
+  label: string;
+  source: string;
+}
+
+interface AudienceBandMetricTile {
+  value?: never;
+  metric: typeof FEATURED_EVENT_TRACK_COUNT;
+  label: string;
+  source: string;
+}
+
+export type AudienceBandTile = AudienceBandLiteralTile | AudienceBandMetricTile;
+
+export interface AudienceBandConfig {
+  anchor: string;
+  tiles: AudienceBandTile[];
+}
+
+const MAX_TILES = 12;
+const MISSING = Symbol('missing-own-property');
+
+function isRecord(value: unknown): value is Record<PropertyKey, unknown> {
+  try {
+    return value !== null && typeof value === 'object' && !Array.isArray(value);
+  } catch {
+    return false;
+  }
+}
+
+function readOwn(value: object, key: PropertyKey): unknown | typeof MISSING {
+  try {
+    if (!Object.prototype.hasOwnProperty.call(value, key)) return MISSING;
+    return Reflect.get(value, key);
+  } catch {
+    return MISSING;
+  }
+}
+
+function hasOwn(value: object, key: PropertyKey): boolean | null {
+  try {
+    return Object.prototype.hasOwnProperty.call(value, key);
+  } catch {
+    return null;
+  }
+}
+
+function readOwnNonEmptyString(value: object, key: PropertyKey): string | null {
+  const candidate = readOwn(value, key);
+  if (typeof candidate !== 'string') return null;
+  const trimmed = candidate.trim();
+  return trimmed.length > 0 ? trimmed : null;
+}
+
+function parseTile(value: unknown): AudienceBandTile | null {
+  if (!isRecord(value)) return null;
+
+  const hasValue = hasOwn(value, 'value');
+  const hasMetric = hasOwn(value, 'metric');
+  if (hasValue === null || hasMetric === null || hasValue === hasMetric) {
+    return null;
+  }
+
+  const label = readOwnNonEmptyString(value, 'label');
+  const source = readOwnNonEmptyString(value, 'source');
+  if (!label || !source) return null;
+
+  if (hasValue) {
+    const rawValue = readOwn(value, 'value');
+    if (typeof rawValue !== 'string') return null;
+    const tileValue = rawValue.trim();
+    if (!tileValue) return null;
+    return { value: tileValue, label, source };
+  }
+
+  const rawMetric = readOwn(value, 'metric');
+  if (rawMetric !== FEATURED_EVENT_TRACK_COUNT) return null;
+  return { metric: FEATURED_EVENT_TRACK_COUNT, label, source };
+}
+
+function parseTiles(value: unknown): AudienceBandTile[] {
+  try {
+    if (!Array.isArray(value)) return [];
+    const length = readOwn(value, 'length');
+    if (
+      typeof length !== 'number' ||
+      !Number.isSafeInteger(length) ||
+      length < 0
+    ) {
+      return [];
+    }
+
+    const tiles: AudienceBandTile[] = [];
+    for (let index = 0; index < length && tiles.length < MAX_TILES; index += 1) {
+      const candidate = readOwn(value, index);
+      if (candidate === MISSING) continue;
+      const tile = parseTile(candidate);
+      if (tile) tiles.push(tile);
+    }
+    return tiles;
+  } catch {
+    return [];
+  }
+}
+
+export function parseAudienceBandConfig(
+  config: unknown,
+): AudienceBandConfig | null {
+  if (!isRecord(config)) return null;
+
+  const anchor = readOwnNonEmptyString(config, 'anchor');
+  const tilesValue = readOwn(config, 'tiles');
+  if (!anchor || tilesValue === MISSING) return null;
+
+  const tiles = parseTiles(tilesValue);
+  return tiles.length > 0 ? { anchor, tiles } : null;
+}
