index 000000000..00459f499
--- /dev/null
+++ b/src/components/homepage/commitment-config.ts
@@ -0,0 +1,231 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+export interface CommitmentColumn {
+  eyebrow: string;
+  title: string;
+  body: string;
+}
+
+export interface CommitmentStat {
+  value: string;
+  label: string;
+  source: string | null;
+}
+
+export interface CommitmentCta {
+  label: string;
+  href: string;
+}
+
+export interface CommitmentConfig {
+  eyebrow: string;
+  title: string;
+  intro: string;
+  columns: CommitmentColumn[];
+  stats: CommitmentStat[];
+  cta: CommitmentCta | null;
+}
+
+const DEFAULT_COMMITMENT = Object.freeze({
+  eyebrow: 'Our commitment',
+  title: 'A region doesn’t get good at AI one company at a time.',
+  intro:
+    'So we build the room for all three at once — government, education and business, hearing the same talks on the same day.',
+  columns: Object.freeze([
+    Object.freeze({
+      eyebrow: 'Government',
+      title: 'The people writing the rules',
+      body:
+        'Economic development, state and municipal teams. If policy is going to keep up with the technology, the people setting it need to hear the same sessions as the people shipping it — not a summary six months later.',
+    }),
+    Object.freeze({
+      eyebrow: 'Education',
+      title: 'Faculty on stage, students in the seats',
+      body:
+        'NC State, Duke, and the community colleges that quietly do most of the region’s retraining. Scholarship seats go to students and career-changers, and faculty belong on the program rather than in the audience.',
+    }),
+    Object.freeze({
+      eyebrow: 'Business',
+      title: 'Two-person shops and the Fortune 50',
+      body:
+        'In the same hallway, on purpose. The startup learns what enterprise procurement actually needs, and the enterprise finds out what is possible this quarter instead of next year.',
+    }),
+  ]),
+  stats: Object.freeze([]),
+  cta: null,
+});
+
+const MAX_COLUMNS = 6;
+const MAX_STATS = 6;
+const MAX_CTA_HREF_LENGTH = 2_048;
+const MISSING = Symbol('missing-commitment-property');
+const INVISIBLE_OR_CONTROL =
+  /[\u0000-\u001f\u007f-\u009f\u200b-\u200f\u202a-\u202e\u2060-\u206f\ufeff]/u;
+const NUMERIC_CLAIM = /\p{Number}/u;
+
+function isArray(value: unknown): value is unknown[] {
+  try {
+    return Array.isArray(value);
+  } catch {
+    return false;
+  }
+}
+
+function isPlainRecord(value: unknown): value is Record<PropertyKey, unknown> {
+  try {
+    if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+      return false;
+    }
+    const prototype = Object.getPrototypeOf(value);
+    return prototype === null || prototype === Object.prototype;
+  } catch {
+    return false;
+  }
+}
+
+/** Read only own data properties; organizer-supplied accessors never run. */
+function ownValue(value: unknown, key: PropertyKey): unknown | typeof MISSING {
+  if (!isPlainRecord(value) && !isArray(value)) return MISSING;
+  try {
+    const descriptor = Object.getOwnPropertyDescriptor(value, key);
+    return descriptor && Object.hasOwn(descriptor, 'value')
+      ? descriptor.value
+      : MISSING;
+  } catch {
+    return MISSING;
+  }
+}
+
+function nonEmptyString(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const trimmed = value.trim();
+  return trimmed.length > 0 ? trimmed : null;
+}
+
+function safeVisibleSource(value: unknown): string | null {
+  const source = nonEmptyString(value);
+  if (!source || INVISIBLE_OR_CONTROL.test(source)) return null;
+  return source;
+}
+
+function boundedItems(value: unknown, maximum: number): unknown[] | null {
+  if (!isArray(value)) return null;
+  const length = ownValue(value, 'length');
+  if (
+    typeof length !== 'number' ||
+    !Number.isSafeInteger(length) ||
+    length < 0 ||
+    length > maximum
+  ) {
+    return null;
+  }
+
+  const items: unknown[] = [];
+  for (let index = 0; index < length; index += 1) {
+    items.push(ownValue(value, String(index)));
+  }
+  return items;
+}
+
+function parseColumn(value: unknown): CommitmentColumn | null {
+  if (!isPlainRecord(value)) return null;
+  const eyebrow = nonEmptyString(ownValue(value, 'eyebrow'));
+  const title = nonEmptyString(ownValue(value, 'title'));
+  const body = nonEmptyString(ownValue(value, 'body'));
+  return eyebrow && title && body ? { eyebrow, title, body } : null;
+}
+
+function parseColumns(value: unknown): CommitmentColumn[] | null {
+  const items = boundedItems(value, MAX_COLUMNS);
+  if (!items) return null;
+  const columns = items
+    .map(parseColumn)
+    .filter((column): column is CommitmentColumn => column !== null);
+  return columns.length > 0 ? columns : null;
+}
+
+function parseStat(value: unknown): CommitmentStat | null {
+  if (!isPlainRecord(value)) return null;
+  const statValue = nonEmptyString(ownValue(value, 'value'));
+  const label = nonEmptyString(ownValue(value, 'label'));
+  const source = safeVisibleSource(ownValue(value, 'source'));
+  if (
+    !statValue ||
+    !label ||
+    ((NUMERIC_CLAIM.test(statValue) || NUMERIC_CLAIM.test(label)) && !source)
+  ) {
+    return null;
+  }
+  return { value: statValue, label, source };
+}
+
+function parseStats(value: unknown): CommitmentStat[] {
+  const items = boundedItems(value, MAX_STATS);
+  if (!items) return [];
+  return items
+    .map(parseStat)
+    .filter((stat): stat is CommitmentStat => stat !== null);
+}
+
+function safeSameSitePath(value: unknown): string | null {
+  if (typeof value !== 'string' || value.length > MAX_CTA_HREF_LENGTH) {
+    return null;
+  }
+  const href = value.trim();
+  if (
+    !href ||
+    !href.startsWith('/') ||
+    href.startsWith('//') ||
+    /[\s\u0000-\u001f\u007f-\u009f\u200b-\u200f\u202a-\u202e\u2060-\u206f\ufeff\\]/u.test(
+      href,
+    )
+  ) {
+    return null;
+  }
+
+  try {
+    const base = new URL('https://conferenceos.invalid');
+    return new URL(href, base).origin === base.origin ? href : null;
+  } catch {
+    return null;
+  }
+}
+
+function parseCta(value: unknown): CommitmentCta | null {
+  if (!isPlainRecord(value)) return null;
+  const label = nonEmptyString(ownValue(value, 'label'));
+  const href = safeSameSitePath(ownValue(value, 'href'));
+  return label && href ? { label, href } : null;
+}
+
+function freshDefaults(): CommitmentConfig {
+  return {
+    eyebrow: DEFAULT_COMMITMENT.eyebrow,
+    title: DEFAULT_COMMITMENT.title,
+    intro: DEFAULT_COMMITMENT.intro,
+    columns: DEFAULT_COMMITMENT.columns.map((column) => ({ ...column })),
+    stats: [],
+    cta: null,
+  };
+}
+
+export function parseCommitmentConfig(config: unknown): CommitmentConfig {
+  try {
+    if (!isPlainRecord(config)) return freshDefaults();
+    const defaults = freshDefaults();
+    return {
+      eyebrow: nonEmptyString(ownValue(config, 'eyebrow')) ?? defaults.eyebrow,
+      title: nonEmptyString(ownValue(config, 'title')) ?? defaults.title,
+      intro: nonEmptyString(ownValue(config, 'intro')) ?? defaults.intro,
+      columns: parseColumns(ownValue(config, 'columns')) ?? defaults.columns,
+      stats: parseStats(ownValue(config, 'stats')),
+      cta: parseCta(ownValue(config, 'cta')),
+    };
+  } catch {
+    return freshDefaults();
+  }
+}
