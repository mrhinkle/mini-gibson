+ * via any medium, is strictly prohibited.
+ */
+
+import { types as nodeTypes } from 'node:util';
+
+import { parseAudienceBandConfig } from '@/components/homepage/audience-band-config';
+import { parseCommitmentConfig } from '@/components/homepage/commitment-config';
+import { parseManifestoConfig } from '@/components/homepage/manifesto-config';
+import { parsePlaceConfig } from '@/components/homepage/place-config';
+import { parseProgramDaysConfig } from '@/components/homepage/program-days-config';
+import { parseSessionLibraryConfig } from '@/components/homepage/session-library-parser';
+import { parseTicketsConfig } from '@/components/homepage/tickets-config';
+import { parseTracksConfig } from '@/components/homepage/tracks-config';
+import { parseHeroPhotoSlides } from '@/lib/homepage-hero-slides';
+import { parseSpeakersConfig } from '@/lib/homepage-speakers';
+import type { HomepageSectionType } from '@/lib/homepage-sections';
+
+export const MAX_HOMEPAGE_CONFIG_BYTES = 32_768;
+export const MAX_HOMEPAGE_CONFIG_DEPTH = 8;
+export const MAX_HOMEPAGE_CONFIG_NODES = 4_096;
+
+const INVALID_JSON = Symbol('invalid-homepage-config-json');
+const DANGEROUS_KEYS = new Set(['__proto__', 'constructor', 'prototype']);
+
+type ConfigObject = Record<string, unknown>;
+type RendererConfigParser = (config: ConfigObject) => object | null;
+
+export interface HomepageConfigSchema {
+  /** Human-readable JSON shape shown by future editor/seed consumers. */
+  readonly acceptedShape: string;
+  /** The renderer's exact parser, never a parallel loose schema. */
+  readonly parser: RendererConfigParser;
+}
+
+export type NormalizedHomepageSectionConfig = Readonly<ConfigObject>;
+
+function schema(
+  acceptedShape: string,
+  parser: RendererConfigParser,
+): HomepageConfigSchema {
+  return Object.freeze({ acceptedShape, parser });
+}
+
+const CONFIG_SCHEMAS = {
+  HERO: schema(
+    '{ slides?: Array<{ imageUrl: string; alt: string }> (max 8) }',
+    (config) => ({ slides: parseHeroPhotoSlides(config) }),
+  ),
+  AUDIENCE_BAND: schema(
+    '{ anchor: string; tiles: Array<{ value: string; label: string; source: string } | { metric: "FEATURED_EVENT_TRACK_COUNT"; label: string; source: string }> (max 12 usable) }',
+    parseAudienceBandConfig,
+  ),
+  SPEAKERS: schema(
+    '{ style?: "grid" | "flip" (unknown or malformed defaults to "grid") }',
+    parseSpeakersConfig,
+  ),
+  MANIFESTO: schema(
+    '{ eyebrow?: string; title?: string; question?: string; body?: string[1..4]; figure?: { imageUrl: string; alt: string } }',
+    parseManifestoConfig,
+  ),
+  PLACE: schema(
+    '{ eyebrow?: string; title: string; intro?: string; graphic?: { src: safe-url-or-site-path; alt: string; caption?: string }; facts?: Array<{ value: string; label: string; sourceLabel: string; sourceHref: public-https-url }> (max 8); sectors?: Array<{ label: string; organizations: Array<{ name: string; sourceLabel: string; sourceHref: public-https-url }> (max 12) }> (max 8) }',
+    parsePlaceConfig,
+  ),
+  COMMITMENT: schema(
+    '{ eyebrow?: string; title?: string; intro?: string; columns?: Array<{ eyebrow: string; title: string; body: string }> (1..6); stats?: Array<{ value: string; label: string; source?: visible string (required for numeric claims) }> (0..6); cta?: { label: string; href: safe-same-site-relative-path } }',
+    parseCommitmentConfig,
+  ),
+  TRACKS: schema(
+    '{ eyebrow?: string; title?: string; intro?: string|null; outroEyebrow?: string|null; outroTitle?: string|null; outroBody?: string|null }',
+    parseTracksConfig,
+  ),
+  PROGRAM_DAYS: schema(
+    '{ eyebrow?: string; title?: string }',
+    parseProgramDaysConfig,
+  ),
+  TICKETS: schema(
+    '{ publishFloorPrice?: true; publishOnSaleDate?: true } (at least one exact own true)',
+    parseTicketsConfig,
+  ),
+  SESSION_LIBRARY: schema(
+    '{ eventSlug: /^[a-z0-9_-]{1,200}$/ (trimmed and lowercased); limit: integer 1..100 }',
+    parseSessionLibraryConfig,
+  ),
+} as const satisfies Partial<Record<HomepageSectionType, HomepageConfigSchema>>;
+
+export type ConfigEditableHomepageSectionType = keyof typeof CONFIG_SCHEMAS;
+
+export const HOMEPAGE_CONFIG_SCHEMAS: Readonly<typeof CONFIG_SCHEMAS> =
+  Object.freeze(CONFIG_SCHEMAS);
+
+export const REGISTERED_HOMEPAGE_CONFIG_TYPES = Object.freeze(
+  Object.keys(CONFIG_SCHEMAS) as ConfigEditableHomepageSectionType[],
+);
+
+function isProxy(value: object): boolean {
+  try {
+    return nodeTypes.isProxy(value);
+  } catch {
+    return true;
+  }
+}
+
+function isPlainJsonObject(value: object): boolean {
+  if (isProxy(value)) return false;
+  try {
+    const prototype = Object.getPrototypeOf(value);
+    return prototype === null || prototype === Object.prototype;
+  } catch {
+    return false;
+  }
+}
+
+function cloneJsonValue(
+  value: unknown,
+  depth: number,
+  stack: WeakSet<object>,
+  budget: { nodes: number },
+): unknown | typeof INVALID_JSON {
+  budget.nodes += 1;
+  if (budget.nodes > MAX_HOMEPAGE_CONFIG_NODES) return INVALID_JSON;
+
+  if (
+    value === null ||
+    typeof value === 'string' ||
+    typeof value === 'boolean'
+  ) {
+    return value;
+  }
+  if (typeof value === 'number') {
+    return Number.isFinite(value) ? value : INVALID_JSON;
+  }
+  if (typeof value !== 'object') return INVALID_JSON;
+  if (
+    depth > MAX_HOMEPAGE_CONFIG_DEPTH ||
+    isProxy(value) ||
+    stack.has(value)
+  ) {
+    return INVALID_JSON;
+  }
+
+  stack.add(value);
+  try {
+    if (Array.isArray(value)) {
+      if (Object.getPrototypeOf(value) !== Array.prototype) return INVALID_JSON;
+      const lengthDescriptor = Object.getOwnPropertyDescriptor(value, 'length');
+      const length = lengthDescriptor?.value;
+      if (
+        typeof length !== 'number' ||
+        !Number.isSafeInteger(length) ||
+        length < 0 ||
+        length + budget.nodes > MAX_HOMEPAGE_CONFIG_NODES
+      ) {
+        return INVALID_JSON;
+      }
+
+      const ownKeys = Reflect.ownKeys(value);
+      if (
+        ownKeys.length !== length + 1 ||
+        ownKeys.some((key) => typeof key !== 'string')
+      ) {
+        return INVALID_JSON;
+      }
+
+      const result: unknown[] = [];
+      for (let index = 0; index < length; index += 1) {
+        const descriptor = Object.getOwnPropertyDescriptor(
+          value,
+          String(index),
+        );
+        if (!descriptor?.enumerable || !Object.hasOwn(descriptor, 'value')) {
+          return INVALID_JSON;
+        }
+        const cloned = cloneJsonValue(
+          descriptor.value,
+          depth + 1,
+          stack,
+          budget,
+        );
+        if (cloned === INVALID_JSON) return INVALID_JSON;
+        result.push(cloned);
+      }
+      return result;
+    }
+
+    if (!isPlainJsonObject(value)) return INVALID_JSON;
+    const result = Object.create(null) as ConfigObject;
+    for (const key of Reflect.ownKeys(value)) {
+      if (typeof key !== 'string' || DANGEROUS_KEYS.has(key)) {
+        return INVALID_JSON;
+      }
+      const descriptor = Object.getOwnPropertyDescriptor(value, key);
+      if (!descriptor?.enumerable || !Object.hasOwn(descriptor, 'value')) {
+        return INVALID_JSON;
+      }
+      const cloned = cloneJsonValue(descriptor.value, depth + 1, stack, budget);
+      if (cloned === INVALID_JSON) return INVALID_JSON;
+      result[key] = cloned;
+    }
+    return result;
+  } catch {
+    return INVALID_JSON;
+  } finally {
+    stack.delete(value);
+  }
+}
+
+function safeJsonObject(value: unknown): ConfigObject | null {
+  const cloned = cloneJsonValue(value, 0, new WeakSet(), { nodes: 0 });
+  if (
+    cloned === INVALID_JSON ||
+    cloned === null ||
+    typeof cloned !== 'object' ||
+    Array.isArray(cloned)
+  ) {
+    return null;
+  }
+
+  try {
+    const serialized = JSON.stringify(cloned);
+    if (
+      new TextEncoder().encode(serialized).byteLength >
+      MAX_HOMEPAGE_CONFIG_BYTES
+    ) {
+      return null;
+    }
+  } catch {
+    return null;
+  }
+  return cloned as ConfigObject;
+}
+
+function shallowFrozenNullPrototype(
+  parsed: object,
+): NormalizedHomepageSectionConfig | null {
+  // Re-run the hostile/JSON boundary over parser output so future parsers
+  // cannot expand this registry's trust surface by returning unsafe values.
+  const safe = safeJsonObject(parsed);
+  if (!safe) return null;
+  const normalized = Object.create(null) as ConfigObject;
+  for (const [key, value] of Object.entries(safe)) normalized[key] = value;
+  return Object.freeze(normalized);
+}
+
+export function getHomepageSectionConfigSchema(
+  type: unknown,
+): HomepageConfigSchema | null {
+  if (typeof type !== 'string' || !Object.hasOwn(CONFIG_SCHEMAS, type)) {
+    return null;
+  }
+  return CONFIG_SCHEMAS[type as ConfigEditableHomepageSectionType];
+}
+
+/**
+ * Validate and normalize renderer config for future organizer and seed inputs.
+ * Known display-only types deliberately return null until their renderer owns
+ * a parser and explicitly joins this registry.
+ */
+export function parseHomepageSectionConfig(
+  type: unknown,
+  config: unknown,
+): NormalizedHomepageSectionConfig | null {
+  const definition = getHomepageSectionConfigSchema(type);
+  if (!definition) return null;
+
+  const safeInput = safeJsonObject(config);
+  if (!safeInput) return null;
+
+  try {
+    const parsed = definition.parser(safeInput);
+    return parsed ? shallowFrozenNullPrototype(parsed) : null;
+  } catch {
+    return null;
+  }
+}
