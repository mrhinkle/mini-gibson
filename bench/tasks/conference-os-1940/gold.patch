@@ -0,0 +1,72 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+const MAX_EVENT_SLUG_LENGTH = 200;
+const SAFE_EVENT_SLUG = /^[a-z0-9_-]+$/u;
+
+export const MAX_SESSION_LIBRARY_LIMIT = 100;
+
+export interface SessionLibraryConfig {
+  eventSlug: string;
+  limit: number;
+}
+
+const MISSING = Symbol('missing-own-data-property');
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function nonEmptyBoundedString(value: unknown, maxLength: number): string | null {
+  if (typeof value !== 'string') return null;
+  const trimmed = value.trim();
+  return trimmed.length > 0 && trimmed.length <= maxLength ? trimmed : null;
+}
+
+function readOwnDataProperty(
+  value: object,
+  key: PropertyKey,
+): unknown | typeof MISSING {
+  try {
+    const descriptor = Reflect.getOwnPropertyDescriptor(value, key);
+    if (!descriptor || !Object.prototype.hasOwnProperty.call(descriptor, 'value')) {
+      return MISSING;
+    }
+    return descriptor.value;
+  } catch {
+    return MISSING;
+  }
+}
+
+function normalizeEventSlug(value: unknown): string | null {
+  const slug = nonEmptyBoundedString(value, MAX_EVENT_SLUG_LENGTH)?.toLowerCase();
+  return slug && SAFE_EVENT_SLUG.test(slug) ? slug : null;
+}
+
+/** Read the intentionally small portable config without inventing defaults. */
+export function parseSessionLibraryConfig(
+  config: unknown,
+): SessionLibraryConfig | null {
+  try {
+    if (!isRecord(config)) return null;
+    const eventSlug = normalizeEventSlug(
+      readOwnDataProperty(config, 'eventSlug'),
+    );
+    const limit = readOwnDataProperty(config, 'limit');
+    if (
+      !eventSlug ||
+      typeof limit !== 'number' ||
+      !Number.isInteger(limit) ||
+      limit < 1 ||
+      limit > MAX_SESSION_LIBRARY_LIMIT
+    ) {
+      return null;
+    }
+    return Object.freeze({ eventSlug, limit });
+  } catch {
+    return null;
+  }
+}
