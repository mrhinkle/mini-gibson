+    assert.deepEqual(
+      {
+        authorityHost: optIn?.authorityHost,
+        driverHost: optIn?.driverHost,
+        hostaddr: optIn?.hostaddr,
+        neonEndpoints: optIn?.neonEndpoints,
+      },
+      {
+        authorityHost: guard.authorityHost,
+        driverHost: guard.driverHost,
+        hostaddr: guard.hostaddr,
+        neonEndpoints: guard.neonEndpoints,
+      },
+      databaseUrl,
+    );
+  }
+  assert.equal(connectionTargetsForExampleOptIn("not a postgres url"), null);
+  assert.equal(connectionTargetsForExampleOptIn(""), null);
+  assert.equal(connectionTargetsForExampleOptIn(undefined), null);
+});
+
+test("production-migrate never sets the example-map opt-in, and CI sets it only on build-e2e", () => {
+  const root = new URL("..", import.meta.url);
+  const migrate = loadYaml(
+    readFileSync(new URL(".github/workflows/production-migrate.yml", root), "utf8"),
+  );
+  assert.equal(parsedTreeHasName(migrate, OPT_IN_ENV), false);
+
+  const ci = loadYaml(readFileSync(new URL(".github/workflows/ci.yml", root), "utf8"));
+  assert.equal(ci.env?.[OPT_IN_ENV], undefined);
+  assert.equal(ci.jobs["build-e2e"].env[OPT_IN_ENV], "1");
+  for (const [jobId, job] of Object.entries(ci.jobs)) {
+    if (jobId === "build-e2e") continue;
+    assert.equal(parsedTreeHasName(job, OPT_IN_ENV), false, jobId);
+  }
+  // Required check names are the job id when name is unset, else job.name.
+  assert.equal(ci.jobs.quality.name, undefined);
+  assert.equal(ci.jobs["build-e2e-required"].name, "build-e2e-required");
+});
