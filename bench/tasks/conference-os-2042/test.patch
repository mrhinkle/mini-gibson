+/** @vitest-environment jsdom
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+import { act, createElement } from 'react';
+import { createRoot } from 'react-dom/client';
+import { expect, it, vi } from 'vitest';
+
+const { searchForm } = vi.hoisted(() => ({
+  searchForm: vi.fn((_props: Record<string, unknown>) => createElement('input')),
+}));
+vi.mock('@/components/search-form', () => ({ SearchForm: searchForm }));
+vi.mock('next/navigation', () => ({}));
+import { SearchToggle } from '@/components/search-toggle';
+
+it('owns the keyboard shortcut instead of binding the inner form', () => {
+  const container = document.createElement('div');
+  const root = createRoot(container);
+  act(() => root.render(createElement(SearchToggle, { action: '/search' })));
+  act(() => container.querySelector('button')?.click());
+  // React 19 calls function components with (props, undefined); assert the props only.
+  expect(searchForm).toHaveBeenCalled();
+  expect(searchForm.mock.calls.at(-1)?.[0]).toMatchObject({ enableShortcut: false });
+  act(() => root.unmount());
+});
diff --git a/tests/unit/search-toggle.test.ts b/tests/unit/search-toggle.test.ts
new file mode 100644
index 000000000..2aa209d00
--- /dev/null
+++ b/tests/unit/search-toggle.test.ts
@@ -0,0 +1,95 @@
+/** @vitest-environment jsdom
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const push = vi.fn();
+vi.mock('next/navigation', () => ({ useRouter: () => ({ push }) }));
+import { SearchToggle } from '@/components/search-toggle';
+
+describe('SearchToggle', () => {
+  let root: Root;
+  let container: HTMLDivElement;
+  beforeEach(() => {
+    push.mockReset();
+    container = document.createElement('div');
+    document.body.appendChild(container);
+    root = createRoot(container);
+    (globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+  });
+  afterEach(() => {
+    act(() => root.unmount());
+    container.remove();
+  });
+  const render = async () => act(async () => root.render(createElement(SearchToggle, { action: '/search', placeholder: 'Search' })));
+
+  it('starts closed and opens with focus', async () => {
+    await render();
+    const button = container.querySelector<HTMLButtonElement>('button');
+    expect(container.querySelector('input')).toBeNull();
+    await act(async () => button?.click());
+    expect(button?.getAttribute('aria-expanded')).toBe('true');
+    expect(document.activeElement?.tagName).toBe('INPUT');
+  });
+  it.each([['Meta', 'metaKey'], ['Control', 'ctrlKey']])('%s-K opens and focuses', async (_name, key) => {
+    await render();
+    await act(async () => window.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', [key]: true })));
+    expect(document.activeElement?.tagName).toBe('INPUT');
+  });
+  it('ignores the shortcut while the toggle is hidden below its breakpoint', async () => {
+    container.style.display = 'none';
+    await render();
+    const event = new KeyboardEvent('keydown', { key: 'k', metaKey: true, cancelable: true });
+    await act(async () => window.dispatchEvent(event));
+    expect(container.querySelector('input')).toBeNull();
+    expect(event.defaultPrevented).toBe(false);
+    container.style.display = '';
+    await act(async () => window.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', metaKey: true })));
+    expect(document.activeElement?.tagName).toBe('INPUT');
+  });
+  it('points aria-controls at the panel only while it exists', async () => {
+    await render();
+    const button = container.querySelector<HTMLButtonElement>('button')!;
+    expect(button.hasAttribute('aria-controls')).toBe(false);
+    await act(async () => button.click());
+    const id = button.getAttribute('aria-controls');
+    expect(id).toBeTruthy();
+    expect(document.getElementById(id!)).not.toBeNull();
+  });
+  it('Meta-K while open pulls focus back to the search field', async () => {
+    await render();
+    const button = container.querySelector<HTMLButtonElement>('button')!;
+    await act(async () => button.click());
+    await act(async () => button.focus());
+    expect(document.activeElement).toBe(button);
+    await act(async () => window.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', metaKey: true })));
+    expect(document.activeElement?.tagName).toBe('INPUT');
+  });
+  it('Escape closes and restores focus; outside click closes', async () => {
+    await render();
+    const button = container.querySelector<HTMLButtonElement>('button');
+    await act(async () => button?.click());
+    await act(async () => window.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape' })));
+    await act(async () => undefined);
+    expect(document.activeElement).toBe(button);
+    await act(async () => button?.click());
+    await act(async () => document.body.dispatchEvent(new PointerEvent('pointerdown', { bubbles: true })));
+    expect(container.querySelector('input')).toBeNull();
+  });
+  it('submits through the existing search navigation', async () => {
+    await render();
+    act(() => container.querySelector<HTMLButtonElement>('button')?.click());
+    const input = container.querySelector<HTMLInputElement>('input')!;
+    act(() => {
+      const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')!.set!;
+      setter.call(input, 'agents');
+      input.dispatchEvent(new Event('change', { bubbles: true }));
+      input.form?.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
+    });
+    expect(push).toHaveBeenCalledWith('/search?q=agents');
+  });
+});
