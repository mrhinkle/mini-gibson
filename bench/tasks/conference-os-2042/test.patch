diff --git a/tests/unit/get-involved-page.test.ts b/tests/unit/get-involved-page.test.ts
new file mode 100644
index 000000000..5b1e13e2c
--- /dev/null
+++ b/tests/unit/get-involved-page.test.ts
@@ -0,0 +1,111 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+import { renderToStaticMarkup } from 'react-dom/server';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const event = { name: 'AI Space Jam', slug: 'ai-space-jam', status: 'SCHEDULED' };
+const prisma = vi.hoisted(() => ({ event: { findUnique: vi.fn() } }));
+const brand = vi.hoisted(() => ({
+  getPublicBrand: vi.fn(),
+}));
+vi.mock('@/lib/db', () => ({ prisma }));
+vi.mock('@/lib/public-brand', () => brand);
+vi.mock('next/navigation', () => ({ notFound: () => { throw new Error('NOT_FOUND'); } }));
+
+import GetInvolvedPage, { generateMetadata } from '@/app/(public)/events/[eventSlug]/get-involved/page';
+
+const renderPage = async () =>
+  renderToStaticMarkup(await GetInvolvedPage({ params: Promise.resolve({ eventSlug: event.slug }) }));
+
+describe('Get Involved page', () => {
+  beforeEach(() => {
+    prisma.event.findUnique.mockReset();
+    brand.getPublicBrand.mockReset();
+  });
+
+  it('derives cards from the shared brand participation options', async () => {
+    prisma.event.findUnique.mockResolvedValue(event);
+    brand.getPublicBrand.mockResolvedValue({ cfpOpen: true, showRegisterCta: true, externalTicketUrl: null });
+    const html = await renderPage();
+    // The header's SSR brand call hides Register for viewers who already hold a ticket; match it.
+    expect(brand.getPublicBrand).toHaveBeenCalledWith(event.slug, expect.objectContaining({ respectViewerRegistration: true }));
+    expect(html).toContain('Submit a Talk');
+    expect(html).toContain('href="/events/ai-space-jam/register"');
+    expect(html).toContain('Apply for a Scholarship');
+    expect(html).toContain('Volunteer');
+    expect(html).toContain('href="/events/ai-space-jam/sponsors/prospectus"');
+  });
+
+  it('omits CFP and register when their shared options are closed', async () => {
+    prisma.event.findUnique.mockResolvedValue(event);
+    brand.getPublicBrand.mockResolvedValue({ cfpOpen: false, showRegisterCta: false, externalTicketUrl: null });
+    const html = await renderPage();
+    expect(html).not.toContain('Submit a Talk');
+    expect(html).not.toContain('/register');
+    expect(html).not.toContain('Get tickets');
+    expect(html).toContain('Volunteer');
+  });
+
+  it('opens an external ticket page in a new tab', async () => {
+    prisma.event.findUnique.mockResolvedValue(event);
+    brand.getPublicBrand.mockResolvedValue({
+      cfpOpen: false,
+      showRegisterCta: true,
+      externalTicketUrl: 'https://tickets.example/ai-space-jam',
+    });
+    const html = await renderPage();
+    const anchor = [...html.matchAll(/<a\b[^>]*>[^<]*<\/a>/g)].map((m) => m[0]).find((a) => a.includes('Get tickets'));
+    expect(anchor, html).toBeDefined();
+    expect(anchor).toContain('href="https://tickets.example/ai-space-jam"');
+    expect(anchor).toContain('target="_blank"');
+    expect(anchor).toContain('rel="noopener noreferrer"');
+  });
+
+  it('gives every card an action that does not repeat its heading', async () => {
+    prisma.event.findUnique.mockResolvedValue(event);
+    brand.getPublicBrand.mockResolvedValue({ cfpOpen: true, showRegisterCta: true, externalTicketUrl: null });
+    const html = await renderPage();
+    const headings = [...html.matchAll(/<h2[^>]*>([^<]+)<\/h2>/g)].map((m) => m[1]);
+    const actions = [...html.matchAll(/<article[\s\S]*?<a[^>]*>([^<]+)<\/a>/g)].map((m) => m[1]);
+    expect(actions).toEqual([
+      'Send a talk proposal',
+      'Get tickets',
+      'Start an application',
+      'Sign up to volunteer',
+      'See the sponsorship prospectus',
+    ]);
+    const lower = headings.map((heading) => heading.toLowerCase());
+    for (const action of actions) expect(lower).not.toContain(action.toLowerCase());
+  });
+
+  it('does not render a second main landmark', async () => {
+    prisma.event.findUnique.mockResolvedValue(event);
+    brand.getPublicBrand.mockResolvedValue({ cfpOpen: false, showRegisterCta: false, externalTicketUrl: null });
+    expect(await renderPage()).not.toContain('<main');
+  });
+
+  it('returns notFound for an unknown event', async () => {
+    prisma.event.findUnique.mockResolvedValue(null);
+    brand.getPublicBrand.mockResolvedValue(null);
+    await expect(GetInvolvedPage({ params: Promise.resolve({ eventSlug: 'nope' }) })).rejects.toThrow('NOT_FOUND');
+  });
+
+  it('shows the cancelled notice instead of options for a cancelled event', async () => {
+    prisma.event.findUnique.mockResolvedValue({ ...event, status: 'CANCELLED' });
+    brand.getPublicBrand.mockResolvedValue({ cfpOpen: true, showRegisterCta: true, externalTicketUrl: null });
+    const html = await renderPage();
+    expect(html).toContain('AI Space Jam has been cancelled.');
+    expect(html).not.toContain('Submit a Talk');
+  });
+
+  it('returns event metadata', async () => {
+    prisma.event.findUnique.mockResolvedValue({ name: event.name });
+    await expect(generateMetadata({ params: Promise.resolve({ eventSlug: event.slug }) })).resolves.toMatchObject({
+      title: expect.stringContaining('Get Involved'),
+      description: expect.stringContaining(event.name),
+    });
+  });
+});
