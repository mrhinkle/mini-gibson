+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import Link from 'next/link';
+import { notFound } from 'next/navigation';
+import { prisma } from '@/lib/db';
+import { eventPageTitle } from '@/lib/page-title';
+import { publicEventParticipateLinks, type NavLink } from '@/lib/public-event-nav';
+import { getPublicBrand } from '@/lib/public-brand';
+
+interface Props {
+  params: Promise<{ eventSlug: string }>;
+}
+
+const DESCRIPTIONS: Record<string, string> = {
+  cfp: 'Share your practical experience with an audience of operators and builders.',
+  register: 'Join us for the full event experience and connect with the community.',
+  scholarships: 'Apply for support that helps make the event accessible to you.',
+  volunteers: 'Help make the event welcoming, useful, and memorable for everyone.',
+  'sponsors/prospectus': 'Explore ways to support the event and reach its community.',
+};
+
+// Card actions say what happens, so no link repeats its card heading.
+const ACTIONS: Record<string, string> = {
+  cfp: 'Send a talk proposal',
+  register: 'Get tickets',
+  scholarships: 'Start an application',
+  volunteers: 'Sign up to volunteer',
+  'sponsors/prospectus': 'See the sponsorship prospectus',
+};
+
+function kindFor(link: NavLink): string | undefined {
+  if (link.external) return 'register';
+  const match = link.href.match(/\/events\/[^/]+\/(.+)$/);
+  return match?.[1];
+}
+
+function descriptionFor(link: NavLink): string | undefined {
+  const kind = kindFor(link);
+  return kind ? DESCRIPTIONS[kind] : undefined;
+}
+
+function actionFor(link: NavLink): string {
+  const kind = kindFor(link);
+  return (kind && ACTIONS[kind]) || `Go to ${link.label}`;
+}
+
+export async function generateMetadata({ params }: Props) {
+  const { eventSlug } = await params;
+  const event = await prisma.event.findUnique({ where: { slug: eventSlug }, select: { name: true } });
+  return {
+    title: event ? eventPageTitle('Get Involved', event.name) : 'Get Involved',
+    description: event ? `Find your way to contribute to ${event.name}.` : 'Find your way to contribute.',
+  };
+}
+
+export default async function GetInvolvedPage({ params }: Props) {
+  const { eventSlug } = await params;
+  const [event, brand] = await Promise.all([
+    prisma.event.findUnique({
+      where: { slug: eventSlug },
+      select: { name: true, slug: true, status: true },
+    }),
+    // Same registration rule as the SSR header CTA (src/app/(public)/layout.tsx):
+    // a signed-in attendee who already holds a ticket sees no Register card.
+    getPublicBrand(eventSlug, { respectViewerRegistration: true }),
+  ]);
+
+  if (!event || !brand) notFound();
+
+  if (event.status === 'CANCELLED') {
+    return (
+      <div className="mx-auto max-w-xl px-4 py-16 text-center">
+        <h1 className="text-3xl font-semibold text-gray-900">Get involved</h1>
+        <p className="mt-4 text-gray-600">{event.name} has been cancelled.</p>
+        <Link href={`/events/${event.slug}`} className="mt-8 inline-block font-medium text-nebula-600 hover:underline">
+          Back to event
+        </Link>
+      </div>
+    );
+  }
+
+  const links = publicEventParticipateLinks(event.slug, {
+    cfpOpen: brand.cfpOpen,
+    showRegister: brand.showRegisterCta,
+    externalTicketUrl: brand.externalTicketUrl,
+  });
+
+  return (
+    // A div, not <main>: events/[eventSlug]/layout.tsx already owns the main landmark.
+    <div className="min-h-screen bg-gradient-to-b from-slate-50 via-white to-nebula-50/40">
+      <div className="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
+        <nav className="mb-8 text-sm text-gray-500">
+          <Link href={`/events/${event.slug}`} className="hover:text-nebula-600 hover:underline">← {event.name}</Link>
+        </nav>
+        <header className="mb-10">
+          <p className="font-mono text-xs uppercase tracking-wider text-nebula-600">{event.name}</p>
+          <h1 className="mt-2 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">Get involved</h1>
+          <p className="mt-3 max-w-2xl text-base leading-relaxed text-gray-600">
+            Choose the path that fits you and help make {event.name} stronger.
+          </p>
+        </header>
+        <div className="grid gap-5 sm:grid-cols-2">
+          {links.map((link) => {
+            const description = descriptionFor(link);
+            return (
+              <article key={link.href} className="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
+                <h2 className="text-xl font-semibold text-gray-900">{link.label}</h2>
+                {description ? <p className="mt-2 text-sm leading-relaxed text-gray-600">{description}</p> : null}
+                <Link
+                  href={link.href}
+                  target={link.external ? '_blank' : undefined}
+                  rel={link.external ? 'noopener noreferrer' : undefined}
+                  className="mt-5 inline-flex min-h-11 items-center rounded-md bg-nebula-600 px-4 text-sm font-semibold text-white hover:bg-nebula-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nebula-600 focus-visible:ring-offset-2"
+                >
+                  {actionFor(link)}
+                </Link>
+              </article>
+            );
+          })}
+        </div>
+      </div>
+    </div>
+  );
+}
