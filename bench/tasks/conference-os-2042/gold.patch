new file mode 100644
index 000000000..49dd1dd74
--- /dev/null
+++ b/src/components/search-toggle.tsx
@@ -0,0 +1,109 @@
+'use client';
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import { Search } from 'lucide-react';
+import { useEffect, useId, useRef, useState } from 'react';
+import { SearchForm, type SearchFormVariant } from '@/components/search-form';
+
+/** False when the element or any ancestor is display: none (e.g. `hidden sm:inline-flex` on a phone). */
+function isRendered(element: HTMLElement | null): boolean {
+  for (let node: HTMLElement | null = element; node; node = node.parentElement) {
+    if (window.getComputedStyle(node).display === 'none') return false;
+  }
+  return element !== null;
+}
+
+interface SearchToggleProps {
+  action: string;
+  placeholder?: string;
+  variant?: SearchFormVariant;
+  headerTone?: 'light' | 'dark';
+  className?: string;
+}
+
+export function SearchToggle({
+  action,
+  placeholder = 'Search…',
+  variant = 'public',
+  headerTone = 'dark',
+  className = '',
+}: SearchToggleProps) {
+  const [open, setOpen] = useState(false);
+  const buttonRef = useRef<HTMLButtonElement>(null);
+  const inputRef = useRef<HTMLInputElement>(null);
+  const wasOpenRef = useRef(false);
+  const panelId = `search-panel-${useId()}`;
+
+  useEffect(() => {
+    if (open) inputRef.current?.focus();
+    else if (wasOpenRef.current) buttonRef.current?.focus();
+    wasOpenRef.current = open;
+  }, [open]);
+
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
+        // Hidden below its breakpoint (display: none): leave the shortcut alone
+        // so it never opens a panel nobody can see.
+        if (!isRendered(buttonRef.current)) return;
+        event.preventDefault();
+        // Already open: the effect below won't rerun, so pull focus back to the field.
+        if (open) inputRef.current?.focus();
+        else setOpen(true);
+      }
+      if (event.key === 'Escape' && open) {
+        event.preventDefault();
+        setOpen(false);
+        buttonRef.current?.focus();
+      }
+    };
+    const onPointerDown = (event: PointerEvent) => {
+      if (!(event.target instanceof Node) || buttonRef.current?.parentElement?.contains(event.target)) return;
+      setOpen(false);
+    };
+    window.addEventListener('keydown', onKeyDown);
+    document.addEventListener('pointerdown', onPointerDown);
+    return () => {
+      window.removeEventListener('keydown', onKeyDown);
+      document.removeEventListener('pointerdown', onPointerDown);
+    };
+  }, [open]);
+
+  const light = headerTone === 'light';
+  return (
+    <div className={`relative ${className}`}>
+      <button
+        ref={buttonRef}
+        type="button"
+        className={`inline-flex min-h-11 min-w-11 items-center justify-center rounded-full transition-colors focus-visible:outline-none focus-visible:ring-2 ${
+          light
+            ? 'text-stone-700 hover:bg-stone-900/5 hover:text-stone-950 focus-visible:ring-nebula-600'
+            : 'text-gray-300 hover:bg-white/10 hover:text-white focus-visible:ring-blue-400'
+        }`}
+        aria-label="Search"
+        aria-expanded={open}
+        aria-controls={open ? panelId : undefined}
+        title="Search (⌘K)"
+        onClick={() => setOpen((value) => !value)}
+      >
+        <Search className="size-5" aria-hidden="true" />
+      </button>
+      {open ? (
+        <div id={panelId} className="absolute right-0 top-full z-50 mt-2 w-72 rounded-xl border border-gray-200 bg-white p-3 shadow-lg">
+          <SearchForm
+            action={action}
+            placeholder={placeholder}
+            variant={variant}
+            enableShortcut={false}
+            inputRef={inputRef}
+            autoFocus
+          />
+        </div>
+      ) : null}
+    </div>
+  );
+}
