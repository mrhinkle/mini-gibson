+type WindowedEvent = {
+  startDate?: Date | string | null;
+  endDate?: Date | string | null;
+};
+
+/**
+ * Event.startDate and Event.endDate are required in the schema. A caller that
+ * did not select them (or a unit fixture that omits them) skips the window so
+ * a partial event cannot hide every session.
+ */
+function sessionInEventWindow(
+  session: { startTime: Date; endTime: Date },
+  event: WindowedEvent,
+): boolean {
+  if (event.startDate == null || event.endDate == null) return true;
+  return isSessionWithinEventWindow(
+    session.startTime,
+    session.endTime,
+    event.startDate,
+    event.endDate,
+  );
+}
+
+function personOnSession(
+  session: PublicSpeakerSessionSource,
+  strictKey: string,
+): PublicSpeakerPerson | undefined {
+  return peopleOnSession(session).find(
+    (person) => strictSpeakerNameKey(person.name) === strictKey,
+  );
+}
+
 /**
- * Resolve a public speaker profile by Session.id or by slugified speaker name
- * (e.g. "dr-nebula-vex"). Returns all published sessions for that speaker
- * within the event, newest-first by start time.
+ * #2001 for a resolved person. By session id, only that session's own link
+ * counts (the first SessionSpeaker row when the session has rows, otherwise
+ * Session.speakerClerkUserId). By name, soleLinkedAccount across the person's
+ * sessions: two different accounts show the snapshot only.
+ */
+async function resolvePersonDisplay(
+  sessions: readonly (PublicSpeakerSessionSource & { id: string })[],
+  strictKey: string,
+  ownSessionId?: string,
+): Promise<SpeakerDisplay> {
+  const appearances = sessions.flatMap((session) => {
+    const person = personOnSession(session, strictKey);
+    return person ? [{ ...person, sessionId: session.id }] : [];
+  });
+  const own = ownSessionId
+    ? appearances.find((person) => person.sessionId === ownSessionId)
+    : undefined;
+  const linkedId = ownSessionId
+    ? (own?.clerkUserId ?? null)
+    : soleLinkedAccount(appearances.map((person) => person.clerkUserId));
+  // By session id the requested session is always the snapshot source; a
+  // missing linked account on that row must not fall through to an earlier
+  // appearance's fields (Codex review, #2258 round 1).
+  const primary = own ?? appearances[0];
+  const snapshot = speakerSnapshot({
+    photo: primary?.photo ?? null,
+    company: primary?.company ?? null,
+    jobTitle: primary?.jobTitle ?? null,
+    bio: primary?.bio ?? null,
+    linkedinUrl: primary?.linkedinUrl ?? null,
+    xHandle: primary?.xHandle ?? null,
+  });
+  if (!linkedId || !primary) return snapshot;
+  const profiles = await loadLinkedSpeakerProfiles([linkedId]);
+  return resolveSpeakerDisplay(snapshot, linkedSpeakerProfile(profiles, linkedId));
+}
