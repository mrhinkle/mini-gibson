diff --git a/src/lib/public-speaker-people.ts b/src/lib/public-speaker-people.ts
new file mode 100644
index 000000000..7b98ab2d3
--- /dev/null
+++ b/src/lib/public-speaker-people.ts
@@ -0,0 +1,169 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle
+ * SPDX-License-Identifier: AGPL-3.0-or-later
+ */
+
+import { strictSpeakerNameKey } from "@/lib/speaker-display";
+
+/**
+ * People shown on the public speaker page and the per-event directory (#2258).
+ *
+ * A session with one or more named SessionSpeaker rows yields one person per
+ * distinct strictSpeakerNameKey, in displayOrder (ascending). Ties keep the
+ * order the rows were given. The flat Session.speakerName is a person only
+ * when the session has zero named rows — importers store the joined
+ * "A & B" string there, and that joined string is not its own person.
+ *
+ * Someone who is both a row and the flat name on the same session is one
+ * person (the row). The same strict key on two sessions is one person.
+ *
+ * Profile snapshots are row fields, then the session's flat speaker* fields
+ * when the row field is null. Callers pass that snapshot to speakerSnapshot /
+ * resolveSpeakerDisplay; this module does not apply linked-account precedence.
+ * Directory cards keep the pre-#2258 flat sources (photo, CFP title and
+ * organization) when the session has no rows.
+ */
+
+export type PublicSessionSpeakerRow = {
+  name: string;
+  title?: string | null;
+  company?: string | null;
+  imageUrl?: string | null;
+  linkedinUrl?: string | null;
+  bio?: string | null;
+  displayOrder?: number | null;
+  clerkUserId?: string | null;
+};
+
+export type PublicSpeakerSessionSource = {
+  speakerName?: string | null;
+  speakerTitle?: string | null;
+  speakerCompany?: string | null;
+  speakerBio?: string | null;
+  speakerPhoto?: string | null;
+  speakerXHandle?: string | null;
+  speakerLinkedin?: string | null;
+  speakerClerkUserId?: string | null;
+  speakers?: readonly PublicSessionSpeakerRow[] | null;
+  cfpSubmission?: {
+    organization?: string | null;
+    jobTitle?: string | null;
+  } | null;
+};
+
+export type PublicSpeakerPerson = {
+  name: string;
+  photo: string | null;
+  company: string | null;
+  jobTitle: string | null;
+  bio: string | null;
+  linkedinUrl: string | null;
+  xHandle: string | null;
+  /** Row clerkUserId, or the session's speakerClerkUserId when there are no rows. */
+  clerkUserId: string | null;
+};
+
+export type DirectorySpeakerIdentity = {
+  name: string;
+  photo: string | null;
+  jobTitle: string | null;
+  organization: string | null;
+  clerkUserId: string | null;
+};
+
+function text(value: string | null | undefined): string | null {
+  const trimmed = value?.trim();
+  return trimmed ? trimmed : null;
+}
+
+export function sessionHasSpeakerRows(
+  session: { speakers?: readonly { name?: string | null }[] | null },
+): boolean {
+  return (session.speakers ?? []).some((row) => text(row.name));
+}
+
+/** Named rows, earliest displayOrder first. Equal orders keep input order. */
+export function orderedSpeakerRows(
+  rows: readonly PublicSessionSpeakerRow[] | null | undefined,
+): PublicSessionSpeakerRow[] {
+  return [...(rows ?? [])]
+    .filter((row) => text(row.name))
+    .sort((a, b) => (a.displayOrder ?? 0) - (b.displayOrder ?? 0));
+}
+
+/**
+ * People on one session. The first entry is who a Session.id resolves to
+ * when the session has rows: the first named row by displayOrder.
+ */
+export function peopleOnSession(
+  session: PublicSpeakerSessionSource,
+): PublicSpeakerPerson[] {
+  const rows = orderedSpeakerRows(session.speakers);
+  if (rows.length === 0) {
+    const name = text(session.speakerName);
+    if (!name) return [];
+    return [
+      {
+        name,
+        photo: text(session.speakerPhoto),
+        company: text(session.speakerCompany),
+        jobTitle: text(session.speakerTitle),
+        bio: text(session.speakerBio),
+        linkedinUrl: text(session.speakerLinkedin),
+        xHandle: text(session.speakerXHandle),
+        clerkUserId: session.speakerClerkUserId ?? null,
+      },
+    ];
+  }
+
+  const seen = new Set<string>();
+  const people: PublicSpeakerPerson[] = [];
+  for (const row of rows) {
+    const name = text(row.name)!;
+    const key = strictSpeakerNameKey(name);
+    if (!key || seen.has(key)) continue;
+    seen.add(key);
+    people.push({
+      name,
+      photo: text(row.imageUrl) ?? text(session.speakerPhoto),
+      company: text(row.company) ?? text(session.speakerCompany),
+      jobTitle: text(row.title) ?? text(session.speakerTitle),
+      bio: text(row.bio) ?? text(session.speakerBio),
+      linkedinUrl: text(row.linkedinUrl) ?? text(session.speakerLinkedin),
+      // SessionSpeaker has no x handle; the flat field is the only source.
+      xHandle: text(session.speakerXHandle),
+      clerkUserId: row.clerkUserId ?? null,
+    });
+  }
+  return people;
+}
+
+/**
+ * Directory card identities. Flat sessions keep CFP title/org and the session
+ * photo. Row sessions prefer the row, then flat speaker* fields, then CFP.
+ */
+export function directorySpeakerIdentities(
+  session: PublicSpeakerSessionSource,
+): DirectorySpeakerIdentity[] {
+  if (!sessionHasSpeakerRows(session)) {
+    const name = text(session.speakerName);
+    if (!name) return [];
+    return [
+      {
+        name,
+        photo: session.speakerPhoto ?? null,
+        jobTitle: session.cfpSubmission?.jobTitle ?? null,
+        organization: session.cfpSubmission?.organization ?? null,
+        clerkUserId: session.speakerClerkUserId ?? null,
+      },
+    ];
+  }
+
+  return peopleOnSession(session).map((person) => ({
+    name: person.name,
+    photo: person.photo ?? session.speakerPhoto ?? null,
+    jobTitle: person.jobTitle ?? session.cfpSubmission?.jobTitle ?? null,
+    organization: person.company ?? session.cfpSubmission?.organization ?? null,
+    clerkUserId: person.clerkUserId,
+  }));
+}
