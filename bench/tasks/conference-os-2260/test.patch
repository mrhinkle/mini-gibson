+type Where = {
+  id?: string;
+  isPublished?: boolean;
+  speakerName?: string | { not?: null };
+  sessionType?: { notIn?: string[] };
+  event?: { slug?: string };
+  OR?: Array<{ speakerName?: { not?: null }; speakers?: { some?: object } }>;
+};
+
+function matches(row: SessionFixture, where: Where = {}): boolean {
+  if (where.id && row.id !== where.id) return false;
+  if (where.isPublished === true && !row.isPublished) return false;
+  if (where.sessionType?.notIn?.includes(row.sessionType)) return false;
+  if (where.event?.slug && row.event.slug !== where.event.slug) return false;
+  if (typeof where.speakerName === 'string' && row.speakerName !== where.speakerName) return false;
+  if (
+    where.speakerName &&
+    typeof where.speakerName === 'object' &&
+    where.speakerName.not === null &&
+    row.speakerName == null
+  ) {
+    return false;
+  }
+  if (where.OR) {
+    const ok = where.OR.some((clause) => {
+      if (clause.speakerName?.not === null) return row.speakerName != null;
+      if (clause.speakers && 'some' in clause.speakers) {
+        return row.speakers.some((speaker) => speaker.name.trim());
+      }
+      return false;
+    });
+    if (!ok) return false;
+  }
+  return true;
+}
