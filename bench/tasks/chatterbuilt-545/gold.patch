+  function recordVar(name: string, decl: ts.VariableDeclaration) {
+    const list = moduleLevelVars.get(name) ?? [];
+    list.push(decl);
+    moduleLevelVars.set(name, list);
+  }
+
+  for (const stmt of sf.statements) {
+    if (ts.isImportDeclaration(stmt)) {
+      const clause = stmt.importClause;
+      if (!clause || clause.isTypeOnly) continue;
+      if (clause.name) nonConstBindings.add(clause.name.text);
+      const bindings = clause.namedBindings;
+      if (bindings && ts.isNamespaceImport(bindings)) {
+        nonConstBindings.add(bindings.name.text);
+      } else if (bindings && ts.isNamedImports(bindings)) {
+        for (const el of bindings.elements) {
+          if (el.isTypeOnly) continue;
+          nonConstBindings.add(el.name.text);
+        }
+      }
+      continue;
+    }
