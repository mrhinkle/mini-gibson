+
+/**
+ * A successful Production record older than this is not proof of the
+ * CURRENT live-site project. A repo can move hosting and leave old
+ * Vercel records behind. 90 days covers "moved away months ago"
+ * without treating a quiet site that shipped last month as unbound.
+ * A site with no production deploy inside the window is not bound
+ * to history — fail closed.
+ */
+export const PRODUCTION_IDENTITY_MAX_AGE_MS = 90 * 24 * 60 * 60 * 1000;
+
+/** GitHub/Vercel clocks can lead local time by a few minutes. */
+const PRODUCTION_IDENTITY_CLOCK_SKEW_MS = 5 * 60 * 1000;
+
+/**
+ * True when `timestampMs` is a parseable instant inside the production
+ * identity window relative to `nowMs`. Missing, NaN, or too-far-future
+ * values are not current evidence.
+ */
+export function isRecentProductionEvidence(
+  timestampMs: number | null | undefined,
+  nowMs: number = Date.now(),
+): boolean {
+  if (timestampMs == null || !Number.isFinite(timestampMs)) return false;
+  const age = nowMs - timestampMs;
+  if (age < -PRODUCTION_IDENTITY_CLOCK_SKEW_MS) return false;
+  return age <= PRODUCTION_IDENTITY_MAX_AGE_MS;
+}
+
+function parseIsoTimestampMs(value: unknown): number | null {
+  if (typeof value !== "string" || !value.trim()) return null;
+  const t = Date.parse(value);
+  return Number.isFinite(t) ? t : null;
+}
+
+function vercelStatusProvenance(status: GitHubDeploymentStatusJson): boolean {
+  return isVercelHostingDeployment(status);
+}
+
+/**
+ * GitHub deployment-status `state` that is actual live-site evidence.
+ * `failure`, `error`, `pending`, `inactive`, `queued`, `waiting`, and
+ * `in_progress` are not a successful production identity.
+ */
+function isSuccessfulDeploymentStatus(state: unknown): boolean {
+  return String(state ?? "").trim().toLowerCase() === "success";
+}
+
+/**
+ * GitHub returns statuses newest-first. A workflow with
+ * `deployments: write` can append a forged status after Vercel's.
+ * Only a status Vercel itself authored can speak for that deployment.
+ */
+function latestVercelAuthoredStatus(
+  statuses: GitHubDeploymentStatusJson[],
+): GitHubDeploymentStatusJson | undefined {
+  return statuses.find((status) => vercelStatusProvenance(status));
+}
+
+const STATUS_PAGE_SIZE = 100;
+
+const AUXILIARY_DRAFT_TOKEN_RE =
+  /(storybook|chromatic|styleguide|documentation|\bdocs\b)/i;
+
+/**
+ * Only GitHub deployments from the Vercel hosting integration whose
+ * environment name is actually a customer-site draft may be labeled
+ * "Draft site". Production, staging, unnamed successes, and auxiliary
+ * apps (Storybook, docs, Chromatic) are not the customer site.
+ * `transient_environment` alone is not provenance.
+ */
+export function isDraftPreviewEnvironment(dep: {
+  environment?: string;
+  original_environment?: string;
+  production_environment?: boolean;
+  transient_environment?: boolean;
+  creator?: { login?: string } | null;
+  performed_via_github_app?: { slug?: string } | null;
+}): boolean {
+  if (!isVercelHostingDeployment(dep)) return false;
+  if (dep.production_environment === true) return false;
+  const env = draftEnvironmentIdentity(dep);
+  if (!env) return false;
+  // Denylist, not a live-site binder. Broader than exact
+  // LIVE_ENVIRONMENT_NAMES so `pre-production` / `staging-preview`
+  // cannot qualify as the customer draft. Exact-matching here would
+  // let those names fall through to the `preview` substring check.
+  if (/(^|[^a-z])(production|prod|live|staging)([^a-z]|$)/.test(env)) {
+    return false;
+  }
+  if (AUXILIARY_DRAFT_TOKEN_RE.test(env)) return false;
+  if (env.includes("preview")) return true;
+  if (/(^|[^a-z])pr[-_ ]?\d+/.test(env)) return true;
+  return false;
+}
+
+/**
+ * Exact GitHub/Vercel live-environment names after lowercasing.
+ * A substring match treats `pre-production` (and `production-canary`,
+ * `live-preview`, …) as production even when GitHub set
+ * `production_environment: false`.
+ */
+const LIVE_ENVIRONMENT_NAMES = new Set(["production", "prod", "live"]);
+
+/**
+ * Vercel-authored production on this GitHub repo. That is this
+ * repository's live hosting — a Preview from any other Vercel project
+ * is not. It is not proof the customer owns that Vercel project.
+ */
+export function isCustomerSiteProductionDeployment(dep: {
+  environment?: string;
+  original_environment?: string;
+  production_environment?: boolean;
+  creator?: { login?: string } | null;
+  performed_via_github_app?: { slug?: string } | null;
+}): boolean {
+  if (!isVercelHostingDeployment(dep)) return false;
+  const env = draftEnvironmentIdentity(dep);
+  if (AUXILIARY_DRAFT_TOKEN_RE.test(env)) return false;
+  if (dep.production_environment === true) return true;
+  if (!env) return false;
+  return LIVE_ENVIRONMENT_NAMES.has(env);
+}
+
+/**
+ * Hostnames that are a Vercel (or other) Preview of Storybook / Chromatic /
+ * docs, not the customer site. Unparseable URLs are not verified sites.
+ */
+export function isAuxiliaryDraftUrl(url: string): boolean {
+  let hostname: string;
+  try {
+    hostname = new URL(url).hostname.toLowerCase().replace(/\.$/, "");
+  } catch {
+    return true;
+  }
+  const tokens = hostname.split(".").flatMap((label) => label.split("-"));
+  return tokens.some(
+    (token) =>
+      token === "storybook" ||
+      token === "chromatic" ||
+      token === "styleguide" ||
+      token === "documentation" ||
+      token === "docs",
+  );
+}
+
+export const HOSTING_UNAVAILABLE_WARNING =
+  "I couldn't read hosting status, so I have no draft-site link from the platform.";
+
+export const AMBIGUOUS_DRAFT_WARNING =
+  "Hosting returned more than one draft for this version. I won't pick one and call it your site.";
+
+export const TRUNCATED_DRAFT_WARNING =
+  "I couldn't see every draft for this version, so I am not going to pick a link and call it your site.";
+
+export const AUXILIARY_DRAFT_WARNING =
+  "Hosting returned a draft link that was not your site, so I am not showing it.";
+
+export const UNVERIFIED_DRAFT_STATUS_WARNING =
+  "Hosting returned a draft status I cannot verify came from Vercel, so I am not showing it.";
+
+export const UNRECOGNIZED_DRAFT_STATUS_WARNING =
+  "Hosting returned a status I'm not treating as ready, so I'm not showing that link.";
+
+export const UNBOUND_DRAFT_PROJECT_WARNING =
+  "Hosting returned a draft, but I cannot verify it is your site, so I am not showing it.";
+
+export const FOREIGN_DRAFT_PROJECT_WARNING =
+  "Hosting returned a draft that is not your live site, so I am not showing it.";
+
+/**
+ * Owner-facing when the inspect-URL team slug is one of the known
+ * Chatterbuilt values below. This is a name match, not a proof that
+ * the customer owns the hosting — we only catch those known names.
+ */
+export const COMPANY_OWNED_PROJECT_WARNING =
+  "This draft is on a Chatterbuilt hosting account we know by name, not yours, so I am not showing it as your site. I only catch those known names, not whether you own the hosting.";
+
+export const SITE_COPY_UNCHANGED_REASON =
+  "I compared both versions of the site copy and found no change in the wording the site uses.";
+
+export const SITE_COPY_UNNAMED_REASON =
+  "I read both versions of the site copy and did not find a change in hours, services, the homepage headline, or other wording I know how to name. I won't guess which line it is.";
+
+export const UNLABELED_FILES_ONLY_REASON =
+  "I can see files in this draft, but I cannot tell whether they change the live site.";
+
+export const UNLABELED_FILES_ALSO_REASON =
+  "This draft also includes files I cannot tie to the live site.";
+
+export const AMBIGUOUS_LIVE_PROJECT_WARNING =
+  "Hosting has more than one live site on this repository, so I am not going to pick a draft and call it your site.";
+
+export const TRUNCATED_LIVE_PROJECT_WARNING =
+  "I couldn't see every live site for this repository, so I am not going to pick a draft and call it your site.";
+
+export const UNRESOLVED_LIVE_PROJECT_WARNING =
+  "I found a live site on this repository that I cannot identify, so I am not going to pick a draft and call it your site.";
+
+/**
+ * Vercel dashboard team + project as observed on an inspect URL.
+ * Not a `prj_` id — GitHub never sends those — but enough to tell two
+ * Vercel projects on the same repo apart.
+ */
+export type VercelProjectIdentity = {
+  team: string;
+  project: string;
+};
+
+/**
+ * Known Chatterbuilt-operated Vercel team slugs. STOPGAP, not ownership.
+ *
+ * Matching a draft inspect URL to this repo's unique production inspect
+ * URL only proves the two deploys share a team/project slug. It does
+ * not prove the requesting customer owns that Vercel project. A paid
+ * MCP account and a GitHub App repo grant are repository access, not
+ * Vercel ownership (spec §2.1: installation alone is not Vercel linkage).
+ *
+ * apps/mcp cannot close that gap today:
+ * - No customer Vercel Integration token, and no Vercel API client.
+ * - Dashboard's association resolver (PR #529) is the live repo↔project
+ *   authority, but apps/mcp and apps/dashboard are separate apps with
+ *   no workspace and no build-time import path.
+ * - update-bot installation tokens authorize the GitHub repo, not a
+ *   Vercel team. Vercel team-members / integration-configuration owner
+ *   fields require a Vercel bearer we do not have.
+ *
+ * This denylist therefore rejects two known company slugs only. A slug
+ * not in the set is not proven customer-owned. A renamed or new
+ * Chatterbuilt team is not caught. Do not treat a miss as ownership.
+ */
+const COMPANY_VERCEL_TEAM_SLUGS = new Set(["chatterbuilt", "the-aie"]);
+
+/**
+ * True when the inspect-URL team slug is a *known* Chatterbuilt value.
+ * False means "not one of those names", not "the customer owns this".
+ */
+export function isCompanyVercelTeamSlug(team: string): boolean {
+  return COMPANY_VERCEL_TEAM_SLUGS.has(team.trim().toLowerCase());
+}
+
+/**
+ * First path segments that are Vercel product pages, not a team slug.
+ * `docs/foo` must never parse as team `docs`.
+ */
+const VERCEL_RESERVED_TEAM_SLUGS = new Set([
+  "docs",
+  "new",
+  "account",
+  "integrations",
+  "deployments",
+  "login",
+  "signup",
+  "pricing",
+  "blog",
+  "templates",
+  "support",
+  "contact",
+  "about",
+  "dashboard",
+  "oss",
+  "security",
+  "legal",
+  "guides",
+  "help",
+  "cli",
+  "api",
+  "github",
+  "teams",
+  "home",
+  "design",
+  "enterprise",
+  "changelog",
+  "customers",
+  "partners",
+  "download",
+  "status",
+]);
+
+const VERCEL_SLUG_RE = /^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?$/;
+
+/**
+ * Parse team/project from a Vercel inspect URL. Unparseable, reserved,
+ * or auxiliary project slugs are not a customer-site identity.
+ */
+export function vercelProjectIdentityFromInspectUrl(
+  raw: string,
+): VercelProjectIdentity | null {
+  let parsed: URL;
+  try {
+    parsed = new URL(raw.trim());
+  } catch {
+    return null;
+  }
+  if (parsed.protocol !== "https:") return null;
+  const host = parsed.hostname.toLowerCase().replace(/\.$/, "");
+  if (host !== "vercel.com" && host !== "www.vercel.com") return null;
+  const parts = parsed.pathname.split("/").filter(Boolean);
+  if (parts.length < 2) return null;
+
+  let team: string;
+  let project: string;
+  const first = parts[0]?.toLowerCase() ?? "";
+  if (
+    first === "teams" &&
+    parts.length >= 4 &&
+    parts[2]?.toLowerCase() === "projects"
+  ) {
+    team = (parts[1] ?? "").toLowerCase();
+    project = (parts[3] ?? "").toLowerCase();
+  } else {
+    team = first;
+    project = (parts[1] ?? "").toLowerCase();
+    if (VERCEL_RESERVED_TEAM_SLUGS.has(team)) return null;
+  }
+  if (!VERCEL_SLUG_RE.test(team) || !VERCEL_SLUG_RE.test(project)) return null;
+  if (AUXILIARY_DRAFT_TOKEN_RE.test(project)) return null;
+  return { team, project };
+}
+
+export function vercelProjectIdentitiesEqual(
+  a: VercelProjectIdentity,
+  b: VercelProjectIdentity,
+): boolean {
+  return a.team === b.team && a.project === b.project;
+}
+
+function vercelProjectIdentityFromStatus(
+  status: GitHubDeploymentStatusJson,
+): VercelProjectIdentity | null {
+  if (!vercelStatusProvenance(status)) return null;
+  for (const candidate of [status.log_url, status.target_url]) {
+    if (typeof candidate !== "string" || !candidate.trim()) continue;
+    const identity = vercelProjectIdentityFromInspectUrl(candidate);
+    if (identity) return identity;
+  }
+  return null;
+}
+
+function uniqueVercelProjectIdentity(
+  identities: VercelProjectIdentity[],
+):
+  | { status: "unique"; identity: VercelProjectIdentity }
+  | { status: "none" }
+  | { status: "ambiguous" } {
+  const seen = new Map<string, VercelProjectIdentity>();
+  for (const identity of identities) {
+    seen.set(`${identity.team}/${identity.project}`, identity);
+  }
+  if (seen.size === 0) return { status: "none" };
+  if (seen.size !== 1) return { status: "ambiguous" };
+  const identity = [...seen.values()][0];
+  if (!identity) return { status: "none" };
+  return { status: "unique", identity };
+}
+
+export type DraftDeploymentPick<T> =
+  | { status: "picked"; deployment: T }
+  | { status: "none" }
+  | { status: "ambiguous" }
+  | { status: "truncated" };
+
+/**
+ * Filter SHA deployments down to at most one Preview-shaped candidate.
+ * Uniqueness is not a Vercel project binding — a lone Preview can still
+ * belong to a different project than this repository's unique production
+ * project. `getPreviewDeploy` binds the candidate by matching Vercel
+ * inspect URLs against that production identity. That match is not
+ * customer ownership of the Vercel project.
+ */
+export function pickCustomerDraftDeployment<
+  T extends {
+    environment?: string;
+    original_environment?: string;
+    production_environment?: boolean;
+    transient_environment?: boolean;
+    creator?: { login?: string } | null;
+    performed_via_github_app?: { slug?: string } | null;
+  },
+>(
+  deployments: T[],
+  options?: { listMayBeTruncated?: boolean },
+): DraftDeploymentPick<T> {
+  if (options?.listMayBeTruncated) return { status: "truncated" };
+  const candidates = deployments.filter(isDraftPreviewEnvironment);
+  if (candidates.length === 0) return { status: "none" };
+  if (candidates.length !== 1) return { status: "ambiguous" };
+  const deployment = candidates[0];
+  if (!deployment) return { status: "none" };
+  return { status: "picked", deployment };
+}
+
+const REPO_DEPLOY_PAGE_SIZE = 20;
+const REPO_DEPLOY_MAX_PAGES = 5;
+const MAX_PRODUCTION_STATUS_FETCHES = 10;
+
+type GhGet = (path: string) => Promise<{
+  ok: boolean;
+  status: number;
+  json: unknown;
+  text: string;
+}>;
+
+type ProductionProjectResolution =
+  | { status: "bound"; identity: VercelProjectIdentity }
+  | { status: "none" }
+  | { status: "ambiguous" }
+  | { status: "unavailable" }
+  | { status: "truncated" }
+  | { status: "unresolved" };
+
+/**
+ * The unique Vercel production project observed on this GitHub
+ * repository. That is not customer ownership of the project — only
+ * that production deploys on this repo share one inspect-URL identity.
+ * GitHub deployments carry no `projectId`; inspect URLs do
+ * (`vercel.com/{team}/{project}/...`). A truncated or multi-project
+ * production history is not a binding.
+ */
+async function resolveRepoProductionProjectIdentity(
+  ghGet: GhGet,
+  owner: string,
+  repo: string,
+): Promise<ProductionProjectResolution> {
+  const production: GitHubDeploymentJson[] = [];
+  let truncated = false;
+  const repoPath = `/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}/deployments`;
+  for (let page = 1; page <= REPO_DEPLOY_MAX_PAGES; page++) {
+    const res = await ghGet(
+      `${repoPath}?per_page=${REPO_DEPLOY_PAGE_SIZE}&page=${page}`,
+    );
+    if (!res.ok || !Array.isArray(res.json)) {
+      return { status: "unavailable" };
+    }
+    const batch = res.json as GitHubDeploymentJson[];
+    for (const dep of batch) {
+      if (isCustomerSiteProductionDeployment(dep)) {
+        production.push(dep);
+      }
+    }
+    if (batch.length < REPO_DEPLOY_PAGE_SIZE) break;
+    if (page === REPO_DEPLOY_MAX_PAGES) truncated = true;
+  }
+  if (truncated) return { status: "truncated" };
+  if (production.length === 0) return { status: "none" };
+
+  const identities: VercelProjectIdentity[] = [];
+  const seen = new Set<number>();
+  let fetched = 0;
+  let unresolved = false;
+  for (const dep of production) {
+    if (seen.has(dep.id)) continue;
+    seen.add(dep.id);
+    if (!Number.isInteger(dep.id)) {
+      unresolved = true;
+      continue;
+    }
+    if (fetched >= MAX_PRODUCTION_STATUS_FETCHES) {
+      return { status: "truncated" };
+    }
+    fetched += 1;
+    const stRes = await ghGet(
+      `${repoPath}/${dep.id}/statuses?per_page=${STATUS_PAGE_SIZE}`,
+    );
+    if (!stRes.ok || !Array.isArray(stRes.json)) {
+      return { status: "unavailable" };
+    }
+    const statuses = stRes.json as GitHubDeploymentStatusJson[];
+    const latestVercel = latestVercelAuthoredStatus(statuses);
+    if (!latestVercel) {
+      if (statuses.length >= STATUS_PAGE_SIZE) {
+        return { status: "unavailable" };
+      }
+      unresolved = true;
+      continue;
+    }
+    // failure / error / pending / inactive / queued are not live-site
+    // evidence. A failed Production inspect URL must not become this
+    // repository's bound project so a later Preview from that same
+    // project can be called "Draft ready".
+    if (!isSuccessfulDeploymentStatus(latestVercel.state)) {
+      continue;
+    }
+    // Prefer the successful status's time (when it last succeeded),
+    // then the deployment's created_at. A timestamp we cannot read
+    // is not skippable — ignoring it would let a remaining identity
+    // look unique.
+    const evidenceMs = parseIsoTimestampMs(latestVercel.created_at)
+      ?? parseIsoTimestampMs(dep.created_at);
+    if (evidenceMs == null) {
+      unresolved = true;
+      continue;
+    }
+    if (!isRecentProductionEvidence(evidenceMs)) {
+      continue;
+    }
+    const identity = vercelProjectIdentityFromStatus(latestVercel);
+    if (!identity) {
+      unresolved = true;
+      continue;
+    }
+    identities.push(identity);
+  }
+
+  const unique = uniqueVercelProjectIdentity(identities);
+  // Two verified projects beat "also unresolved" — we already know the
+  // live-site identity is not unique.
+  if (unique.status === "ambiguous") return { status: "ambiguous" };
+  // A production deploy whose project we could not read is not evidence
+  // that the remaining identity is this repo's unique live project.
+  if (unresolved) return { status: "unresolved" };
+  if (unique.status === "unique") {
+    return { status: "bound", identity: unique.identity };
+  }
+  return { status: "none" };
+}
+
+function productionResolutionToDeploy(
+  resolution: Exclude<ProductionProjectResolution, { status: "bound" }>,
+): PreviewDeploy {
+  if (resolution.status === "unavailable") {
+    return {
+      url: null,
+      status: "unavailable",
+      warning: HOSTING_UNAVAILABLE_WARNING,
+    };
+  }
+  if (resolution.status === "truncated") {
+    return {
+      url: null,
+      status: "none",
+      warning: TRUNCATED_LIVE_PROJECT_WARNING,
+    };
+  }
+  if (resolution.status === "ambiguous") {
+    return {
+      url: null,
+      status: "none",
+      warning: AMBIGUOUS_LIVE_PROJECT_WARNING,
+    };
+  }
+  if (resolution.status === "unresolved") {
+    return {
+      url: null,
+      status: "none",
+      warning: UNRESOLVED_LIVE_PROJECT_WARNING,
+    };
+  }
+  return {
+    url: null,
+    status: "none",
+    warning: UNBOUND_DRAFT_PROJECT_WARNING,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Default GitHub REST client (read-only; injected in tests)
+// ---------------------------------------------------------------------------
+
+export function createGitHubPreviewDiffClient(
+  fetchImpl: typeof fetch = fetch,
+): PreviewDiffClient {
+  const token =
+    process.env.GITHUB_TOKEN?.trim() || process.env.GH_TOKEN?.trim() || "";
+
+  function headers(): Record<string, string> {
+    const h: Record<string, string> = {
+      Accept: "application/vnd.github+json",
+      "User-Agent": "ChatterbuiltPreviewDiff/1.0",
+      "X-GitHub-Api-Version": "2022-11-28",
+    };
+    if (token) h.Authorization = `Bearer ${token}`;
+    return h;
+  }
+
+  async function ghGet(path: string): Promise<{ ok: boolean; status: number; json: unknown; text: string }> {
+    const res = await fetchImpl(`https://api.github.com${path}`, {
+      method: "GET",
+      headers: headers(),
+    });
+    const text = await res.text().catch(() => "");
+    let json: unknown = null;
+    try {
+      json = text ? JSON.parse(text) : null;
+    } catch {
+      json = null;
+    }
+    return { ok: res.ok, status: res.status, json, text };
+  }
+
+  return {
+    async getPull({ owner, repo, number }) {
+      const repoPath = `/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}`;
+      const prPath = `${repoPath}/pulls/${number}`;
+      const [prRes, repoRes] = await Promise.all([
+        ghGet(prPath),
+        ghGet(repoPath),
+      ]);
+      if (!prRes.ok) {
+        throw new Error(
+          `GitHub API ${prRes.status} for pull #${number}: ${prRes.text.slice(0, 200) || "error"}`,
+        );
+      }
+      const pr = prRes.json as {
+        number: number;
+        title?: string;
+        state?: string;
+        merged?: boolean;
+        merged_at?: string | null;
+        changed_files?: number;
+        head?: { sha?: string; ref?: string };
+        base?: { sha?: string; ref?: string };
+      };
+      // Default branch is a proxy for production, not a Vercel mapping.
+      // A missing or unreadable value stays empty — publish fails closed.
+      let defaultBranch = "";
+      if (repoRes.ok && repoRes.json && typeof repoRes.json === "object") {
+        const name = (repoRes.json as { default_branch?: unknown })
+          .default_branch;
+        if (typeof name === "string") defaultBranch = name.trim();
+      }
+      const files: PreviewFile[] = [];
+      let filesTruncated = false;
+      for (let page = 1; page <= MAX_FILE_PAGES; page++) {
+        const filesRes = await ghGet(
+          `${prPath}/files?per_page=${FILES_PER_PAGE}&page=${page}`,
+        );
+        if (!filesRes.ok) {
+          throw new Error(
+            `GitHub API ${filesRes.status} for pull #${number} files: ${filesRes.text.slice(0, 200) || "error"}`,
+          );
+        }
+        if (!Array.isArray(filesRes.json)) {
+          throw new Error("Unexpected GitHub pull files response.");
+        }
+        const pageFiles = (
+          filesRes.json as Array<{
+            filename: string;
+            status?: string;
+            patch?: string;
+            previous_filename?: string;
+          }>
+        ).map((f) => ({
+          filename: f.filename,
+          status: f.status ?? "modified",
+          patch: typeof f.patch === "string" ? f.patch : undefined,
+          previousFilename: f.previous_filename,
+        }));
+        files.push(...pageFiles);
+        if (pageFiles.length < FILES_PER_PAGE) break;
+        if (page === MAX_FILE_PAGES) filesTruncated = true;
+      }
+
+      const changedFiles =
+        typeof pr.changed_files === "number" ? pr.changed_files : null;
+      if (changedFiles != null && files.length < changedFiles) {
+        filesTruncated = true;
+      }
+
+      const headSha = pr.head?.sha;
+      const baseSha = pr.base?.sha;
+      if (!headSha || !baseSha) {
+        throw new Error(
+          `GitHub pull #${number} is missing head or base SHA — cannot verify a diff.`,
+        );
+      }
+
+      let mergeBaseSha: string | null = null;
+      const compareRes = await ghGet(
+        `/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}/compare/${encodeURIComponent(baseSha)}...${encodeURIComponent(headSha)}`,
+      );
+      if (compareRes.ok && compareRes.json && typeof compareRes.json === "object") {
+        const mergeSha = (
+          compareRes.json as { merge_base_commit?: { sha?: string } }
+        ).merge_base_commit?.sha;
+        if (typeof mergeSha === "string" && mergeSha) {
+          mergeBaseSha = mergeSha;
+        }
+      }
+
+      // PR metadata and /files are separate reads. Re-read the head SHA
+      // after both so a push between them cannot mix version A metadata
+      // with version B files. State and merged come from this same
+      // final read — a merge does not change the head SHA, so SHA-only
+      // confirmation would still treat a just-merged PR as pending.
+      const prAgain = await ghGet(prPath);
+      if (!prAgain.ok) {
+        throw new Error(
+          `GitHub API ${prAgain.status} for pull #${number}: ${prAgain.text.slice(0, 200) || "error"}`,
+        );
+      }
+      const latest = prAgain.json as {
+        state?: string;
+        merged?: boolean;
+        merged_at?: string | null;
+        head?: { sha?: string };
+        base?: { sha?: string; ref?: string };
+      } | null;
+      const headAgain = latest?.head?.sha;
+      const baseAgain = latest?.base?.sha;
+      const baseRefAgain = latest?.base?.ref;
+      // Head staying put is not enough: a stacked lower PR can land
+      // and advance the base while HEAD is unchanged. The merge base
+      // we just computed would then be stale. Base SHA staying put is
+      // also not enough: main and develop can share a tip, so a
+      // retarget would keep every SHA and still change the destination.
+      if (
+        !latest ||
+        !headAgain ||
+        headAgain !== headSha ||
+        !baseAgain ||
+        baseAgain !== baseSha ||
+        !sameGitBranchIdentity(pr.base?.ref, baseRefAgain)
+      ) {
+        throw new Error(
+          "The draft changed while I was reading it, so I am not going to describe a mix of two versions. Ask me to preview again.",
+        );
+      }
+
+      const merged = Boolean(latest.merged) || Boolean(latest.merged_at);
+      // Missing state is not "open". Inventing open is how a closed
+      // suggestion gets presented as a pending draft.
+      const state = typeof latest.state === "string" ? latest.state : "";
+
+      return {
+        number: pr.number,
+        title: typeof pr.title === "string" ? pr.title : "",
+        headSha,
+        baseSha,
+        headRef: pr.head?.ref ?? "",
+        baseRef:
+          typeof latest.base?.ref === "string"
+            ? latest.base.ref
+            : (pr.base?.ref ?? ""),
+        defaultBranch,
+        mergeBaseSha,
+        state,
+        merged,
+        changedFiles,
+        filesTruncated,
+        files,
+      };
+    },
+
+    async getFileAtRef({ owner, repo, path, ref }) {
+      const encodedPath = path
+        .split("/")
+        .filter(Boolean)
+        .map(encodeURIComponent)
+        .join("/");
+      const res = await ghGet(
+        `/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}/contents/${encodedPath}?ref=${encodeURIComponent(ref)}`,
+      );
+      if (!res.ok) return null;
+      const body = res.json as {
+        type?: string;
+        encoding?: string;
+        content?: string;
+        size?: number;
+      };
+      if (body.type !== "file") return null;
+      if (typeof body.size === "number" && body.size > MAX_FILE_BYTES) {
+        return null;
+      }
+      if (body.encoding !== "base64" || typeof body.content !== "string") {
+        return null;
+      }
+      try {
+        return Buffer.from(body.content.replace(/\s/g, ""), "base64").toString(
+          "utf8",
+        );
+      } catch {
+        return null;
+      }
+    },
+
+    async getPreviewDeploy({ owner, repo, sha }) {
+      const unavailable = (): PreviewDeploy => ({
+        url: null,
+        status: "unavailable",
+        warning: HOSTING_UNAVAILABLE_WARNING,
+      });
+      const res = await ghGet(
+        `/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}/deployments?sha=${encodeURIComponent(sha)}&per_page=20`,
+      );
+      if (!res.ok) {
+        return unavailable();
+      }
+      if (!Array.isArray(res.json)) {
+        return unavailable();
+      }
+      if (res.json.length === 0) {
+        return { url: null, status: "none" };
+      }
+
+      const deployments = res.json as GitHubDeploymentJson[];
+      // GitHub returns newest-first. A full page may hide another
+      // preview environment — that would make "the draft" a guess.
+      const pick = pickCustomerDraftDeployment(deployments, {
+        listMayBeTruncated: deployments.length >= 20,
+      });
+      if (pick.status === "truncated") {
+        return { url: null, status: "none", warning: TRUNCATED_DRAFT_WARNING };
+      }
+      if (pick.status === "ambiguous") {
+        return { url: null, status: "none", warning: AMBIGUOUS_DRAFT_WARNING };
+      }
+      if (pick.status !== "picked" || !Number.isInteger(pick.deployment.id)) {
+        return { url: null, status: "none" };
+      }
+      const dep = pick.deployment;
+      const stRes = await ghGet(
+        `/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}/deployments/${dep.id}/statuses?per_page=${STATUS_PAGE_SIZE}`,
+      );
+      if (!stRes.ok || !Array.isArray(stRes.json) || stRes.json.length === 0) {
+        return unavailable();
+      }
+      const statuses = stRes.json as GitHubDeploymentStatusJson[];
+      const latestVercel = latestVercelAuthoredStatus(statuses);
+      if (!latestVercel) {
+        if (statuses.length >= STATUS_PAGE_SIZE) {
+          return unavailable();
+        }
+        return {
+          url: null,
+          status: "none",
+          warning: UNVERIFIED_DRAFT_STATUS_WARNING,
+        };
+      }
+
+      // Bind the Preview to this repo's unique production Vercel
+      // identity. `{ ok: true }` means those identities match and the
+      // team slug is not a known Chatterbuilt value. It is not a
+      // verification that the requesting customer owns the project.
+      const bindToRepoProductionProject = async (): Promise<
+        { ok: true } | { ok: false; deploy: PreviewDeploy }
+      > => {
+        const draftIdentity = vercelProjectIdentityFromStatus(latestVercel);
+        if (!draftIdentity) {
+          return {
+            ok: false,
+            deploy: {
+              url: null,
+              status: "none",
+              warning: UNBOUND_DRAFT_PROJECT_WARNING,
+            },
+          };
+        }
+        if (isCompanyVercelTeamSlug(draftIdentity.team)) {
+          return {
+            ok: false,
+            deploy: {
+              url: null,
+              status: "none",
+              warning: COMPANY_OWNED_PROJECT_WARNING,
+            },
+          };
+        }
+        const production = await resolveRepoProductionProjectIdentity(
+          ghGet,
+          owner,
+          repo,
+        );
+        if (production.status !== "bound") {
+          return { ok: false, deploy: productionResolutionToDeploy(production) };
+        }
+        if (isCompanyVercelTeamSlug(production.identity.team)) {
+          return {
+            ok: false,
+            deploy: {
+              url: null,
+              status: "none",
+              warning: COMPANY_OWNED_PROJECT_WARNING,
+            },
+          };
+        }
+        if (!vercelProjectIdentitiesEqual(draftIdentity, production.identity)) {
+          return {
+            ok: false,
+            deploy: {
+              url: null,
+              status: "none",
+              warning: FOREIGN_DRAFT_PROJECT_WARNING,
+            },
+          };
+        }
+        return { ok: true };
+      };
+
+      const state = (latestVercel.state ?? "").toLowerCase();
+      if (state === "success") {
+        const url =
+          typeof latestVercel.environment_url === "string" &&
+          latestVercel.environment_url.trim()
+            ? latestVercel.environment_url.trim()
+            : null;
+        if (!url) return { url: null, status: "none" };
+        if (isAuxiliaryDraftUrl(url)) {
+          return {
+            url: null,
+            status: "none",
+            warning: AUXILIARY_DRAFT_WARNING,
+          };
+        }
+        const bound = await bindToRepoProductionProject();
+        if (!bound.ok) return bound.deploy;
+        return { url, status: "ready" };
+      }
+      if (state === "pending" || state === "in_progress" || state === "queued") {
+        const bound = await bindToRepoProductionProject();
+        if (!bound.ok) return bound.deploy;
+        return { url: null, status: "building" };
+      }
+      if (state === "failure" || state === "error") {
+        const bound = await bindToRepoProductionProject();
+        if (!bound.ok) return bound.deploy;
+        return { url: null, status: "failed" };
+      }
+      // inactive / waiting / anything else is not verified-absent. A URL
+      // on that status is withheld; saying hosting returned no link is false.
+      return {
+        url: null,
+        status: "none",
+        warning: UNRECOGNIZED_DRAFT_STATUS_WARNING,
+      };
+    },
+  };
+}
