+/**
+ * Module-level exported `site` object literal, using the TypeScript
+ * compiler's real scopes. Function-local, comment, string, and regex
+ * decoys are not declarations. Fail closed on re-exports, `export *`,
+ * imports, and competing bindings.
+ */
+function resolveExportedSiteObject(source: string): ResolvedSiteObject {
+  const sf = parseSiteSourceFile(source);
+  const siteLocals: string[] = [];
+  let unparseable = false;
+  let sawStarExport = false;
+  const moduleLevelVars = new Map<string, ts.VariableDeclaration[]>();
+  const nonConstBindings = new Set<string>();
