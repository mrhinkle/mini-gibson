diff --git a/apps/mcp/lib/site-section-labels.ts b/apps/mcp/lib/site-section-labels.ts
new file mode 100644
index 00000000..5df5e8c2
--- /dev/null
+++ b/apps/mcp/lib/site-section-labels.ts
@@ -0,0 +1,511 @@
+/**
+ * Owner-facing names for site files and content/site.ts fields.
+ *
+ * Single mapping used by rewind_site and preview_change. Labels speak the
+ * business ("your hours", "your services list") — never file paths, hunks,
+ * or line numbers.
+ */
+
+export type NamedFile = {
+  filename: string;
+  /** GitHub rename source. Omitted or empty when the file is not a rename. */
+  previousFilename?: string | null;
+};
+
+const IMAGE_EXTENSIONS = new Set([
+  "png",
+  "jpg",
+  "jpeg",
+  "gif",
+  "webp",
+  "avif",
+  "svg",
+  "ico",
+  "bmp",
+]);
+
+const IMAGE_ROUTE_STEMS = new Set([
+  "icon",
+  "apple-icon",
+  "opengraph-image",
+  "twitter-image",
+  "favicon",
+]);
+
+/**
+ * Source that actually runs. A path-based label for these would mark
+ * them classified for publish even though this tool cannot verify
+ * runtime behaviour — only `content/site.ts` is AST-diffed.
+ */
+const EXECUTABLE_SOURCE_EXTENSIONS = new Set([
+  "ts",
+  "tsx",
+  "js",
+  "jsx",
+  "mjs",
+  "cjs",
+  "mts",
+  "cts",
+  "mdx",
+]);
+
+/**
+ * Active static formats this tool never reads. Next/Vercel serves
+ * them on the customer origin. HTML/HTM can carry inline script, a
+ * credential-collection form, or a hidden route the main preview URL
+ * does not reveal. SVG can embed script. A path-based label would
+ * mark them classified and invite publish for a payload we never
+ * inspected.
+ */
+const UNVERIFIABLE_ACTIVE_STATIC_EXTENSIONS = new Set([
+  "html",
+  "htm",
+  "svg",
+]);
+
+function fileBasename(n: string): string {
+  const parts = n.split("/");
+  return parts[parts.length - 1] ?? n;
+}
+
+/**
+ * GitHub repository paths are already POSIX. A backslash is a literal
+ * filename character, not a directory separator — converting it would
+ * let `content\site.ts` impersonate `content/site.ts`.
+ */
+function normalizeRepoPath(path: string): string {
+  return path.replace(/^\.\//, "");
+}
+
+function fileStemAndExt(filename: string): { stem: string; ext: string } {
+  const i = filename.lastIndexOf(".");
+  if (i <= 0) return { stem: filename.toLowerCase(), ext: "" };
+  return {
+    stem: filename.slice(0, i).toLowerCase(),
+    ext: filename.slice(i + 1).toLowerCase(),
+  };
+}
+
+/**
+ * Site-root (or `src/`) directory. Nested copies under docs/, tests/,
+ * or another package are not the customer site.
+ */
+function customerSiteRest(n: string, dir: string): string | null {
+  if (n === dir) return "";
+  if (n.startsWith(`${dir}/`)) return n.slice(dir.length + 1);
+  const srcDir = `src/${dir}`;
+  if (n === srcDir) return "";
+  if (n.startsWith(`${srcDir}/`)) return n.slice(srcDir.length + 1);
+  return null;
+}
+
+/**
+ * True only for the customer site's `content/site.ts` (or `src/content/site.ts`).
+ * `examples/content/site.ts`, fixtures, and other packages are not that file.
+ */
+export function isCustomerSiteCopyPath(path: string): boolean {
+  const n = normalizeRepoPath(path);
+  return customerSiteRest(n, "content") === "site.ts";
+}
+
+function isImageFilePath(n: string): boolean {
+  const { stem, ext } = fileStemAndExt(fileBasename(n));
+  if (IMAGE_EXTENSIONS.has(ext)) return true;
+  return IMAGE_ROUTE_STEMS.has(stem);
+}
+
+function isExecutableSourcePath(n: string): boolean {
+  const { ext } = fileStemAndExt(fileBasename(n));
+  return EXECUTABLE_SOURCE_EXTENSIONS.has(ext);
+}
+
+function isUnverifiableActiveStaticPath(n: string): boolean {
+  const { ext } = fileStemAndExt(fileBasename(n));
+  return UNVERIFIABLE_ACTIVE_STATIC_EXTENSIONS.has(ext);
+}
+
+/**
+ * Manifest and hosting config whose contents this tool never inspects.
+ * package.json scripts can succeed in preview and fail or run something
+ * else in production; vercel.json can add production-only rewrites,
+ * headers, or cron. A path-based label would mark them classified.
+ */
+function isUnverifiableBuildConfigPath(n: string): boolean {
+  const base = fileBasename(n).toLowerCase();
+  return (
+    base === "package.json" ||
+    base === "package-lock.json" ||
+    base === "vercel.json"
+  );
+}
+
+/**
+ * True only when this file is a static asset or Next metadata image
+ * that the customer site actually serves. A screenshot in docs/ or a
+ * fixture under tests/ is not "a file in your photos and icons".
+ */
+function isCustomerSiteImagePath(n: string): boolean {
+  if (!isImageFilePath(n)) return false;
+  if (customerSiteRest(n, "public") != null) return true;
+  const { stem } = fileStemAndExt(fileBasename(n));
+  if (!IMAGE_ROUTE_STEMS.has(stem)) return false;
+  return (
+    customerSiteRest(n, "app") != null || customerSiteRest(n, "pages") != null
+  );
+}
+
+/**
+ * Owner-facing label when a changed file is in the repo but is not a
+ * surface we can defend as the live customer site. Never interpolated
+ * as "This updates …" — it is uncertainty, not a site effect.
+ */
+export const UNLABELED_FILE_LABEL = "files I cannot tie to the live site";
+
+/**
+ * Map a changed file path to a plain-language site section label.
+ * Returns null when the path is not a customer-site surface we can
+ * defend — callers must not invent a site effect for it.
+ * Never returns a file path.
+ */
+export function plainFileLabel(path: string): string | null {
+  const n = normalizeRepoPath(path);
+
+  const contentRest = customerSiteRest(n, "content");
+  if (contentRest === "site.ts") {
+    return "your site copy";
+  }
+  // Executable source is not a classified surface. A non-null label
+  // here would let a ready draft invite publish for a change this
+  // tool cannot verify (API routes, middleware, pages, helpers).
+  // The only executable file we AST-diff is content/site.ts above.
+  if (isExecutableSourcePath(n)) {
+    return null;
+  }
+  // HTML/HTM/SVG is the same class as executable source: served on
+  // the customer origin, contents never inspected. A label here
+  // would invite publish for a hidden public route this tool never
+  // read.
+  if (isUnverifiableActiveStaticPath(n)) {
+    return null;
+  }
+  // package.json scripts and vercel.json routing/headers/cron are
+  // the same class: unverifiable from the filename. A label here
+  // would invite publish for a change this tool never inspected.
+  if (isUnverifiableBuildConfigPath(n)) {
+    return null;
+  }
+  if (
+    contentRest === "kb" ||
+    (contentRest != null && contentRest.startsWith("kb/"))
+  ) {
+    return "your knowledge base";
+  }
+  // Other content/, app/, pages/, public/, and components/ files are
+  // not inspected. A path-based label (including the old "another
+  // part of the site" tree-membership fallback) would mark them
+  // classified and invite publish for a payload we never read —
+  // JSON configs, robots.txt, fonts, CSS, page leftovers after
+  // executable source is already rejected.
+  if (isCustomerSiteImagePath(n)) {
+    return "a file in your photos and icons";
+  }
+  return null;
+}
+
+/**
+ * True when the owner-facing label came from file location, not from
+ * parsed site-copy wording. Callers must not say "this updates" as if
+ * the page or layout behavior had been verified.
+ */
+export function isPathLocationLabel(label: string): boolean {
+  return (
+    label === "your site copy" ||
+    label === "your knowledge base" ||
+    label === "your other site content" ||
+    label === "your photos and icons" ||
+    label === "a file in your photos and icons" ||
+    label === "your pages and layout" ||
+    label === "a file in your pages and layout" ||
+    label === "your page layout" ||
+    label === "a file in your page layout" ||
+    label === "the site's dependencies" ||
+    label === "how the site is hosted" ||
+    label === "another part of the site"
+  );
+}
+
+/**
+ * Destination plus rename source. GitHub reports a rename as one file:
+ * `filename` is where it landed, `previousFilename` is where it left.
+ * Classification that only reads the destination drops the source
+ * surface from the summary.
+ */
+export function namedFilePaths(file: NamedFile): string[] {
+  const paths = [file.filename];
+  const previous = String(file.previousFilename ?? "").trim();
+  if (previous && previous !== file.filename) {
+    paths.push(previous);
+  }
+  return paths;
+}
+
+/**
+ * Unique plain-language sections from a file list. Unrecognized paths
+ * are omitted — they are not a named site section. A rename that
+ * crosses two classified surfaces contributes both labels.
+ */
+export function sectionsFromFiles(files: NamedFile[]): string[] {
+  const seen = new Set<string>();
+  const out: string[] = [];
+  for (const f of files) {
+    for (const path of namedFilePaths(f)) {
+      const section = plainFileLabel(path);
+      if (!section) continue;
+      if (!seen.has(section)) {
+        seen.add(section);
+        out.push(section);
+      }
+    }
+  }
+  return out;
+}
+
+export type FieldLabelOpts = {
+  /** Service name when the field lives on a services[] item. */
+  serviceName?: string;
+};
+
+/**
+ * Collapse untrusted site copy so it cannot open a new owner-facing line.
+ * Newlines and other controls become spaces; the words stay.
+ */
+export function flattenOwnerWhitespace(value: string): string {
+  return value
+    .replace(/[\u0000-\u001F\u007F-\u009F\u2028\u2029]/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+/**
+ * Consecutive keys at the START of the path. A match at any depth
+ * (`analytics.services.enabled`) is not a prefix — it would label
+ * an unrelated nested field as verified business content.
+ */
+function hasLeadingPrefix(
+  keys: readonly string[],
+  prefix: readonly string[],
+): boolean {
+  if (prefix.length === 0 || prefix.length > keys.length) return false;
+  return prefix.every((part, i) => keys[i] === part);
+}
+
+function hasLeadingKey(keys: readonly string[], name: string): boolean {
+  return keys[0] === name;
+}
+
+const HOURS_KEY_NAMES = new Set([
+  "hours",
+  "openinghours",
+  "openinghoursspecification",
+]);
+
+/**
+ * Shop hours live at top-level `hours` / `openingHours` /
+ * `openingHoursSpecification`, or under `contact` / `schema`. A
+ * nested `analytics.hours.trackingWindow` is not the owner's hours.
+ */
+function isOwnerHoursPath(keys: readonly string[]): boolean {
+  if (HOURS_KEY_NAMES.has(keys[0] ?? "")) return true;
+  if (
+    (keys[0] === "contact" || keys[0] === "schema") &&
+    HOURS_KEY_NAMES.has(keys[1] ?? "")
+  ) {
+    return true;
+  }
+  return false;
+}
+
+/**
+ * Address lives at top-level `address`, `contact.address`, or
+ * `schema.address`. A nested `analytics.address.geo` is not the
+ * shop address.
+ */
+function isOwnerAddressPath(keys: readonly string[]): boolean {
+  if (hasLeadingKey(keys, "address")) return true;
+  return (
+    hasLeadingPrefix(keys, ["contact", "address"]) ||
+    hasLeadingPrefix(keys, ["schema", "address"])
+  );
+}
+
+/**
+ * Phone lives at top-level `phone`, `contact.phone`, or `schema.phone`.
+ * A nested `analytics.phone` event name is not the shop number.
+ */
+function isOwnerPhonePath(keys: readonly string[]): boolean {
+  if (hasLeadingKey(keys, "phone")) return true;
+  return (
+    hasLeadingPrefix(keys, ["contact", "phone"]) ||
+    hasLeadingPrefix(keys, ["schema", "phone"])
+  );
+}
+
+/**
+ * Email lives at top-level `email`, `contact.email`, or `schema.email`.
+ * A nested `analytics.email` flag is not the shop inbox.
+ */
+function isOwnerEmailPath(keys: readonly string[]): boolean {
+  if (hasLeadingKey(keys, "email")) return true;
+  return (
+    hasLeadingPrefix(keys, ["contact", "email"]) ||
+    hasLeadingPrefix(keys, ["schema", "email"])
+  );
+}
+
+/**
+ * Owner vocabulary from object-key names only. Array identities are not
+ * keys — a service slug like `x].hours[` must not be able to impersonate
+ * the hours field.
+ *
+ * Section names are position-scoped to the schema location (leading
+ * key, or a known parent). Matching the word anywhere in the path
+ * would classify `analytics.services.enabled` as "your services list".
+ */
+export function labelForSiteObjectKeys(
+  keys: readonly string[],
+  opts: FieldLabelOpts = {},
+): string | null {
+  if (keys.length === 0) return null;
+  const lower = keys.map((k) => k.toLowerCase());
+  const last = lower[lower.length - 1] ?? "";
+  const secondLast = lower.length >= 2 ? lower[lower.length - 2] : "";
+  const service = flattenOwnerWhitespace(opts.serviceName ?? "");
+
+  // Exact key names only. A substring match on "openinghours" would
+  // label analytics.openingHoursEventName as "your hours" and treat
+  // an unnamed field as verified.
+  if (isOwnerHoursPath(lower)) {
+    return "your hours";
+  }
+
+  if (hasLeadingKey(lower, "services")) {
+    // SEO metadata before the generic description check —
+    // `services[].seo.description` is the search listing, not the
+    // visible service description.
+    if (
+      secondLast === "seo" &&
+      (last === "title" || last === "description")
+    ) {
+      return service
+        ? `the ${service} search listing`
+        : "a service search listing";
+    }
+    if (last === "description" || last === "shortdescription") {
+      return service
+        ? `the ${service} service description`
+        : "a service description";
+    }
+    if (last === "name") {
+      return service ? `the ${service} service name` : "a service name";
+    }
+    return "your services list";
+  }
+
+  if (hasLeadingKey(lower, "hero")) {
+    if (secondLast === "hero" && last === "headline") {
+      return "your homepage headline";
+    }
+    if (secondLast === "hero" && last === "subheadline") {
+      return "your homepage subheadline";
+    }
+    return "your homepage hero section";
+  }
+
+  if (hasLeadingKey(lower, "faq")) {
+    return "your FAQs";
+  }
+
+  if (isOwnerPhonePath(lower)) {
+    return "your phone number";
+  }
+  if (isOwnerEmailPath(lower)) {
+    return "your email";
+  }
+  if (isOwnerAddressPath(lower)) {
+    return "your address";
+  }
+
+  if (
+    (lower.length === 1 && last === "name") ||
+    (lower.length === 2 && lower[0] === "meta" && last === "name") ||
+    (lower.length === 1 && last === "businessname") ||
+    (lower.length === 2 && lower[0] === "meta" && last === "businessname")
+  ) {
+    return "your business name";
+  }
+  if (
+    (lower.length === 1 && last === "tagline") ||
+    (lower.length === 2 && lower[0] === "meta" && last === "tagline")
+  ) {
+    return "your tagline";
+  }
+
+  if (hasLeadingKey(lower, "nav")) {
+    return "your menu";
+  }
+  if (hasLeadingKey(lower, "process")) {
+    return "how you work";
+  }
+  if (hasLeadingKey(lower, "gallery")) {
+    return "your photo gallery";
+  }
+  if (hasLeadingKey(lower, "schedulesection")) {
+    return "your scheduling section";
+  }
+  if (hasLeadingKey(lower, "contactsection")) {
+    return "your contact section";
+  }
+  if (hasLeadingKey(lower, "reviews")) {
+    return "your reviews";
+  }
+  if (hasLeadingKey(lower, "trustbar")) {
+    return "your trust badges";
+  }
+
+  return null;
+}
+
+/**
+ * Map a content/site.ts field path to owner vocabulary.
+ * Returns null when the path is not a known owner-facing field — callers
+ * must not invent a name for it.
+ *
+ * Bracket groups are treated as array slots and dropped. Callers that
+ * have structured path segments must use `labelForSiteObjectKeys` so an
+ * array identity cannot inject extra keys.
+ */
+export function labelForSiteField(
+  fieldPath: string,
+  opts: FieldLabelOpts = {},
+): string | null {
+  const keys = fieldPath
+    .replace(/\[[^\]]*\]/g, ".")
+    .split(".")
+    .filter((part) => part.length > 0);
+  return labelForSiteObjectKeys(keys, opts);
+}
+
+/**
+ * True when a string looks like a file path, hunk header, or line number —
+ * the things owner-facing text must never contain.
+ */
+export function looksLikeFilePathOrHunk(text: string): boolean {
+  if (/\bcontent\/site\.ts\b/.test(text)) return true;
+  if (/\b(?:app|pages|public|components|content)\/[\w./-]+\.\w{1,8}\b/.test(text)) {
+    return true;
+  }
+  if (/^@@ /.test(text) || /\s@@\s/.test(text)) return true;
+  if (/\bpackage(?:-lock)?\.json\b/.test(text)) return true;
+  if (/\bnext\.config\.\w+\b/.test(text)) return true;
+  return false;
+}
