+
+function identText(
+  node: ts.ModuleExportName | ts.BindingName | undefined,
+): string | null {
+  if (!node) return null;
+  if (ts.isIdentifier(node) || ts.isStringLiteral(node)) return node.text;
+  return null;
+}
+
+function collectBindingNames(name: ts.BindingName): string[] {
+  if (ts.isIdentifier(name)) return [name.text];
+  const out: string[] = [];
+  for (const el of name.elements) {
+    if (ts.isOmittedExpression(el) || !ts.isBindingElement(el)) continue;
+    out.push(...collectBindingNames(el.name));
+  }
