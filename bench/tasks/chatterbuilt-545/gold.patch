+/**
+ * preview_change — owner-facing private preview of a proposed site change.
+ *
+ * Shows what will differ in business vocabulary, plus a before/after when
+ * we can actually read the wording, plus a draft-site link only when
+ * hosting returned a real URL. Never invents a diff or a URL.
+ *
+ * PREVIEW ONLY — never merges, publishes, or applies the change.
+ */
+
+import * as ts from "typescript";
+import { resolvePreviewUrl } from "./preview-url";
+import {
+  flattenOwnerWhitespace,
+  isCustomerSiteCopyPath,
+  isPathLocationLabel,
+  labelForSiteField,
+  labelForSiteObjectKeys,
+  namedFilePaths,
+  plainFileLabel,
+  sectionsFromFiles,
+} from "./site-section-labels";
+import { requireUpdateBotRepoGrant } from "./update-bot-auth";
+
+export const PREVIEW_CHANGE_NOTICE =
+  "PREVIEW ONLY — this shows what the draft would change. It never publishes, and it never invents a link.";
+
+/**
+ * Banner when we are not showing a verified change. The success notice
+ * claims "this shows what the draft would change" — that is false on
+ * unavailable / not-pending results.
+ */
+export const PREVIEW_CHANGE_NO_DIFF_NOTICE =
+  "PREVIEW ONLY — this never publishes or invents a link.";
+
+/**
+ * Banner when the draft includes files or site-copy we cannot classify.
+ * The success notice claims "this shows what the draft would change" —
+ * that is false for the unclassified portion.
+ */
+export const PREVIEW_CHANGE_INCOMPLETE_NOTICE =
+  "PREVIEW ONLY — this does not show everything the draft would change. It never publishes, and it never invents a link.";
+
+/**
+ * Generic unbound invitation. Never returned for a ready preview — the
+ * issued prompt must name the head SHA and merge-base SHA (see
+ * shaBoundApprovalPrompt). Tests use this string as the forbidden form.
+ */
+export const APPROVAL_PROMPT =
+  "Reply yes to publish, no to discard, or tell me what to change.";
+
+/** Owner-facing when the draft exists but hosting has not produced a site. */
+export const NOT_READY_PROMPT =
+  "I won't ask you to publish until the draft site is ready.";
+
+/**
+ * Owner-facing when hosting is ready but at least one changed file could
+ * not be tied to a reviewed site surface. Not the same claim as "the
+ * draft site is not ready".
+ */
+export const UNCLASSIFIED_CHANGES_PROMPT =
+  "I won't ask you to publish while this draft includes files I cannot tie to the live site.";
+
+/**
+ * Owner-facing when the pull request does not target the repository's
+ * default branch. GitHub's default branch is a proxy for where the
+ * site is published — this tool does not read Vercel's production
+ * branch mapping. Merging a `develop` PR while production deploys
+ * from `main` would not update the live site.
+ *
+ * Must not assert that the default branch *is* where the site
+ * publishes. That is unverified without the Vercel project setting.
+ */
+export const NON_PRODUCTION_BASE_PROMPT =
+  "I won't ask you to publish this draft because it does not target the repository's default branch, which is the best signal I have for where the site is published.";
+
+export const NON_PRODUCTION_BASE_REASON =
+  "This draft does not target the repository's default branch, which is the best signal I have for where the site is published.";
+
+/**
+ * Honest limit on the default-branch proxy. This tool never reads
+ * Vercel's Production Branch setting, so a ready invite must not
+ * treat GitHub's default branch as verified production.
+ */
+export const DEFAULT_BRANCH_PRODUCTION_PROXY_CAVEAT =
+  "I used the repository's default branch as the best signal I have for where the site is published. I cannot confirm Vercel's production branch matches it.";
+
+/** Chat-bubble wrap width (phone-first; URLs stay on their own line). */
+export const OWNER_BUBBLE_WIDTH = 60;
+
+/**
+ * GitHub login (user or org): 1–39 characters, alphanumeric or single
+ * hyphens, no leading or trailing hyphen.
+ */
+export const GITHUB_OWNER_RE =
+  /^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$/;
+
+/**
+ * GitHub repository name: 1–100 characters of [A-Za-z0-9._-], not `.` or `..`.
+ */
+export const GITHUB_REPO_RE = /^(?!\.{1,2}$)[A-Za-z0-9._-]{1,100}$/;
+
+export function isGitHubOwner(value: string): boolean {
+  return GITHUB_OWNER_RE.test(value);
+}
+
+export function isGitHubRepoName(value: string): boolean {
+  return GITHUB_REPO_RE.test(value);
+}
+
+const MAX_PAIRS = 5;
+const MAX_VALUE_CHARS = 200;
+const MAX_FILE_BYTES = 500_000;
+const FILES_PER_PAGE = 100;
+const MAX_FILE_PAGES = 10;
+
+export type PreviewFile = {
+  filename: string;
+  status: string;
+  patch?: string;
+  previousFilename?: string;
+};
+
+export type PreviewDeployStatus =
+  | "ready"
+  | "building"
+  | "failed"
+  | "none"
+  | "unavailable";
+
+export type PreviewDeploy = {
+  /** Platform-returned URL only. May still be rejected as a placeholder. */
+  url: string | null;
+  /**
+   * `none` is verified-absent. `unavailable` is "I could not read
+   * hosting" — never the same claim as "hosting returned no link".
+   */
+  status: PreviewDeployStatus;
+  /**
+   * Why a URL was refused even though GitHub returned deployments.
+   * Shown to the owner; never a ready/success claim.
+   */
+  warning?: string | null;
+};
+
+export type PreviewPull = {
+  number: number;
+  title: string;
+  headSha: string;
+  baseSha: string;
+  headRef: string;
+  baseRef: string;
+  /**
+   * Repository default branch from GitHub. Compared to `baseRef` as a
+   * proxy for "this PR would land where the site is published". Empty
+   * when GitHub did not return one — fail closed, not publishable.
+   */
+  defaultBranch: string;
+  /**
+   * Three-dot merge base of the pull request. File-to-file comparison must
+   * use this SHA, never the current base-branch tip — a later main-side
+   * edit is not part of this suggestion.
+   */
+  mergeBaseSha: string | null;
+  /** GitHub PR state: open | closed. */
+  state: string;
+  /** True when GitHub reports the PR as merged. */
+  merged: boolean;
+  /** GitHub `changed_files` count when present. */
+  changedFiles: number | null;
+  /** True when the file list is known incomplete (no pagination / cap). */
+  filesTruncated: boolean;
+  files: PreviewFile[];
+};
+
+export type PreviewDiffClient = {
+  getPull: (args: {
+    owner: string;
+    repo: string;
+    number: number;
+  }) => Promise<PreviewPull>;
+  getPreviewDeploy: (args: {
+    owner: string;
+    repo: string;
+    sha: string;
+  }) => Promise<PreviewDeploy>;
+  getFileAtRef?: (args: {
+    owner: string;
+    repo: string;
+    path: string;
+    ref: string;
+  }) => Promise<string | null>;
+};
+
+export type VisualPair = {
+  label: string;
+  before: string | null;
+  after: string | null;
+};
+
+export type PreviewChangeResult =
+  | {
+      mode: "ok";
+      notice: string;
+      title: string | null;
+      sections: string[];
+      summary: string;
+      visual: {
+        available: boolean;
+        reason: string | null;
+        pairs: VisualPair[];
+        /** Wording changes not listed because of the display cap. */
+        hiddenCount: number;
+      };
+      preview: {
+        url: string | null;
+        status: PreviewDeployStatus;
+        warning: string | null;
+      };
+      /**
+       * Head SHA this preview described. A later "yes" must re-check this
+       * SHA — the prompt is not a licence to publish whatever the branch
+       * became afterwards.
+       */
+      previewedSha: string;
+      /**
+       * Merge-base SHA this preview compared against. Head alone does
+       * not identify the effective diff: a stacked PR's merge base can
+       * move while HEAD stays put. Empty when GitHub did not give one.
+       */
+      previewedMergeBaseSha: string;
+      /**
+       * True when any changed file could not be tied to a reviewed site
+       * surface (destination and rename source both count), or when
+       * content/site.ts has changes the site-object diff cannot name or
+       * verify (unnamed scalars, helper exports, module-level imports).
+       * Publish approval must fail closed while this is true.
+       */
+      unclassifiedChanges: boolean;
+      /**
+       * True only when this PR's base branch is the repository default
+       * branch (the always-available proxy for where the site publishes).
+       * Not a Vercel production-branch check — false or missing must
+       * not invite publish, and true still carries the proxy caveat.
+       */
+      targetsProductionBase: boolean;
+      approvalPrompt: string;
+    }
+  | {
+      mode: "unavailable";
+      reason: "diff_unavailable";
+      notice: string;
+      message: string;
+      preview: {
+        url: string | null;
+        status: PreviewDeployStatus;
+        warning: string | null;
+      };
+    }
+  | {
+      mode: "not_pending";
+      notice: string;
+      title: string | null;
+      message: string;
+    };
+
+export type PreviewChangeArgs = {
+  /** Authenticated MCP account; required by the live GitHub path. */
+  accountId?: string;
+  owner: string;
+  repo: string;
+  number: number;
+  /** Caller-supplied draft URL. Never treated as hosting verification. */
+  previewUrl?: string;
+  client?: PreviewDiffClient;
+};
+
+/**
+ * Injected clients exist so unit tests can stand in for GitHub without a
+ * network call. Production must never skip the account→repo grant by
+ * supplying its own client — vitest is the only process that sets VITEST.
+ */
+function allowInjectedPreviewClient(): boolean {
+  return process.env.VITEST === "true";
+}
+
+/**
+ * GitHub reports a rename as one file: `filename` is the destination,
+ * `previousFilename` is the source. Classification that only reads the
+ * destination treats "move middleware.ts to public/middleware.txt" as a
+ * classified static-file change and never notices the executable source.
+ */
+function previewFilePaths(file: PreviewFile): string[] {
+  return namedFilePaths(file);
+}
+
+function fileHasUnverifiablePreviewPath(file: PreviewFile): boolean {
+  return previewFilePaths(file).some((p) => plainFileLabel(p) == null);
+}
+
+function fileTouchesCustomerSiteCopy(file: PreviewFile): boolean {
+  return previewFilePaths(file).some((p) => isCustomerSiteCopyPath(p));
+}
+
+/**
+ * Owner-facing preview of a pending suggestion.
+ */
+export async function previewChange(
+  args: PreviewChangeArgs,
+): Promise<PreviewChangeResult> {
+  if (!Number.isInteger(args.number) || args.number < 1) {
+    throw new Error(
+      "Suggestion number must be a positive integer (the PR number).",
+    );
+  }
+  if (!isGitHubOwner(args.owner) || !isGitHubRepoName(args.repo)) {
+    throw new Error("That is not a GitHub repository name.");
+  }
+
+  const injected =
+    args.client && allowInjectedPreviewClient() ? args.client : undefined;
+  if (!injected) {
+    const accountId = String(args.accountId ?? "").trim();
+    if (!accountId) {
+      throw new Error(
+        "An authenticated Chatterbuilt account is required to preview a change on a customer repo.",
+      );
+    }
+    requireUpdateBotRepoGrant({
+      accountId,
+      owner: args.owner,
+      repo: args.repo,
+    });
+  }
+
+  const client = injected ?? createGitHubPreviewDiffClient();
+  const pull = await client.getPull({
+    owner: args.owner,
+    repo: args.repo,
+    number: args.number,
+  });
+
+  const title = pull.title.trim() ? pull.title.trim() : null;
+  const previewedSha = bindablePreviewSha(pull.headSha);
+  const previewedMergeBaseSha = bindablePreviewSha(pull.mergeBaseSha);
+  if (!isPendingSuggestion(pull)) {
+    return notPendingResult(pull);
+  }
+  if (!previewedSha) {
+    return {
+      mode: "unavailable",
+      reason: "diff_unavailable",
+      notice: PREVIEW_CHANGE_NO_DIFF_NOTICE,
+      message:
+        "I couldn't tell which version of the draft this is, so I'm not going to describe it or ask you to publish it.",
+      preview: { url: null, status: "none", warning: null },
+    };
+  }
+
+  const preview = await resolvePreview(client, {
+    owner: args.owner,
+    repo: args.repo,
+    sha: previewedSha,
+    callerUrl: args.previewUrl,
+  });
+
+  if (pull.filesTruncated) {
+    return confirmThenUnavailable(client, {
+      owner: args.owner,
+      repo: args.repo,
+      number: args.number,
+      expectedSha: previewedSha,
+      expectedMergeBaseSha: pull.mergeBaseSha,
+      expectedBaseSha: pull.baseSha,
+      expectedBaseRef: pull.baseRef,
+      expectedFilesFingerprint: diffFilesFingerprint(pull),
+      preview,
+      message:
+        "I couldn't see the full file list for this change, so I'm not going to describe it as complete or ask you to publish it.",
+    });
+  }
+
+  if (pull.files.length === 0) {
+    return confirmThenUnavailable(client, {
+      owner: args.owner,
+      repo: args.repo,
+      number: args.number,
+      expectedSha: previewedSha,
+      expectedMergeBaseSha: pull.mergeBaseSha,
+      expectedBaseSha: pull.baseSha,
+      expectedBaseRef: pull.baseRef,
+      expectedFilesFingerprint: diffFilesFingerprint(pull),
+      preview,
+      message:
+        "I couldn't see what this change would do. The file list came back empty, so I'm not going to describe a change I haven't verified.",
+    });
+  }
+
+  const fileSections = sectionsFromFiles(pull.files);
+  const siteFiles = pull.files.filter((f) =>
+    isCustomerSiteCopyPath(f.filename),
+  );
+  // Nested copies (examples/, tests/, another package) are not the
+  // customer site. Two real site-copy paths — content/site.ts and
+  // src/content/site.ts — is also not a unique file we can describe.
+  const siteFile = siteFiles.length === 1 ? siteFiles[0] : undefined;
+
+  let pairs: VisualPair[] = [];
+  let visualReason: string | null =
+    siteFiles.length > 1
+      ? "This change includes more than one site-copy file, so I won't guess which wording to show you."
+      : null;
+  let unnamedSiteCopyCount = 0;
+  let namedFromParsedSiteCopy = false;
+  // True when we actually retrieved both file versions. A patch of a
+  // comment must not become the visual after a failed parse — that is
+  // how a commented-out example is presented as the real site copy.
+  let hadBothSiteFiles = false;
+  let beforeSrc: string | null = null;
+  let afterSrc: string | null = null;
+
+  // Compare merge-base vs head (what the PR actually introduces). Never
+  // compare the current base-branch tip to a stale head — that reports
+  // later main-side edits as if this suggestion were reverting them.
+  const beforeRef = pull.mergeBaseSha;
+  if (siteFile && client.getFileAtRef && beforeRef) {
+    const [beforeFetched, afterFetched] = await Promise.all([
+      client.getFileAtRef({
+        owner: args.owner,
+        repo: args.repo,
+        path: siteFile.filename,
+        ref: beforeRef,
+      }),
+      client.getFileAtRef({
+        owner: args.owner,
+        repo: args.repo,
+        path: siteFile.filename,
+        ref: previewedSha,
+      }),
+    ]);
+    beforeSrc = beforeFetched;
+    afterSrc = afterFetched;
+    if (beforeSrc != null && afterSrc != null) {
+      hadBothSiteFiles = true;
+      const beforeObj = tryParseSiteSource(beforeSrc);
+      const afterObj = tryParseSiteSource(afterSrc);
+      if (beforeObj && afterObj) {
+        const diff = diffSiteCopy(beforeSrc, afterSrc);
+        pairs = diff.pairs;
+        unnamedSiteCopyCount = diff.unnamedCount;
+        namedFromParsedSiteCopy = true;
+        if (pairs.length === 0) {
+          visualReason =
+            unnamedSiteCopyCount === 0
+              ? SITE_COPY_UNCHANGED_REASON
+              : SITE_COPY_UNNAMED_REASON;
+        }
+      } else {
+        visualReason =
+          "I couldn't read the site copy before and after, so I don't have a side-by-side of the wording.";
+      }
+    } else {
+      visualReason =
+        "I couldn't read the site copy before and after, so I don't have a side-by-side of the wording.";
+    }
+  }
+
+  if (pairs.length === 0 && siteFile?.patch && !hadBothSiteFiles) {
+    // One file version cannot authenticate both halves of a -/+ pair.
+    // visualPairsFromPatch requires both complete sources and places
+    // each side in that side's exported object. Missing either → no
+    // pairs. Do not substitute after ?? before: that is how a helper
+    // object's removed wording is reported as the prior site copy.
+    const fromPatch = visualPairsFromPatch(
+      siteFile.patch,
+      afterSrc,
+      beforeSrc,
+    );
+    if (fromPatch.length > 0) {
+      pairs = fromPatch;
+      visualReason = null;
+    } else if (!visualReason) {
+      visualReason =
+        "The draft includes site copy, but I couldn't read a before-and-after of the wording from the patch.";
+    }
+  }
+
+  if (pairs.length === 0 && !siteFile && !visualReason) {
+    visualReason =
+      "This change is not in the site copy I know how to compare, so I don't have a side-by-side of the wording.";
+  }
+
+  if (pairs.length === 0 && !visualReason) {
+    visualReason =
+      "I can name the parts of the site this touches. I don't have a side-by-side of the wording.";
+  }
+
+  const visualAvailable = pairs.length > 0;
+  const hiddenCount = visualAvailable
+    ? Math.max(0, pairs.length - MAX_PAIRS)
+    : 0;
+  const fieldSections = uniqueLabels(pairs.map((p) => p.label));
+  // A known wording change must not hide other files or unnamed
+  // scalar edits. Keep "your site copy" when we did not fully parse
+  // it, or when parsed copy has changes we cannot name. A verified
+  // semantic no-op (parsed, zero named fields, zero unnamed) is not
+  // a site-copy change — a comment-only edit must not become
+  // "This updates your site copy."
+  // Other top-level exports (getServiceBySlug, etc.), module-level
+  // imports, and top-level statements that run at module evaluation
+  // are not in the site object we diff. A change there is unverified
+  // behaviour.
+  let otherExportsChanged = false;
+  if (beforeSrc != null && afterSrc != null) {
+    otherExportsChanged = otherExportedDeclarationsChanged(
+      beforeSrc,
+      afterSrc,
+    );
+  }
+  const keepSiteCopyLabel =
+    !namedFromParsedSiteCopy ||
+    unnamedSiteCopyCount > 0 ||
+    otherExportsChanged;
+  const extraFileSections = fileSections.filter((section) => {
+    if (section === "your site copy") return keepSiteCopyLabel;
+    return true;
+  });
+  const sections = uniqueLabels([...fieldSections, ...extraFileSections]);
+  const unlabeledFiles = pull.files.some(fileHasUnverifiablePreviewPath);
+  const siteCopyUnchanged =
+    namedFromParsedSiteCopy &&
+    unnamedSiteCopyCount === 0 &&
+    pairs.length === 0 &&
+    !otherExportsChanged;
+  // Site-copy verification succeeds only with exactly one customer
+  // site-copy file, both sides retrieved, a successful parse, and
+  // every changed field named. Two files, a missing side, a failed
+  // parse, or an unnamed scalar are unverified — not a green light
+  // to invite publish. A rename whose source or destination is
+  // content/site.ts still counts as touching site copy.
+  const siteCopyVerified =
+    siteFiles.length === 1 &&
+    hadBothSiteFiles &&
+    namedFromParsedSiteCopy &&
+    unnamedSiteCopyCount === 0;
+  const siteCopyUnverified =
+    pull.files.some(fileTouchesCustomerSiteCopy) && !siteCopyVerified;
+  // The site object can be a semantic no-op while a helper export
+  // or a module-level import changed. That is not "no change in
+  // the wording the site uses".
+  if (otherExportsChanged && visualReason === SITE_COPY_UNCHANGED_REASON) {
+    visualReason = null;
+  }
+
+  const confirmed = await confirmPendingHead(client, {
+    owner: args.owner,
+    repo: args.repo,
+    number: args.number,
+    expectedSha: previewedSha,
+    expectedMergeBaseSha: pull.mergeBaseSha,
+    expectedBaseSha: pull.baseSha,
+    expectedBaseRef: pull.baseRef,
+    expectedFilesFingerprint: diffFilesFingerprint(pull),
+  });
+  if (confirmed.status === "moved") {
+    return draftMovedUnavailable();
+  }
+  if (confirmed.status === "not_pending") {
+    return notPendingResult(confirmed.pull);
+  }
+
+  const unclassifiedChanges =
+    unlabeledFiles || otherExportsChanged || siteCopyUnverified;
+  const targetsProductionBase = pullTargetsDefaultBranch(confirmed.pull);
+  const approvalPrompt = publishApprovalPrompt({
+    preview,
+    boundSha: previewedSha,
+    boundMergeBaseSha: previewedMergeBaseSha,
+    unclassifiedChanges,
+    targetsProductionBase,
+  });
+
+  let summary = buildSummary(sections, pairs, {
+    unlabeledFiles,
+    siteCopyUnchanged,
+  });
+  if (!targetsProductionBase) {
+    summary = summary
+      ? `${summary} ${NON_PRODUCTION_BASE_REASON}`
+      : NON_PRODUCTION_BASE_REASON;
+  } else {
+    const readyInvite = readyPublishApprovalPrompt(
+      previewedSha,
+      previewedMergeBaseSha,
+    );
+    // readyPublishApprovalPrompt returns NOT_READY_PROMPT when a SHA
+    // is not bindable — that must not attach the production-proxy
+    // caveat to a refused invite.
+    if (readyInvite !== NOT_READY_PROMPT && approvalPrompt === readyInvite) {
+      summary = summary
+        ? `${summary} ${DEFAULT_BRANCH_PRODUCTION_PROXY_CAVEAT}`
+        : DEFAULT_BRANCH_PRODUCTION_PROXY_CAVEAT;
+    }
+  }
+
+  return {
+    mode: "ok",
+    notice: unclassifiedChanges
+      ? PREVIEW_CHANGE_INCOMPLETE_NOTICE
+      : PREVIEW_CHANGE_NOTICE,
+    title,
+    sections,
+    summary,
+    visual: {
+      available: visualAvailable,
+      reason: visualAvailable ? null : visualReason,
+      pairs: visualAvailable ? pairs.slice(0, MAX_PAIRS) : [],
+      hiddenCount,
+    },
+    preview,
+    previewedSha,
+    previewedMergeBaseSha,
+    unclassifiedChanges,
+    targetsProductionBase,
+    approvalPrompt,
+  };
+}
+
+function draftMovedUnavailable(): Extract<
+  PreviewChangeResult,
+  { mode: "unavailable" }
+> {
+  return {
+    mode: "unavailable",
+    reason: "diff_unavailable",
+    notice: PREVIEW_CHANGE_NO_DIFF_NOTICE,
+    message:
+      "The draft changed while I was looking at it, so I'm not going to describe a mix of two versions. Ask me to preview again.",
+    preview: { url: null, status: "none", warning: null },
+  };
+}
+
+/**
+ * Re-check the PR snapshot before keeping any hosting state. A truncated
+ * or empty file list that returns a ready URL for head A must not survive
+ * a push of head B or a close.
+ */
+async function confirmThenUnavailable(
+  client: PreviewDiffClient,
+  args: {
+    owner: string;
+    repo: string;
+    number: number;
+    expectedSha: string;
+    expectedMergeBaseSha: string | null;
+    expectedBaseSha: string;
+    expectedBaseRef: string;
+    expectedFilesFingerprint: string;
+    preview: {
+      url: string | null;
+      status: PreviewDeployStatus;
+      warning: string | null;
+    };
+    message: string;
+  },
+): Promise<PreviewChangeResult> {
+  const confirmed = await confirmPendingHead(client, {
+    owner: args.owner,
+    repo: args.repo,
+    number: args.number,
+    expectedSha: args.expectedSha,
+    expectedMergeBaseSha: args.expectedMergeBaseSha,
+    expectedBaseSha: args.expectedBaseSha,
+    expectedBaseRef: args.expectedBaseRef,
+    expectedFilesFingerprint: args.expectedFilesFingerprint,
+  });
+  if (confirmed.status === "moved") {
+    return draftMovedUnavailable();
+  }
+  if (confirmed.status === "not_pending") {
+    return notPendingResult(confirmed.pull);
+  }
+  return {
+    mode: "unavailable",
+    reason: "diff_unavailable",
+    notice: PREVIEW_CHANGE_NO_DIFF_NOTICE,
+    message: args.message,
+    preview: args.preview,
+  };
+}
+
+type ConfirmPending =
+  | { status: "ok"; pull: PreviewPull }
+  | { status: "moved" }
+  | { status: "not_pending"; pull: PreviewPull };
+
+/**
+ * Open and unmerged on GitHub. That is not "published" and not "live" —
+ * only that GitHub still lists it as a pending suggestion.
+ */
+export function isPendingSuggestion(pull: {
+  state: string;
+  merged: boolean;
+}): boolean {
+  if (pull.merged) return false;
+  return String(pull.state ?? "").trim().toLowerCase() === "open";
+}
+
+function notPendingResult(pull: PreviewPull): Extract<
+  PreviewChangeResult,
+  { mode: "not_pending" }
+> {
+  const title = pull.title.trim() ? pull.title.trim() : null;
+  return {
+    mode: "not_pending",
+    notice: PREVIEW_CHANGE_NO_DIFF_NOTICE,
+    title,
+    message: notPendingMessage(pull),
+  };
+}
+
+/** Verified GitHub state only — never infers production publication. */
+export function notPendingMessage(pull: {
+  state: string;
+  merged: boolean;
+}): string {
+  if (pull.merged) {
+    return "This suggestion was merged on GitHub. I have not checked whether it is live on the site, so I am not going to ask you to approve it.";
+  }
+  const state = String(pull.state ?? "").trim().toLowerCase();
+  if (state === "closed") {
+    return "This suggestion is closed on GitHub. I have not checked whether those changes are live, so I am not going to ask you to approve it.";
+  }
+  return "I couldn't confirm this is still a pending suggestion, so I am not going to ask you to publish it.";
+}
+
+function mergeBaseIdentity(sha: string | null | undefined): string {
+  return String(sha ?? "").trim();
+}
+
+/**
+ * Effective-diff identity when a merge-base SHA is missing. Head SHA
+ * alone is not enough: a stacked PR's three-dot file list can shrink
+ * while the head stays put.
+ */
+function diffFilesFingerprint(pull: PreviewPull): string {
+  return JSON.stringify({
+    truncated: pull.filesTruncated === true,
+    changedFiles: pull.changedFiles,
+    files: pull.files.map((f) => ({
+      filename: f.filename,
+      status: f.status,
+      previousFilename: f.previousFilename ?? null,
+      patch: f.patch ?? null,
+    })),
+  });
+}
+
+async function confirmPendingHead(
+  client: PreviewDiffClient,
+  args: {
+    owner: string;
+    repo: string;
+    number: number;
+    expectedSha: string;
+    expectedMergeBaseSha: string | null;
+    expectedBaseSha: string;
+    expectedBaseRef: string;
+    expectedFilesFingerprint: string;
+  },
+): Promise<ConfirmPending> {
+  const latest = await client.getPull({
+    owner: args.owner,
+    repo: args.repo,
+    number: args.number,
+  });
+  const latestSha = bindablePreviewSha(latest.headSha);
+  if (!latestSha || latestSha !== args.expectedSha) {
+    return { status: "moved" };
+  }
+  const expectedBase = String(args.expectedBaseSha ?? "").trim();
+  const latestBase = String(latest.baseSha ?? "").trim();
+  if (!expectedBase || !latestBase || expectedBase !== latestBase) {
+    return { status: "moved" };
+  }
+  const expectedMerge = mergeBaseIdentity(args.expectedMergeBaseSha);
+  const latestMerge = mergeBaseIdentity(latest.mergeBaseSha);
+  if (expectedMerge !== latestMerge) {
+    return { status: "moved" };
+  }
+  // SHA equality is not destination identity: main and develop can
+  // point at the same commit. A retarget must not inherit the earlier
+  // targetsProductionBase snapshot.
+  if (!sameGitBranchIdentity(args.expectedBaseRef, latest.baseRef)) {
+    return { status: "moved" };
+  }
+  // No merge-base SHA means we cannot bind to git identity. The file
+  // list we described must still be the file list GitHub reports.
+  if (!expectedMerge) {
+    if (diffFilesFingerprint(latest) !== args.expectedFilesFingerprint) {
+      return { status: "moved" };
+    }
+  }
+  if (!isPendingSuggestion(latest)) {
+    return { status: "not_pending", pull: latest };
+  }
+  return { status: "ok", pull: latest };
+}
+
+/** True only when hosting returned a real draft URL for this SHA. */
+export function isDraftSiteReady(preview: {
+  url: string | null;
+  status: PreviewDeploy["status"];
+}): boolean {
+  return (
+    preview.status === "ready" &&
+    typeof preview.url === "string" &&
+    preview.url.length > 0
+  );
+}
+
+/**
+ * SHA that can appear in owner-facing text. Whitespace would wrap into
+ * a forged column-0 line, so it is not bindable.
+ */
+export function bindablePreviewSha(
+  value: string | null | undefined,
+): string {
+  const sha = typeof value === "string" ? value.trim() : "";
+  if (!sha || /\s/.test(sha)) return "";
+  return sha;
+}
+
+/**
+ * Invitation that names the previewed head SHA and the merge-base SHA
+ * it was compared against. This module never publishes; a later "yes"
+ * is handled by the owner (or their AI) on GitHub. Both SHAs are the
+ * identity that action must revalidate — head alone is not the
+ * effective diff.
+ */
+export function shaBoundApprovalPrompt(
+  sha: string,
+  mergeBaseSha: string,
+): string {
+  const id = bindablePreviewSha(sha);
+  const merge = bindablePreviewSha(mergeBaseSha);
+  if (!id || !merge) return NOT_READY_PROMPT;
+  return `Reply yes to publish this exact draft (${id} from ${merge}), no to discard, or tell me what to change.`;
+}
+
+/**
+ * Single decision for "Reply yes to publish". Both the result builder
+ * and the owner-facing formatter call this — they must not recompute
+ * the invitation independently and drift.
+ *
+ * This tool never publishes. There is no merge path here. The
+ * invitation therefore names the previewed head SHA and merge-base SHA
+ * rather than issuing a generic "Reply yes". Fail closed when either
+ * SHA is missing or not bindable, hosting is not ready, or any changed
+ * file could not be classified as a reviewed site surface.
+ */
+export function publishApprovalPrompt(args: {
+  preview: {
+    url: string | null;
+    status: PreviewDeploy["status"];
+  };
+  boundSha: string | null | undefined;
+  boundMergeBaseSha: string | null | undefined;
+  unclassifiedChanges: boolean;
+  /**
+   * Required. Missing or not-true is fail-closed: this draft is not
+   * verified to target the repository default branch (the proxy this
+   * tool has for where the site publishes). That is not a Vercel
+   * production-branch check.
+   */
+  targetsProductionBase: boolean;
+}): string {
+  const sha = bindablePreviewSha(args.boundSha);
+  const merge = bindablePreviewSha(args.boundMergeBaseSha);
+  if (!sha || !merge || !isDraftSiteReady(args.preview)) {
+    return NOT_READY_PROMPT;
+  }
+  if (args.targetsProductionBase !== true) {
+    return NON_PRODUCTION_BASE_PROMPT;
+  }
+  if (args.unclassifiedChanges !== false) {
+    return UNCLASSIFIED_CHANGES_PROMPT;
+  }
+  return readyPublishApprovalPrompt(sha, merge);
+}
+
+/**
+ * SHA-bound publish invite plus the default-branch / Vercel proxy
+ * caveat. The invite itself must not upgrade GitHub's default branch
+ * into a verified production target.
+ */
+export function readyPublishApprovalPrompt(
+  sha: string,
+  mergeBaseSha: string,
+): string {
+  const bound = shaBoundApprovalPrompt(sha, mergeBaseSha);
+  if (bound === NOT_READY_PROMPT) return bound;
+  return `${bound} ${DEFAULT_BRANCH_PRODUCTION_PROXY_CAVEAT}`;
+}
+
+/**
+ * Last-mile notice. Recomputed from the result, never trusted from
+ * `result.notice` alone — a classified-looking banner on an
+ * unclassified result would contradict the body.
+ */
+function ownerFacingNotice(result: PreviewChangeResult): string {
+  if (result.mode !== "ok") return PREVIEW_CHANGE_NO_DIFF_NOTICE;
+  if (result.unclassifiedChanges) return PREVIEW_CHANGE_INCOMPLETE_NOTICE;
+  return PREVIEW_CHANGE_NOTICE;
+}
+
+/**
+ * True when this PR's base is the repository default branch.
+ * GitHub's default branch is a proxy for production, not a Vercel
+ * production-branch mapping. Empty names fail closed.
+ */
+export function pullTargetsDefaultBranch(pull: {
+  baseRef: string;
+  defaultBranch: string;
+}): boolean {
+  const base = gitBranchName(pull.baseRef);
+  const def = gitBranchName(pull.defaultBranch);
+  if (!base || !def) return false;
+  return base === def;
+}
+
+function gitBranchName(value: string | null | undefined): string {
+  const raw = String(value ?? "").trim();
+  if (!raw) return "";
+  return raw.replace(/^refs\/heads\//i, "");
+}
+
+function sameGitBranchIdentity(
+  a: string | null | undefined,
+  b: string | null | undefined,
+): boolean {
+  return gitBranchName(a) === gitBranchName(b);
+}
+
+export function formatPreviewChangeResult(result: PreviewChangeResult): string {
+  if (result.mode === "unavailable") {
+    const lines = [ownerFacingNotice(result), "", result.message];
+    // An unavailable result carries no previewedSha. A leftover ready
+    // URL would be labeled "Draft ready" with no way to name the version,
+    // including a stale head A after a later push. Other hosting
+    // statuses (building, failed, none, unread) are still true.
+    if (result.preview.status !== "ready") {
+      lines.push("", formatPreviewBlock(result.preview));
+    }
+    return wrapOwnerText(lines.join("\n"));
+  }
+
+  if (result.mode === "not_pending") {
+    // PR titles are collaborator-controlled. Do not print them as a
+    // heading — a title can impersonate "Draft ready" and smuggle a URL.
+    const lines = [ownerFacingNotice(result), "", result.message];
+    return wrapOwnerText(lines.join("\n"));
+  }
+
+  const lines: string[] = [];
+  lines.push(ownerFacingNotice(result));
+  lines.push("");
+  // Same rule on the pending path: never interpolate the PR title into
+  // owner-facing text. "Draft ready" is emitted only inside the verified
+  // Draft site block, never as `Draft ready: ${title}`.
+  lines.push("What changes");
+  if (result.sections.length > 0) {
+    for (const s of result.sections) {
+      lines.push(`• ${flattenOwnerWhitespace(s)}`);
+    }
+  }
+  lines.push("");
+  lines.push(flattenOwnerWhitespace(result.summary));
+  lines.push("");
+
+  if (result.visual.available && result.visual.pairs.length > 0) {
+    for (const pair of result.visual.pairs) {
+      lines.push(flattenOwnerWhitespace(pair.label));
+      lines.push("Before");
+      lines.push(formatVisualValue(pair.before, "(not there yet)"));
+      lines.push("After");
+      lines.push(formatVisualValue(pair.after, "(removed)"));
+      lines.push("");
+    }
+    if (result.visual.hiddenCount > 0) {
+      const n = result.visual.hiddenCount;
+      lines.push(
+        n === 1
+          ? "There is 1 more wording change I haven't listed here."
+          : `There are ${n} more wording changes I haven't listed here.`,
+      );
+      lines.push("");
+    }
+  } else {
+    const reason = flattenOwnerWhitespace(
+      result.visual.reason ??
+        "I can name the parts of the site this touches. I don't have a side-by-side of the wording.",
+    );
+    const summary = flattenOwnerWhitespace(result.summary);
+    // The summary already said the honest thing (no wording change,
+    // unlabeled files). Repeating it as a "visual unavailable" line
+    // is a second copy of the same claim, not a second fact. A
+    // default-branch note appended to the same summary must not
+    // re-open the duplicate.
+    const summaryCore = flattenOwnerWhitespace(
+      summary
+        .replace(DEFAULT_BRANCH_PRODUCTION_PROXY_CAVEAT, " ")
+        .replace(NON_PRODUCTION_BASE_REASON, " "),
+    );
+    if (reason && reason !== summary && reason !== summaryCore) {
+      lines.push(reason);
+      lines.push("");
+    }
+  }
+
+  lines.push(formatPreviewBlock(result.preview));
+  lines.push("");
+  // The live MCP transport returns only this formatted text. A later
+  // "yes" cannot bind to a SHA the caller never received. Only invite
+  // publish after that identity is actually in the string, and the
+  // invitation itself must name both the head and the merge base — a
+  // generic "Reply yes" is not a bound approval.
+  const previewedSha = bindablePreviewSha(result.previewedSha);
+  const previewedMergeBaseSha = bindablePreviewSha(
+    result.previewedMergeBaseSha,
+  );
+  let boundSha: string | null = null;
+  let boundMergeBaseSha: string | null = null;
+  if (previewedSha) {
+    lines.push("This preview is of this exact draft:");
+    lines.push(previewedSha);
+    lines.push("");
+    boundSha = previewedSha;
+  }
+  if (previewedMergeBaseSha) {
+    lines.push("from");
+    lines.push(previewedMergeBaseSha);
+    lines.push("");
+    boundMergeBaseSha = previewedMergeBaseSha;
+  }
+  // Same function as the result builder. Hosting, SHA-in-the-text, and
+  // unclassified files each independently refuse — the formatter must
+  // not upgrade a NOT_READY / unclassified result into "Reply yes",
+  // and must not issue APPROVAL_PROMPT (the unbound form).
+  lines.push(
+    publishApprovalPrompt({
+      preview: result.preview,
+      boundSha,
+      boundMergeBaseSha,
+      unclassifiedChanges: result.unclassifiedChanges,
+      targetsProductionBase: result.targetsProductionBase === true,
+    }),
+  );
+  return wrapOwnerText(lines.join("\n"));
+}
+
+/**
+ * Text the live MCP transport returns. The formatted preview must carry
+ * the SHA — a later yes cannot bind to an identity the caller never saw.
+ */
+export function previewChangeTransportText(result: PreviewChangeResult): string {
+  const text = formatPreviewChangeResult(result);
+  if (result.mode !== "ok") return text;
+  const sha = bindablePreviewSha(result.previewedSha);
+  const merge = bindablePreviewSha(result.previewedMergeBaseSha);
+  if (sha && !text.includes(sha)) {
+    return wrapOwnerText(
+      `${PREVIEW_CHANGE_NO_DIFF_NOTICE}\n\nI couldn't keep this preview tied to one exact draft, so I am not going to ask you to publish it.`,
+    );
+  }
+  // An invitation that names "this exact draft" must carry both halves
+  // of the effective-diff identity. Head in the body and merge-base
+  // missing is the stacked-PR TOCTOU: the later "yes" would re-check
+  // the wrong diff.
+  if (/reply yes to publish this exact draft/i.test(text)) {
+    if (!sha || !merge || !text.includes(sha) || !text.includes(merge)) {
+      return wrapOwnerText(
+        `${PREVIEW_CHANGE_NO_DIFF_NOTICE}\n\nI couldn't keep this preview tied to one exact draft, so I am not going to ask you to publish it.`,
+      );
+    }
+  }
+  return text;
+}
+
+/**
+ * Owner-facing error from the preview_change transport. Invalid GitHub
+ * identifiers are omitted rather than echoed — a newline-laden `owner`
+ * must not become a column-0 "Draft ready." / URL / approval line.
+ * Exception text is flattened and hang-indented for the same reason.
+ */
+export function formatPreviewChangeLoadError(args: {
+  number: number;
+  owner: string;
+  repo: string;
+  message: string;
+}): string {
+  const n =
+    Number.isInteger(args.number) && args.number >= 1 ? args.number : 0;
+  const identity =
+    isGitHubOwner(args.owner) && isGitHubRepoName(args.repo)
+      ? ` on ${args.owner}/${args.repo}`
+      : "";
+  const detail = flattenOwnerWhitespace(args.message);
+  const lines = [`I couldn't load a preview of suggestion #${n}${identity}.`];
+  if (detail) {
+    lines.push(`  ${detail}`);
+  }
+  lines.push("");
+  lines.push(
+    "Check the number with list_suggestions. This account must be connected to that customer repo. I will not describe a change I have not seen.",
+  );
+  return wrapOwnerText(lines.join("\n"));
+}
+
+/**
+ * Owner-facing before/after cell. `null` means the field was absent;
+ * `""` is a real empty value and must not be shown as both missing and
+ * removed. Untrusted copy is flattened and indented so it cannot open a
+ * new line that impersonates "Draft ready", a draft URL, or the
+ * approval prompt.
+ */
+function formatVisualValue(
+  value: string | null,
+  absentLabel: string,
+): string {
+  if (value == null) return absentLabel;
+  if (value === "") return "(blank)";
+  const flat = flattenOwnerWhitespace(value);
+  if (!flat) return "(blank)";
+  return `  ${flat}`;
+}
+
+function formatPreviewBlock(preview: {
+  url: string | null;
+  status: PreviewDeploy["status"];
+  warning: string | null;
+}): string {
+  const lines = ["Draft site"];
+  if (preview.status === "building") {
+    lines.push(
+      "Still building. I don't have a real preview link yet — I won't make one up.",
+    );
+    if (preview.warning) lines.push(preview.warning);
+  } else if (preview.status === "failed") {
+    lines.push(
+      "The draft site did not build. I don't have a link to show you.",
+    );
+    if (preview.warning) lines.push(preview.warning);
+  } else if (preview.status === "ready" && preview.url) {
+    // Verified readiness only — never concatenated with a PR title.
+    lines.push("Draft ready.");
+    lines.push(preview.url);
+    if (preview.warning) lines.push(preview.warning);
+  } else if (preview.status === "unavailable") {
+    lines.push(preview.warning?.trim() || HOSTING_UNAVAILABLE_WARNING);
+  } else if (preview.warning) {
+    // The warning is the honest reason there is no URL. Do not also
+    // claim hosting returned nothing — that is false when it returned
+    // several drafts we refused to pick between.
+    lines.push(preview.warning);
+  } else {
+    lines.push(
+      "No draft-site link yet. Hosting did not return one, and I will not invent a URL.",
+    );
+  }
+  return lines.join("\n");
+}
+
+function namedUpdateSentence(sections: string[]): string | null {
+  if (sections.length === 0) return null;
+  // Path-based labels are file location, not verified wording. "updates"
+  // claims a business-section change we have not parsed.
+  const verb = sections.some((section) => isPathLocationLabel(section))
+    ? "changes"
+    : "updates";
+  if (sections.length === 1) {
+    return `This ${verb} ${sections[0]}.`;
+  }
+  if (sections.length === 2) {
+    return `This ${verb} ${sections[0]} and ${sections[1]}.`;
+  }
+  const rest = sections.slice(0, -1).join(", ");
+  return `This ${verb} ${rest}, and ${sections[sections.length - 1]}.`;
+}
+
+function buildSummary(
+  sections: string[],
+  pairs: VisualPair[],
+  extras: { unlabeledFiles: boolean; siteCopyUnchanged: boolean },
+): string {
+  const added = pairs.filter((p) => p.before == null && p.after != null);
+  const removed = pairs.filter((p) => p.after == null && p.before != null);
+  // A single add OR a single remove — never one when both happened.
+  // Picking the add and dropping the remove (or the reverse) names
+  // the wrong service when the list shifted. Also never when another
+  // named section exists — "This adds heating" must not hide hours
+  // or a reorder of the rest of the list.
+  const onlyServicesList =
+    sections.length > 0 &&
+    sections.every((section) => section === "your services list");
+  if (
+    onlyServicesList &&
+    added.length === 1 &&
+    removed.length === 0 &&
+    added[0] &&
+    added[0].label === "your services list"
+  ) {
+    return `This adds ${flattenOwnerWhitespace(added[0].after ?? "")} to your services list.`;
+  }
+  if (
+    onlyServicesList &&
+    removed.length === 1 &&
+    added.length === 0 &&
+    removed[0] &&
+    removed[0].label === "your services list"
+  ) {
+    return `This removes ${flattenOwnerWhitespace(removed[0].before ?? "")} from your services list.`;
+  }
+  const parts: string[] = [];
+  const named = namedUpdateSentence(sections);
+  if (named) {
+    parts.push(named);
+  } else if (extras.siteCopyUnchanged) {
+    parts.push(SITE_COPY_UNCHANGED_REASON);
+  }
+  if (extras.unlabeledFiles) {
+    parts.push(
+      parts.length === 0
+        ? UNLABELED_FILES_ONLY_REASON
+        : UNLABELED_FILES_ALSO_REASON,
+    );
+  }
+  if (parts.length === 0) {
+    return "This touches the site, but I cannot name the business section yet.";
+  }
+  return parts.join(" ");
