+    for (const prop of node.properties) {
+      if (ts.isSpreadAssignment(prop)) continue;
+      if (isLiteralProtoPropertyName(prop.name)) return true;
+    }
+  }
+  let found = false;
+  ts.forEachChild(node, (child) => {
+    if (found) return;
+    if (objectLiteralHasProtoSetter(child)) found = true;
+  });
+  return found;
+}
+
+/**
+ * Top-level runtime declarations keyed by local name. An `export { foo }`
+ * list is not the implementation — the function/class/const it names is.
+ */
+function topLevelRuntimeDeclarationsByName(
+  sf: ts.SourceFile,
+): Map<string, string[]> {
+  const map = new Map<string, string[]>();
+  const add = (name: string, text: string) => {
+    const list = map.get(name);
+    if (list) list.push(text);
+    else map.set(name, [text]);
+  };
+  for (const stmt of sf.statements) {
+    const text = stmt.getText(sf);
+    if (
+      (ts.isFunctionDeclaration(stmt) ||
+        ts.isClassDeclaration(stmt) ||
+        ts.isEnumDeclaration(stmt) ||
+        ts.isModuleDeclaration(stmt)) &&
+      stmt.name &&
+      ts.isIdentifier(stmt.name)
+    ) {
+      add(stmt.name.text, text);
+      continue;
+    }
+    if (ts.isVariableStatement(stmt)) {
+      for (const decl of stmt.declarationList.declarations) {
+        for (const name of collectBindingNames(decl.name)) {
+          add(name, text);
+        }
+      }
+    }
+  }
+  return map;
+}
+
+/**
+ * AST nodes for those same locals, so a fingerprint can walk from an
+ * exported wrapper into the unexported helpers it calls.
+ */
+function topLevelRuntimeDeclarationNodesByName(
+  sf: ts.SourceFile,
+): Map<string, ts.Node[]> {
+  const map = new Map<string, ts.Node[]>();
+  const add = (name: string, node: ts.Node) => {
+    const list = map.get(name);
+    if (list) list.push(node);
+    else map.set(name, [node]);
+  };
+  for (const stmt of sf.statements) {
+    if (
+      (ts.isFunctionDeclaration(stmt) ||
+        ts.isClassDeclaration(stmt) ||
+        ts.isEnumDeclaration(stmt) ||
+        ts.isModuleDeclaration(stmt)) &&
+      stmt.name &&
+      ts.isIdentifier(stmt.name)
+    ) {
+      add(stmt.name.text, stmt);
+      continue;
+    }
+    if (ts.isVariableStatement(stmt)) {
+      for (const decl of stmt.declarationList.declarations) {
+        for (const name of collectBindingNames(decl.name)) {
+          add(name, decl);
+        }
+      }
+    }
+  }
+  return map;
+}
+
+function appendNamedRuntimeDeclarations(
+  parts: string[],
+  declsByName: Map<string, string[]>,
+  name: string,
+): void {
+  if (name === "site") return;
+  const texts = declsByName.get(name);
+  if (!texts) return;
+  for (const text of texts) parts.push(text);
