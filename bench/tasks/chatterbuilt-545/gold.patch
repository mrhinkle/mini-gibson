+
+/**
+ * True when an object literal uses the grammar-level `__proto__`
+ * prototype setter (identifier or string name, not a computed key).
+ */
+function isLiteralProtoPropertyName(name: ts.PropertyName): boolean {
+  if (ts.isComputedPropertyName(name)) return false;
+  if (
+    ts.isIdentifier(name) ||
+    ts.isStringLiteral(name) ||
+    ts.isNoSubstitutionTemplateLiteral(name)
+  ) {
+    return name.text === "__proto__";
+  }
+  return false;
