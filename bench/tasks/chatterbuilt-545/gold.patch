+    if (ts.isVariableStatement(stmt)) {
+      const exported = hasExportKeyword(stmt);
+      const isConst = isConstDeclarationList(stmt.declarationList);
+      for (const decl of stmt.declarationList.declarations) {
+        if (!ts.isIdentifier(decl.name)) {
+          if (exported && collectBindingNames(decl.name).includes("site")) {
+            unparseable = true;
+          }
+          continue;
+        }
+        recordVar(decl.name.text, decl);
+        if (!isConst) nonConstBindings.add(decl.name.text);
+        if (exported && decl.name.text === "site") {
+          if (!isConst) unparseable = true;
+          else siteLocals.push("site");
+        }
+      }
+      continue;
+    }
+
+    if (
+      ts.isFunctionDeclaration(stmt) ||
+      ts.isClassDeclaration(stmt) ||
+      ts.isEnumDeclaration(stmt)
+    ) {
+      const name = stmt.name?.text;
+      if (name) nonConstBindings.add(name);
+      if (hasExportKeyword(stmt) && name === "site") unparseable = true;
+      continue;
+    }
+
+    if (ts.isModuleDeclaration(stmt) && ts.isIdentifier(stmt.name)) {
+      nonConstBindings.add(stmt.name.text);
+      if (hasExportKeyword(stmt) && stmt.name.text === "site") {
+        unparseable = true;
+      }
+    }
+  }
+
+  if (sawStarExport || unparseable) return { kind: "fail" };
+  if (siteLocals.length === 0) return { kind: "none" };
+  if (new Set(siteLocals).size !== 1 || siteLocals.length !== 1) {
+    return { kind: "fail" };
+  }
+  const local = siteLocals[0]!;
+  if (nonConstBindings.has(local)) return { kind: "fail" };
+
+  const decls = moduleLevelVars.get(local) ?? [];
+  if (decls.length !== 1) return { kind: "fail" };
+  const decl = decls[0]!;
+  if (!ts.isVariableDeclarationList(decl.parent)) return { kind: "fail" };
+  if (!isConstDeclarationList(decl.parent) || !decl.initializer) {
+    return { kind: "fail" };
+  }
+  const expr = unwrapDataExpression(decl.initializer);
+  if (!ts.isObjectLiteralExpression(expr)) return { kind: "fail" };
+
+  const start = expr.getStart(sf);
+  const end = expr.end;
+  if (start < 0 || end <= start) return { kind: "fail" };
+  // Static initializer text is not the runtime value if the module later
+  // mutates that object (Object.assign, property assignment, etc.).
+  if (exportedSiteLooksMutated(sf, decl)) return { kind: "fail" };
