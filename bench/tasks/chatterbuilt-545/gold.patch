+
+function uniqueLabels(labels: string[]): string[] {
+  const seen = new Set<string>();
+  const out: string[] = [];
+  for (const l of labels) {
+    if (!seen.has(l)) {
+      seen.add(l);
+      out.push(l);
+    }
+  }
+  return out;
+}
+
+async function resolvePreview(
+  client: PreviewDiffClient,
+  args: {
+    owner: string;
+    repo: string;
+    sha: string;
+    callerUrl?: string;
+  },
+): Promise<{
+  url: string | null;
+  status: PreviewDeploy["status"];
+  warning: string | null;
+}> {
+  let platform: PreviewDeploy;
+  try {
+    platform = await client.getPreviewDeploy({
+      owner: args.owner,
+      repo: args.repo,
+      sha: args.sha,
+    });
+  } catch {
+    return {
+      url: null,
+      status: "unavailable",
+      warning: HOSTING_UNAVAILABLE_WARNING,
+    };
+  }
+
+  if (platform.status === "building") {
+    return {
+      url: null,
+      status: "building",
+      warning: null,
+    };
+  }
+  if (platform.status === "failed") {
+    return {
+      url: null,
+      status: "failed",
+      warning: null,
+    };
+  }
+  if (platform.status === "unavailable") {
+    return {
+      url: null,
+      status: "unavailable",
+      warning:
+        platform.warning && platform.warning.trim()
+          ? platform.warning.trim()
+          : HOSTING_UNAVAILABLE_WARNING,
+    };
+  }
+
+  if (platform.status === "ready") {
+    const resolved = resolvePreviewUrl(platform.url);
+    if (resolved.url) {
+      if (isAuxiliaryDraftUrl(resolved.url)) {
+        return {
+          url: null,
+          status: "none",
+          warning: AUXILIARY_DRAFT_WARNING,
+        };
+      }
+      return { url: resolved.url, status: "ready", warning: null };
+    }
+    return {
+      url: null,
+      status: "none",
+      warning:
+        "Hosting said the draft was ready, but the link was not a real deploy URL, so I dropped it.",
+    };
+  }
+
+  // Platform none. A caller-supplied URL is not hosting verification —
+  // never promote it to ready / Draft site.
+  const warningParts: string[] = [];
+  if (platform.warning && platform.warning.trim()) {
+    warningParts.push(platform.warning.trim());
+  }
+  if (args.callerUrl && String(args.callerUrl).trim()) {
+    warningParts.push(
+      "A link was passed in with the request, but hosting did not return its own, so I am not showing it as the draft site.",
+    );
+  }
+  return {
+    url: null,
+    status: "none",
+    warning: warningParts.length > 0 ? warningParts.join(" ") : null,
+  };
