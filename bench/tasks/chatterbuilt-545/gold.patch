+    if (ts.isImportEqualsDeclaration(stmt)) {
+      if (!stmt.isTypeOnly) nonConstBindings.add(stmt.name.text);
+      continue;
+    }
+
+    if (ts.isExportDeclaration(stmt)) {
+      if (stmt.isTypeOnly) continue;
+      if (!stmt.exportClause) {
+        if (stmt.moduleSpecifier) sawStarExport = true;
+        continue;
+      }
+      if (ts.isNamespaceExport(stmt.exportClause)) {
+        if (identText(stmt.exportClause.name) === "site") unparseable = true;
+        continue;
+      }
+      if (!ts.isNamedExports(stmt.exportClause)) continue;
+      for (const spec of stmt.exportClause.elements) {
+        if (spec.isTypeOnly) continue;
+        if (identText(spec.name) !== "site") continue;
+        if (stmt.moduleSpecifier) {
+          unparseable = true;
+          continue;
+        }
+        const local = identText(spec.propertyName ?? spec.name);
+        if (!local) {
+          unparseable = true;
+          continue;
+        }
+        siteLocals.push(local);
+      }
+      continue;
+    }
