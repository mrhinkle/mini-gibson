+
+/**
+ * Value-position identifiers in a declaration. Property names, type
+ * positions, and labels are not runtime dependencies.
+ */
+function collectValueIdentifierReferences(node: ts.Node): Set<string> {
+  const names = new Set<string>();
+
+  const visit = (n: ts.Node, inType: boolean): void => {
+    if (inType) {
+      ts.forEachChild(n, (child) => visit(child, true));
+      return;
+    }
+    if (
+      ts.isTypeNode(n) ||
+      ts.isTypeParameterDeclaration(n) ||
+      ts.isHeritageClause(n) ||
+      ts.isImportTypeNode(n)
+    ) {
+      ts.forEachChild(n, (child) => visit(child, true));
+      return;
+    }
+    if (
+      ts.isAsExpression(n) ||
+      ts.isTypeAssertionExpression(n) ||
+      ts.isSatisfiesExpression(n)
+    ) {
+      visit(n.expression, false);
+      visit(n.type, true);
+      return;
+    }
+    if (ts.isPropertyAccessExpression(n)) {
+      visit(n.expression, false);
+      return;
+    }
+    if (ts.isElementAccessExpression(n)) {
+      visit(n.expression, false);
+      visit(n.argumentExpression, false);
+      return;
+    }
+    if (ts.isQualifiedName(n) || ts.isMetaProperty(n)) {
+      return;
+    }
+    if (ts.isIdentifier(n)) {
+      names.add(n.text);
+      return;
+    }
+    ts.forEachChild(n, (child) => visit(child, false));
+  };
+
+  visit(node, false);
+  return names;
+}
+
+/**
+ * Transitive closure of module-level declarations reachable from
+ * exported roots. An unexported helper that an exported wrapper calls
+ * is unverified behaviour even when the wrapper's own text is identical.
+ * `site` is excluded — that object is diffed separately.
+ */
+function appendTransitiveRuntimeDeclarations(
+  parts: string[],
+  declsByName: Map<string, string[]>,
+  nodesByName: Map<string, ts.Node[]>,
+  roots: Iterable<string>,
+  extraRootNodes: readonly ts.Node[] = [],
+): void {
+  const visited = new Set<string>(["site"]);
+  const queue: string[] = [];
+  const enqueueRefs = (node: ts.Node) => {
+    for (const ref of collectValueIdentifierReferences(node)) {
+      if (visited.has(ref) || !declsByName.has(ref)) continue;
+      queue.push(ref);
+    }
+  };
+  for (const name of roots) {
+    if (name && !visited.has(name) && declsByName.has(name)) queue.push(name);
+  }
+  for (const node of extraRootNodes) enqueueRefs(node);
+  while (queue.length > 0) {
+    const name = queue.pop()!;
+    if (visited.has(name)) continue;
+    visited.add(name);
+    appendNamedRuntimeDeclarations(parts, declsByName, name);
+    const nodes = nodesByName.get(name);
+    if (!nodes) continue;
+    for (const node of nodes) enqueueRefs(node);
+  }
+}
+
+/**
+ * Module-level imports run at load even when they bind nothing.
+ * A side-effect `import "./tracker"` is not an export, so the
+ * export walk would skip it while the site object stays
+ * byte-identical — a false "no wording change". Type-only
+ * imports are erased and have no runtime effect.
+ */
+function isRuntimeImportStatement(stmt: ts.Statement): boolean {
+  if (ts.isImportDeclaration(stmt)) {
+    const clause = stmt.importClause;
+    if (!clause) return true;
+    return !clause.isTypeOnly;
+  }
+  if (ts.isImportEqualsDeclaration(stmt)) {
+    return !stmt.isTypeOnly;
+  }
+  return false;
+}
+
+function hasDeclareKeyword(node: ts.Node): boolean {
+  if (!ts.canHaveModifiers(node)) return false;
+  return Boolean(
+    ts.getModifiers(node)?.some((m) => m.kind === ts.SyntaxKind.DeclareKeyword),
+  );
+}
+
+/**
+ * Type-only and ambient top-level statements are erased. They do not
+ * run at module evaluation.
+ */
+function isErasedTopLevelStatement(stmt: ts.Statement): boolean {
+  if (ts.isTypeAliasDeclaration(stmt) || ts.isInterfaceDeclaration(stmt)) {
+    return true;
+  }
+  if (ts.isEmptyStatement(stmt)) return true;
+  if (hasDeclareKeyword(stmt)) return true;
+  // Type-only imports are erased. Runtime imports are handled
+  // before this helper runs; anything still matching here is not
+  // a load-time effect.
+  if (ts.isImportDeclaration(stmt) || ts.isImportEqualsDeclaration(stmt)) {
+    return !isRuntimeImportStatement(stmt);
+  }
+  return false;
+}
+
+/**
+ * True when the whole file is a JSON object/array. That form is the
+ * site copy itself (tryParseSiteSource JSON path). Fingerprinting
+ * the literal as "other runtime" would refuse every wording change.
+ */
+function sourceIsJsonSiteCopy(source: string): boolean {
+  const trimmed = source.trim();
+  if (!trimmed) return false;
+  try {
+    const json = JSON.parse(trimmed);
+    return json !== null && typeof json === "object";
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * The `site` object is AST-diffed separately. Including it here would
+ * refuse a wording-only publish because the object text changed.
+ */
+function isSiteOnlyVariableStatement(stmt: ts.Statement): boolean {
+  if (!ts.isVariableStatement(stmt)) return false;
+  const names: string[] = [];
+  for (const decl of stmt.declarationList.declarations) {
+    names.push(...collectBindingNames(decl.name));
+  }
+  return names.length > 0 && names.every((n) => n === "site");
+}
+
+/**
+ * Runtime surface other than the `site` object. The preview only diffs
+ * that object's data; a changed helper — including an unexported
+ * function an exported wrapper calls — a changed module-level import,
+ * or any other top-level statement that runs at module evaluation
