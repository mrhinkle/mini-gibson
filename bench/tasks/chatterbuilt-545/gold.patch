+function hasExportKeyword(node: ts.Node): boolean {
+  if (!ts.canHaveModifiers(node)) return false;
+  return Boolean(
+    ts.getModifiers(node)?.some((m) => m.kind === ts.SyntaxKind.ExportKeyword),
+  );
