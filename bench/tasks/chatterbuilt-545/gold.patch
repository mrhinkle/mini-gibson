+  // prototype; it is not an own property. Modeling it as own data
+  // fabricates wording changes that never appear at runtime.
+  if (objectLiteralHasProtoSetter(expr)) return { kind: "fail" };
+  return { kind: "object", text: source.slice(start, end), start, end };
