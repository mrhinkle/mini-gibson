+
+// ---------------------------------------------------------------------------
+// Site copy parse + field diff (fail closed — never invent values)
+// ---------------------------------------------------------------------------
+
+type Token =
+  | { kind: "lbrace" }
+  | { kind: "rbrace" }
+  | { kind: "lbracket" }
+  | { kind: "rbracket" }
+  | { kind: "colon" }
+  | { kind: "comma" }
+  | { kind: "string"; value: string }
+  | { kind: "number"; value: number }
+  | { kind: "ident"; value: string };
+
+/**
+ * Parse content/site.ts (or JSON) into a plain object. Returns null when the
+ * source is not a JSON-like object literal — never evals, never guesses.
+ */
+export function tryParseSiteSource(source: string): Record<string, unknown> | null {
+  const trimmed = source.trim();
+  if (!trimmed) return null;
+  try {
+    const json = JSON.parse(trimmed);
+    if (json && typeof json === "object" && !Array.isArray(json)) {
+      if (recordHasOwnProtoKey(json)) return null;
+      return asOwnRecord(json);
+    }
+  } catch {
+    // not JSON — try the site.ts object literal
+  }
+
+  const extracted = extractSiteObjectLiteral(source);
+  if (extracted === "fail" || extracted == null) return null;
+  const tokens = tokenizeObjectLiteral(extracted);
+  if (!tokens) return null;
+  const parsed = parseTokens(tokens);
+  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
+    return null;
+  }
+  return asOwnRecord(parsed);
+}
+
+/**
+ * Copy parsed data onto null-prototype objects with defineProperty so a
+ * copied `__proto__` key cannot become a prototype setter. Literal
+ * `__proto__:` in object-literal syntax is rejected before we get here
+ * (it is a prototype setter, not own data). Bracket assignment and
+ * JSON own keys named `__proto__` are also rejected — walking them as
+ * nested site copy fabricates wording changes that never win at
+ * runtime over a real own property of the same name.
+ */
+function asOwnRecord(value: object): Record<string, unknown> {
+  return asOwnData(value) as Record<string, unknown>;
+}
+
+/**
+ * True when any object in the tree has an own `__proto__` key. Used to
+ * fail closed on JSON that would otherwise be walked as site copy.
+ */
+function recordHasOwnProtoKey(
+  value: unknown,
+  seen: Set<object> = new Set(),
+): boolean {
+  if (!value || typeof value !== "object") return false;
+  if (seen.has(value)) return false;
+  seen.add(value);
+  if (Array.isArray(value)) {
+    return value.some((item) => recordHasOwnProtoKey(item, seen));
+  }
+  if (Object.getOwnPropertyNames(value).includes("__proto__")) return true;
+  return Object.getOwnPropertyNames(value).some((key) =>
+    recordHasOwnProtoKey(
+      (value as Record<string, unknown>)[key],
+      seen,
+    ),
+  );
+}
+
+function asOwnData(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map(asOwnData);
+  }
+  if (value && typeof value === "object") {
+    const obj = Object.create(null) as Record<string, unknown>;
+    for (const key of Object.getOwnPropertyNames(value)) {
+      setOwn(obj, key, asOwnData((value as Record<string, unknown>)[key]));
+    }
+    return obj;
+  }
+  return value;
+}
+
+function setOwn(
+  obj: Record<string, unknown>,
+  key: string,
+  value: unknown,
+): void {
+  Object.defineProperty(obj, key, {
+    value,
+    enumerable: true,
+    writable: true,
+    configurable: true,
+  });
+}
+
+function extractSiteObjectLiteral(source: string): string | null | "fail" {
+  const resolved = resolveExportedSiteObject(source);
+  if (resolved.kind === "fail") return "fail";
+  if (resolved.kind === "none") {
+    // JSON / object-literal tests have no export. A non-exported
+    // `const site =` is not the value the site imports.
+    const t = source.trim();
+    return t.startsWith("{") ? t : null;
+  }
+  return resolved.text;
+}
+
+type ResolvedSiteObject =
+  | { kind: "object"; text: string; start: number; end: number }
+  | { kind: "none" }
+  | { kind: "fail" };
+
+function parseSiteSourceFile(source: string): ts.SourceFile {
+  return ts.createSourceFile(
+    "content/site.ts",
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+    ts.ScriptKind.TS,
+  );
