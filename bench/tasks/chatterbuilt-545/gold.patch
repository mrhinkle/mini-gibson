+      if (raw[i + 2] === "{") {
+        const close = raw.indexOf("}", i + 3);
+        if (close < 0) return null;
+        const hex = raw.slice(i + 3, close);
+        if (!hex || hex.length > 6 || !/^[0-9a-fA-F]+$/.test(hex)) {
+          return null;
+        }
+        const code = Number.parseInt(hex, 16);
+        if (!Number.isInteger(code) || code > 0x10ffff) return null;
+        out += String.fromCodePoint(code);
+        i = close;
+        continue;
+      }
+      const code = parseExactHex(raw.slice(i + 2, i + 6), 4);
+      if (code == null) return null;
+      out += String.fromCharCode(code);
+      i += 5;
+      continue;
+    }
+
+    if (n === "0") {
+      const next = raw[i + 2];
+      if (next !== undefined && next >= "0" && next <= "7") return null;
+      out += "\0";
+      i += 1;
+      continue;
+    }
+
+    let decoded: string | undefined;
+    switch (n) {
+      case "b":
+        decoded = "\b";
+        break;
+      case "f":
+        decoded = "\f";
+        break;
+      case "n":
+        decoded = "\n";
+        break;
+      case "r":
+        decoded = "\r";
+        break;
+      case "t":
+        decoded = "\t";
+        break;
+      case "v":
+        decoded = "\v";
+        break;
+      case "'":
+      case '"':
+      case "\\":
+        decoded = n;
+        break;
+      default:
+        decoded = undefined;
+    }
+    if (decoded == null) return null;
+    out += decoded;
+    i += 1;
+  }
+  return out;
+}
+
+type ParseResult =
+  | { ok: true; value: unknown }
+  | { ok: false };
+
+function parseTokens(tokens: Token[]): unknown | null {
+  let i = 0;
+  function peek(): Token | undefined {
+    return tokens[i];
+  }
+  function eat(): Token | undefined {
+    return tokens[i++];
+  }
+
+  function parseValue(): ParseResult {
+    const t = peek();
+    if (!t) return { ok: false };
+    if (t.kind === "lbrace") return parseObject();
+    if (t.kind === "lbracket") return parseArray();
+    if (t.kind === "string") {
+      eat();
+      return { ok: true, value: t.value };
+    }
+    if (t.kind === "number") {
+      eat();
+      return { ok: true, value: t.value };
+    }
+    if (t.kind === "ident") {
+      eat();
+      if (t.value === "true") return { ok: true, value: true };
+      if (t.value === "false") return { ok: true, value: false };
+      if (t.value === "null") return { ok: true, value: null };
+      return { ok: false };
+    }
+    return { ok: false };
+  }
+
+  function parseObject(): ParseResult {
+    if (eat()?.kind !== "lbrace") return { ok: false };
+    const obj = Object.create(null) as Record<string, unknown>;
+    if (peek()?.kind === "rbrace") {
+      eat();
+      return { ok: true, value: obj };
+    }
+    while (i < tokens.length) {
+      const keyTok = eat();
+      if (!keyTok) return { ok: false };
+      let key: string;
+      if (keyTok.kind === "string" || keyTok.kind === "ident") {
+        key = keyTok.value;
+      } else if (keyTok.kind === "rbrace") {
+        return { ok: true, value: obj };
+      } else {
+        return { ok: false };
+      }
+      if (eat()?.kind !== "colon") return { ok: false };
+      const parsed = parseValue();
+      if (!parsed.ok) return { ok: false };
+      // Object-literal `__proto__:` is a prototype setter, not an own
+      // property. Do not model it as data — that fabricates a change.
+      if (key === "__proto__") return { ok: false };
+      setOwn(obj, key, parsed.value);
+      const sep = peek();
+      if (sep?.kind === "comma") {
+        eat();
+        if (peek()?.kind === "rbrace") {
+          eat();
+          return { ok: true, value: obj };
+        }
+        continue;
+      }
+      if (sep?.kind === "rbrace") {
+        eat();
+        return { ok: true, value: obj };
+      }
+      return { ok: false };
+    }
+    return { ok: false };
+  }
+
+  function parseArray(): ParseResult {
+    if (eat()?.kind !== "lbracket") return { ok: false };
+    const arr: unknown[] = [];
+    if (peek()?.kind === "rbracket") {
+      eat();
+      return { ok: true, value: arr };
+    }
+    while (i < tokens.length) {
+      const parsed = parseValue();
+      if (!parsed.ok) return { ok: false };
+      arr.push(parsed.value);
+      const sep = peek();
+      if (sep?.kind === "comma") {
+        eat();
+        if (peek()?.kind === "rbracket") {
+          eat();
+          return { ok: true, value: arr };
+        }
+        continue;
+      }
+      if (sep?.kind === "rbracket") {
+        eat();
+        return { ok: true, value: arr };
+      }
+      return { ok: false };
+    }
+    return { ok: false };
+  }
+
+  const parsed = parseValue();
+  if (!parsed.ok || i !== tokens.length) return null;
+  return parsed.value;
+}
+
+/**
+ * One step of a flatten path. Object keys and array identities are
+ * different kinds, so a literal key `services[plumbing]` can never
+ * collide with an array item whose slug is `plumbing` — Map lookup
+ * uses JSON.stringify of this tagged list, not a joined string.
+ */
+type EmptyContainerShape = "null" | "array" | "object";
+
+type PathSegment =
+  | { kind: "object-key"; name: string }
+  | { kind: "array-item-id"; id: string }
+  | { kind: "array-item-value"; id: string }
+  | { kind: "array-item-index"; index: number }
+  | { kind: "array-equal"; seq: number }
+  | { kind: "array-pair"; seq: number }
+  | { kind: "array-before"; seq: number }
+  | { kind: "array-after"; seq: number }
+  | { kind: "array-items" }
+  | { kind: "array-order" }
+  /**
+   * Presence of a null / empty array / empty object at this path.
+   * Leaf flattening used to skip these, so `{ services: [] }` vs `{}`
+   * produced zero entries and looked fully reviewed.
+   */
+  | { kind: "empty-container"; shape: EmptyContainerShape };
+
+type FlatEntry = {
+  path: PathSegment[];
+  value: string;
+  serviceName?: string;
+  /**
+   * Verified scalar change that must not be shown as a named wording
+   * pair — used when an array reordered but items cannot be named.
+   */
+  unnamed?: boolean;
+};
+
+function pathMapKey(path: PathSegment[]): string {
+  return JSON.stringify(
+    path.map((seg) => {
+      switch (seg.kind) {
+        case "object-key":
+          return ["k", seg.name];
+        case "array-item-id":
+          return ["a", seg.id];
+        case "array-item-value":
+          return ["v", seg.id];
+        case "array-item-index":
+          return ["i", seg.index];
+        case "array-equal":
+          return ["eq", seg.seq];
+        case "array-pair":
+          return ["p", seg.seq];
+        case "array-before":
+          return ["b", seg.seq];
+        case "array-after":
+          return ["af", seg.seq];
+        case "array-items":
+          return ["items"];
+        case "array-order":
+          return ["order"];
+        case "empty-container":
+          return ["empty", seg.shape];
+      }
+    }),
+  );
+}
+
+function appendPath(path: PathSegment[], seg: PathSegment): PathSegment[] {
+  return [...path, seg];
+}
+
+function segmentKey(seg: PathSegment): string {
+  return pathMapKey([seg]);
+}
+
+/**
+ * Object-key names only. Array identities are never keys — a slug like
+ * `x].hours[` must not participate in hours/services labeling.
+ */
+function objectKeyNames(path: PathSegment[]): string[] {
+  const keys: string[] = [];
+  for (const seg of path) {
+    if (seg.kind === "object-key") keys.push(seg.name);
+  }
+  return keys;
+}
+
+/**
+ * Flatten an array of objects. Prefer a unique slug/name so a reorder is
+ * not reported as every item changing. Always fall back to the index —
+ * never reuse the parent path, which collapses FAQ/process items onto
+ * one before/after and fabricates (or hides) the change.
+ */
+function flattenNamedObjectArray(
+  value: unknown[],
+  path: PathSegment[],
+  out: FlatEntry[],
+  serviceName?: string,
+): void {
+  const ids = value.map((item) => namedItemId(item));
+  const counts = new Map<string, number>();
+  for (const id of ids) {
+    if (!id) continue;
+    counts.set(id, (counts.get(id) ?? 0) + 1);
+  }
+  value.forEach((item, idx) => {
+    const rec = item as Record<string, unknown>;
+    const id = ids[idx] ?? "";
+    const childName =
+      typeof rec.name === "string" ? rec.name : serviceName;
+    const unique = Boolean(id && counts.get(id) === 1);
+    const childPath = unique
+      ? appendPath(path, { kind: "array-item-id", id })
+      : appendPath(path, { kind: "array-item-index", index: idx });
+    flattenStrings(rec, childPath, out, childName);
+  });
+}
+
+/**
+ * Match primitive list items by value when the value is unique, so
+ * removing the first service is not reported as changing it into the
+ * second and then removing the second.
+ */
+function flattenPrimitiveArray(
+  value: unknown[],
+  path: PathSegment[],
+  out: FlatEntry[],
+  serviceName?: string,
+): void {
+  const ids = value.map((item) => JSON.stringify(item));
+  const counts = new Map<string, number>();
+  for (const id of ids) {
+    counts.set(id, (counts.get(id) ?? 0) + 1);
+  }
+  value.forEach((item, idx) => {
+    const id = ids[idx] ?? "";
+    const unique = Boolean(id && counts.get(id) === 1);
+    const childPath = unique
+      ? appendPath(path, { kind: "array-item-value", id })
+      : appendPath(path, { kind: "array-item-index", index: idx });
+    flattenStrings(item, childPath, out, serviceName);
+  });
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return Boolean(value && typeof value === "object" && !Array.isArray(value));
+}
+
+function isNamedObjectArray(value: unknown): value is unknown[] {
+  return (
+    Array.isArray(value) &&
+    value.length > 0 &&
+    value.every(
+      (item) => item && typeof item === "object" && !Array.isArray(item),
+    )
+  );
+}
+
+function isPrimitiveArray(value: unknown): value is unknown[] {
+  return (
+    Array.isArray(value) &&
+    value.length > 0 &&
+    value.every(
+      (item) =>
+        typeof item === "string" ||
+        (typeof item === "number" && Number.isFinite(item)) ||
+        typeof item === "boolean",
+    )
+  );
+}
+
+function namedItemId(item: unknown): string {
+  if (!isPlainObject(item)) return "";
+  for (const key of ["slug", "name", "title", "question"] as const) {
+    const raw = item[key];
+    if (typeof raw === "string" && raw) return raw;
+  }
+  return "";
+}
+
+function countIds(ids: string[]): Map<string, number> {
+  const counts = new Map<string, number>();
+  for (const id of ids) {
+    if (!id) continue;
+    counts.set(id, (counts.get(id) ?? 0) + 1);
+  }
+  return counts;
+}
+
+/**
+ * Identities that are stable across both versions. Computing uniqueness
+ * independently is how deleting one duplicate service fabricates a
+ * remove+add of the unchanged duplicate (indexed path on one side,
+ * named path on the other).
+ */
+function assignPairedArrayKeys(
+  before: unknown[],
+  after: unknown[],
+  idOf: (item: unknown) => string,
+  uniqueSeg: (id: string) => PathSegment,
+  allowUniqueLeftover: boolean,
+): {
+  beforeKeys: Array<PathSegment | null>;
+  afterKeys: Array<PathSegment | null>;
+  ambiguousUnmatched: boolean;
+} {
+  const beforeKeys: Array<PathSegment | null> = before.map(() => null);
+  const afterKeys: Array<PathSegment | null> = after.map(() => null);
+  const beforeIds = before.map(idOf);
+  const afterIds = after.map(idOf);
+  const beforeCounts = countIds(beforeIds);
+  const afterCounts = countIds(afterIds);
+
+  for (let i = 0; i < before.length; i++) {
+    const id = beforeIds[i];
+    if (!id) continue;
+    if (beforeCounts.get(id) !== 1 || afterCounts.get(id) !== 1) continue;
+    const j = afterIds.indexOf(id);
+    if (j < 0 || afterKeys[j]) continue;
+    const key = uniqueSeg(id);
+    beforeKeys[i] = key;
+    afterKeys[j] = key;
+  }
+
+  let seq = 0;
+  for (let i = 0; i < before.length; i++) {
+    if (beforeKeys[i]) continue;
+    const sig = JSON.stringify(before[i]);
+    for (let j = 0; j < after.length; j++) {
+      if (afterKeys[j]) continue;
+      if (JSON.stringify(after[j]) === sig) {
+        seq += 1;
+        const key: PathSegment = { kind: "array-equal", seq };
+        beforeKeys[i] = key;
+        afterKeys[j] = key;
+        break;
+      }
+    }
+  }
+
+  const beforeRest: number[] = [];
+  const afterRest: number[] = [];
+  for (let i = 0; i < before.length; i++) {
+    if (!beforeKeys[i]) beforeRest.push(i);
+  }
+  for (let j = 0; j < after.length; j++) {
+    if (!afterKeys[j]) afterRest.push(j);
+  }
+
+  const uniqueLeftover =
+    allowUniqueLeftover &&
+    beforeRest.length === 1 &&
+    afterRest.length === 1;
+  if (uniqueLeftover) {
+    seq += 1;
+    const key: PathSegment = { kind: "array-pair", seq };
+    beforeKeys[beforeRest[0]!] = key;
+    afterKeys[afterRest[0]!] = key;
+    return { beforeKeys, afterKeys, ambiguousUnmatched: false };
+  }
+
+  // Named leftovers on both sides cannot be uniquely paired — pairing
+  // by position fabricates "Q1 → edited Q2" after a reorder. Primitive
+  // leftovers, and named pure add/remove, are not a correspondence.
+  if (
+    allowUniqueLeftover &&
+    beforeRest.length > 0 &&
+    afterRest.length > 0
+  ) {
+    return { beforeKeys, afterKeys, ambiguousUnmatched: true };
+  }
+
+  for (const i of beforeRest) {
+    seq += 1;
+    beforeKeys[i] = { kind: "array-before", seq };
+  }
+  for (const j of afterRest) {
+    seq += 1;
+    afterKeys[j] = { kind: "array-after", seq };
+  }
+  return { beforeKeys, afterKeys, ambiguousUnmatched: false };
+}
+
+/**
+ * Shared items in a different sequence is a real change. Pairing by
+ * identity hides it — the owner still sees a different service order.
+ */
+function sharedKeyOrderChanged(
+  beforeKeys: Array<PathSegment | null>,
+  afterKeys: Array<PathSegment | null>,
+): boolean {
+  const before = beforeKeys
+    .filter((k): k is PathSegment => Boolean(k))
+    .map(segmentKey);
+  const after = afterKeys
+    .filter((k): k is PathSegment => Boolean(k))
+    .map(segmentKey);
+  const afterSet = new Set(after);
+  const beforeShared = before.filter((k) => afterSet.has(k));
+  if (beforeShared.length < 2) return false;
+  const beforeSet = new Set(before);
+  const afterShared = after.filter((k) => beforeSet.has(k));
+  return beforeShared.some((k, i) => k !== afterShared[i]);
+}
+
+function arrayItemOwnerLabel(item: unknown): string | null {
+  if (typeof item === "string") {
+    const t = flattenOwnerWhitespace(item);
+    return t.length > 0 ? t : null;
+  }
+  if (typeof item === "number" && Number.isFinite(item)) {
+    return String(item);
+  }
+  if (typeof item === "boolean") {
+    return item ? "true" : "false";
+  }
+  if (!isPlainObject(item)) return null;
+  for (const key of ["name", "slug", "title", "question"] as const) {
+    const raw = item[key];
+    if (typeof raw !== "string") continue;
+    const t = flattenOwnerWhitespace(raw);
+    if (t) return t;
+  }
+  return null;
+}
+
+function flattenPairedArrays(
+  before: unknown[],
+  after: unknown[],
+  path: PathSegment[],
+  beforeOut: FlatEntry[],
+  afterOut: FlatEntry[],
+  serviceName: string | undefined,
+  kind: "named" | "primitive",
+): void {
+  const idOf =
+    kind === "named" ? namedItemId : (item: unknown) => JSON.stringify(item);
+  const uniqueSeg =
+    kind === "named"
+      ? (id: string): PathSegment => ({ kind: "array-item-id", id })
+      : (id: string): PathSegment => ({ kind: "array-item-value", id });
+  const { beforeKeys, afterKeys, ambiguousUnmatched } = assignPairedArrayKeys(
+    before,
+    after,
+    idOf,
+    uniqueSeg,
+    kind === "named",
+  );
+  const beforeByKey = new Map<string, unknown>();
+  const afterByKey = new Map<string, unknown>();
+  const segByKey = new Map<string, PathSegment>();
+  before.forEach((item, i) => {
+    const key = beforeKeys[i];
+    if (!key) return;
+    const mapKey = segmentKey(key);
+    beforeByKey.set(mapKey, item);
+    segByKey.set(mapKey, key);
+  });
+  after.forEach((item, j) => {
+    const key = afterKeys[j];
+    if (!key) return;
+    const mapKey = segmentKey(key);
+    afterByKey.set(mapKey, item);
+    segByKey.set(mapKey, key);
+  });
+  const keys = new Set([...beforeByKey.keys(), ...afterByKey.keys()]);
+  for (const mapKey of keys) {
+    const b = beforeByKey.get(mapKey);
+    const a = afterByKey.get(mapKey);
+    const seg = segByKey.get(mapKey);
+    if (!seg) continue;
+    const childPath = appendPath(path, seg);
+    const rec = (isPlainObject(a) ? a : isPlainObject(b) ? b : null);
+    const childName =
+      kind === "named" && rec && typeof rec.name === "string"
+        ? rec.name
+        : serviceName;
+    if (b !== undefined && a !== undefined) {
+      flattenPaired(b, a, childPath, beforeOut, afterOut, childName);
+    } else if (b !== undefined) {
+      flattenStrings(b, childPath, beforeOut, childName);
+    } else if (a !== undefined) {
+      flattenStrings(a, childPath, afterOut, childName);
+    }
+  }
+
+  if (ambiguousUnmatched) {
+    const itemsPath = appendPath(path, { kind: "array-items" });
+    beforeOut.push({
+      path: itemsPath,
+      value: "0",
+      serviceName,
+      unnamed: true,
+    });
+    afterOut.push({
+      path: itemsPath,
+      value: "1",
+      serviceName,
+      unnamed: true,
+    });
+  }
+
+  if (!sharedKeyOrderChanged(beforeKeys, afterKeys)) return;
+  const beforeLabels = before.map(arrayItemOwnerLabel);
+  const afterLabels = after.map(arrayItemOwnerLabel);
+  const orderPath = appendPath(path, { kind: "array-order" });
+  if (beforeLabels.every(Boolean) && afterLabels.every(Boolean)) {
+    beforeOut.push({
+      path: orderPath,
+      value: beforeLabels.join(", "),
+      serviceName,
+    });
+    afterOut.push({
+      path: orderPath,
+      value: afterLabels.join(", "),
+      serviceName,
+    });
+    return;
+  }
+  // Order changed, but we cannot name every item. Count it as an
+  // unnamed verified change so a named scalar cannot hide it.
+  beforeOut.push({
+    path: orderPath,
+    value: "0",
+    serviceName,
+    unnamed: true,
+  });
+  afterOut.push({
+    path: orderPath,
+    value: "1",
+    serviceName,
+    unnamed: true,
+  });
+}
+
+function flattenPaired(
+  before: unknown,
+  after: unknown,
+  path: PathSegment[],
+  beforeOut: FlatEntry[],
+  afterOut: FlatEntry[],
+  serviceName?: string,
+): void {
+  const beforeNamed = isNamedObjectArray(before);
+  const afterNamed = isNamedObjectArray(after);
+  if (
+    (beforeNamed || (afterNamed && Array.isArray(before) && before.length === 0)) &&
+    (afterNamed || (beforeNamed && Array.isArray(after) && after.length === 0))
+  ) {
+    flattenPairedArrays(
+      before as unknown[],
+      after as unknown[],
+      path,
+      beforeOut,
+      afterOut,
+      serviceName,
+      "named",
+    );
+    return;
+  }
+
+  const beforePrim = isPrimitiveArray(before);
+  const afterPrim = isPrimitiveArray(after);
+  if (
+    (beforePrim || (afterPrim && Array.isArray(before) && before.length === 0)) &&
+    (afterPrim || (beforePrim && Array.isArray(after) && after.length === 0))
+  ) {
+    flattenPairedArrays(
+      before as unknown[],
+      after as unknown[],
+      path,
+      beforeOut,
+      afterOut,
+      serviceName,
+      "primitive",
+    );
+    return;
+  }
+
+  if (isPlainObject(before) && isPlainObject(after)) {
+    const keySet = new Set([...Object.keys(before), ...Object.keys(after)]);
+    for (const k of keySet) {
+      const next = appendPath(path, { kind: "object-key", name: k });
+      const hasB = Object.prototype.hasOwnProperty.call(before, k);
+      const hasA = Object.prototype.hasOwnProperty.call(after, k);
+      if (hasB && hasA) {
+        flattenPaired(
+          before[k],
+          after[k],
+          next,
+          beforeOut,
+          afterOut,
+          serviceName,
+        );
+      } else if (hasB) {
+        flattenStrings(before[k], next, beforeOut, serviceName);
+      } else {
+        flattenStrings(after[k], next, afterOut, serviceName);
+      }
+    }
+    return;
+  }
+
+  flattenStrings(before, path, beforeOut, serviceName);
+  flattenStrings(after, path, afterOut, serviceName);
+}
+
+function pushEmptyContainer(
+  path: PathSegment[],
+  out: FlatEntry[],
+  shape: EmptyContainerShape,
+  serviceName?: string,
+): void {
+  out.push({
+    path: appendPath(path, { kind: "empty-container", shape }),
+    value: shape,
+    serviceName,
+    unnamed: true,
+  });
+}
+
+function flattenStrings(
+  value: unknown,
+  path: PathSegment[],
+  out: FlatEntry[],
+  serviceName?: string,
+): void {
+  if (typeof value === "string") {
+    out.push({ path, value, serviceName });
+    return;
+  }
+  if (typeof value === "number" && Number.isFinite(value)) {
+    out.push({ path, value: String(value), serviceName });
+    return;
+  }
+  if (typeof value === "boolean") {
+    out.push({ path, value: value ? "true" : "false", serviceName });
+    return;
+  }
+  if (value === null) {
+    pushEmptyContainer(path, out, "null", serviceName);
+    return;
+  }
+  if (Array.isArray(value)) {
+    if (value.length === 0) {
+      pushEmptyContainer(path, out, "array", serviceName);
+      return;
+    }
+    const named = value.every(
+      (item) => item && typeof item === "object" && !Array.isArray(item),
+    );
+    if (named) {
+      flattenNamedObjectArray(value, path, out, serviceName);
+      return;
+    }
+    const primitive = value.every(
+      (item) =>
+        typeof item === "string" ||
+        (typeof item === "number" && Number.isFinite(item)) ||
+        typeof item === "boolean",
+    );
+    if (primitive) {
+      flattenPrimitiveArray(value, path, out, serviceName);
+      return;
+    }
+    value.forEach((item, idx) => {
+      flattenStrings(
+        item,
+        appendPath(path, { kind: "array-item-index", index: idx }),
+        out,
+        serviceName,
+      );
+    });
+    return;
+  }
+  if (value && typeof value === "object") {
+    const entries = Object.entries(value as Record<string, unknown>);
+    if (entries.length === 0) {
+      pushEmptyContainer(path, out, "object", serviceName);
+      return;
+    }
+    for (const [k, v] of entries) {
+      flattenStrings(
+        v,
+        appendPath(path, { kind: "object-key", name: k }),
+        out,
+        serviceName,
+      );
+    }
+  }
+}
+
+export function visualPairsFromSiteSources(
+  beforeSrc: string,
+  afterSrc: string,
+): VisualPair[] {
+  return diffSiteCopy(beforeSrc, afterSrc).pairs;
+}
+
+/**
+ * Diff two site.ts sources. `pairs` are labeled wording changes.
+ * `unnamedCount` is every other verified scalar change (unknown string
+ * fields, booleans, numbers) — callers must not drop those surfaces.
+ */
+export function diffSiteCopy(
+  beforeSrc: string,
+  afterSrc: string,
+): { pairs: VisualPair[]; unnamedCount: number } {
+  const before = tryParseSiteSource(beforeSrc);
+  const after = tryParseSiteSource(afterSrc);
+  if (!before || !after) return { pairs: [], unnamedCount: 0 };
+
+  const beforeFlat: FlatEntry[] = [];
+  const afterFlat: FlatEntry[] = [];
+  flattenPaired(before, after, [], beforeFlat, afterFlat);
+
+  const beforeMap = new Map(beforeFlat.map((e) => [pathMapKey(e.path), e]));
+  const afterMap = new Map(afterFlat.map((e) => [pathMapKey(e.path), e]));
+  const keys = new Set([...beforeMap.keys(), ...afterMap.keys()]);
+
+  const pairs: VisualPair[] = [];
+  let unnamedCount = 0;
+  for (const key of keys) {
+    const b = beforeMap.get(key);
+    const a = afterMap.get(key);
+    if ((b?.value ?? null) === (a?.value ?? null)) continue;
+    if (b?.unnamed || a?.unnamed) {
+      unnamedCount += 1;
+      continue;
+    }
+    const label = labelForSiteObjectKeys(objectKeyNames((a ?? b)!.path), {
+      serviceName: a?.serviceName ?? b?.serviceName,
+    });
+    if (!label) {
+      unnamedCount += 1;
+      continue;
+    }
+    const clipped = clipChangedValues(
+      b ? b.value : null,
+      a ? a.value : null,
+    );
+    if (
+      clipped.before != null &&
+      clipped.after != null &&
+      clipped.before === clipped.after
+    ) {
+      // Truncation hid the only difference — do not show a fake no-op,
+      // and do not count it as "no change" either.
+      unnamedCount += 1;
+      continue;
+    }
+    pairs.push({
+      label,
+      before: clipped.before,
+      after: clipped.after,
+    });
+  }
+  return { pairs: dedupePairs(pairs), unnamedCount };
+}
+
+function clipValue(value: string): string {
+  const t = value.trim();
+  if (t.length <= MAX_VALUE_CHARS) return t;
+  return `${t.slice(0, MAX_VALUE_CHARS)}…`;
+}
+
+/**
+ * Clip before/after around the first actual difference so a long shared
+ * prefix cannot hide the changed text. Independent head-truncation of each
+ * side is how two 200-character-identical prefixes become a fake no-op.
+ */
+export function clipChangedValues(
+  before: string | null,
+  after: string | null,
+): { before: string | null; after: string | null } {
+  if (before == null && after == null) {
+    return { before: null, after: null };
+  }
+  // Empty string is a real value. Truthiness would turn absent→"" into
+  // {null,null}, which the formatter then shows as both missing and removed.
+  if (before == null) {
+    return { before: null, after: after == null ? null : clipValue(after) };
+  }
+  if (after == null) {
+    return { before: clipValue(before), after: null };
+  }
+  const b = before.trim();
+  const a = after.trim();
+  if (b.length <= MAX_VALUE_CHARS && a.length <= MAX_VALUE_CHARS) {
+    return { before: b, after: a };
+  }
+
+  let diff = 0;
+  const min = Math.min(b.length, a.length);
+  while (diff < min && b[diff] === a[diff]) diff++;
+
+  const context = 32;
+  const start = Math.max(0, diff - context);
+
+  function windowOf(s: string): string {
+    const slice = s.slice(start, start + MAX_VALUE_CHARS);
+    const prefix = start > 0 ? "…" : "";
+    const suffix = start + MAX_VALUE_CHARS < s.length ? "…" : "";
+    return `${prefix}${slice}${suffix}`;
+  }
+
+  return { before: windowOf(b), after: windowOf(a) };
+}
+
+function dedupePairs(pairs: VisualPair[]): VisualPair[] {
+  const seen = new Set<string>();
+  const out: VisualPair[] = [];
+  for (const p of pairs) {
+    // JSON so null (absent) and "" (blank) stay distinct identities.
+    const id = JSON.stringify([p.label, p.before, p.after]);
+    if (seen.has(id)) continue;
+    seen.add(id);
+    out.push(p);
+  }
+  return out;
+}
+
+/**
+ * Last-resort visual from a unified diff patch. Only emits pairs whose
+ * before/after strings were actually present on -/+ lines.
+ */
+const PATCH_BLOCK_KEY =
+  /^(hours|services|hero|faq|contact|nav|process|gallery|scheduleSection|contactSection|reviews|trustBar)$/;
+
+function patchLineBody(line: string): string {
+  if (line.startsWith("+") || line.startsWith("-") || line.startsWith(" ")) {
+    return line.slice(1);
+  }
+  return line;
+}
+
+/**
+ * Close an already-open template literal starting at `from` (inside
+ * the template, not at the opening backtick). Escaped backticks do
+ * not close. Returns -1 when the close is not on this line.
+ */
+function findTemplateClose(source: string, from: number): number {
+  let i = from;
+  while (i < source.length) {
+    const c = source[i];
+    if (c === "\\") {
+      i += 2;
+      continue;
+    }
+    if (c === "`") return i;
+    i += 1;
+  }
+  return -1;
+}
+
+type PatchLineScan = {
+  code: string;
+  inBlockComment: boolean;
+  inTemplate: boolean;
+};
+
+/**
+ * Non-comment, non-template code on one patch line, carrying `/*`
+ * and backtick state across lines the same way `skipNonCode` does
+ * for the site.ts parser. Template text is not site copy.
+ */
+function takePatchLineCode(
+  body: string,
+  inBlockComment: boolean,
+  inTemplate: boolean,
+): PatchLineScan {
+  let i = 0;
+  let code = "";
+  let prev: SlashContext = "start";
+  const scan = freshSlashScan();
+  if (inTemplate) {
+    const close = findTemplateClose(body, 0);
+    if (close < 0) {
+      return { code: "", inBlockComment: false, inTemplate: true };
+    }
+    i = close + 1;
+    prev = "value";
+    inTemplate = false;
+  }
+  if (inBlockComment) {
+    const end = body.indexOf("*/");
+    if (end < 0) {
+      return { code: "", inBlockComment: true, inTemplate: false };
+    }
+    i = end + 2;
+  }
+  while (i < body.length) {
+    const skipped = skipNonCode(body, i, prev);
+    if (skipped < 0) {
+      // Ambiguous or unclosed `/` — do not guess at values on this line.
+      return { code: "", inBlockComment: false, inTemplate: false };
+    }
+    if (skipped !== i) {
+      const c = body[i];
+      const next = body[i + 1];
+      if (c === "`") {
+        const closed = skipTemplate(body, i);
+        if (closed < 0) {
+          return { code, inBlockComment: false, inTemplate: true };
+        }
+        prev = "value";
+        scan.lastWord = "";
+        i = skipped;
+        continue;
+      }
+      if (c === "/" && next === "*") {
+        const closed = body.indexOf("*/", i + 2);
+        if (closed < 0) {
+          return { code, inBlockComment: true, inTemplate: false };
+        }
+        i = skipped;
+        continue;
+      }
+      if (c === "/" && next === "/") {
+        break;
+      }
+      if (c === "/" && next !== "/" && next !== "*") {
+        // Regex literal — not site copy. Do not keep the body.
+        prev = "value";
+        scan.lastWord = "";
+        i = skipped;
+        continue;
+      }
+      // Quoted string — keep it; `/*` inside a string is not a comment.
+      code += body.slice(i, skipped);
+      prev = "value";
+      scan.lastWord = "";
+      i = skipped;
+      continue;
+    }
+    code += body[i]!;
+    prev = prevAfterConsuming(body, i, prev, scan);
+    i += 1;
+  }
+  return { code, inBlockComment: false, inTemplate: false };
+}
+
+function codeIndent(code: string): number {
+  const m = /^(\s*)/.exec(code);
+  return m ? m[1].length : 0;
+}
+
+/** Nesting delta of `{` `[` `}` `]` outside strings. */
+function nestDelta(code: string): number {
+  let delta = 0;
+  let i = 0;
+  while (i < code.length) {
+    const c = code[i];
+    if (c === '"' || c === "'") {
+      const closed = skipString(code, i);
+      if (closed < 0) return delta;
+      i = closed + 1;
+      continue;
+    }
+    if (c === "{" || c === "[") delta++;
+    else if (c === "}" || c === "]") delta--;
+    i++;
+  }
+  return delta;
+}
+
+function patchPropertyKey(code: string): string | null {
+  const m = /^\s*([A-Za-z_$][\w$]*)\s*:/.exec(code);
+  return m?.[1] ?? null;
+}
+
+type PatchSideState = {
+  lastBlock: string | undefined;
+  lastBlockIndent: number;
+  lastBlockOpenedAt: number;
+  nestDepth: number;
+  lastServiceName: string | undefined;
+  inBlockComment: boolean;
+  inTemplate: boolean;
+};
+
+function freshPatchSide(): PatchSideState {
+  return {
+    lastBlock: undefined,
+    lastBlockIndent: 0,
+    lastBlockOpenedAt: 0,
+    nestDepth: 0,
+    lastServiceName: undefined,
+    inBlockComment: false,
+    inTemplate: false,
+  };
+}
+
+function clonePatchSide(state: PatchSideState): PatchSideState {
+  return { ...state };
+}
+
+function applyPatchStructure(state: PatchSideState, code: string): void {
+  // A new object in the same hunk is a new service (or hours block).
+  // Carrying plumbing's name into the next `{` is how a heater
+  // description gets labeled as plumbing.
+  if (/^\s*\{/.test(code)) {
+    state.lastServiceName = undefined;
+  }
+
+  const indent = codeIndent(code);
+  const propKey = patchPropertyKey(code);
+  if (propKey && PATCH_BLOCK_KEY.test(propKey)) {
+    state.lastBlock = propKey;
+    state.lastBlockIndent = indent;
+    state.lastBlockOpenedAt = state.nestDepth;
+    if (state.lastBlock !== "services") state.lastServiceName = undefined;
+  } else if (
+    state.lastBlock !== undefined &&
+    propKey &&
+    indent <= state.lastBlockIndent
+  ) {
+    // Sibling/top-level key — not a child of the remembered block.
+    state.lastBlock = undefined;
+    state.lastServiceName = undefined;
+  }
+
+  state.nestDepth += nestDelta(code);
+  if (
+    state.lastBlock !== undefined &&
+    state.nestDepth <= state.lastBlockOpenedAt
+  ) {
+    state.lastBlock = undefined;
+    state.lastServiceName = undefined;
+  }
+
+  const nameMatch = /^\s*name\s*:\s*(["'])((?:\\.|(?!\1).)*)\1/.exec(code);
+  if (nameMatch?.[2]) {
+    state.lastServiceName = nameMatch[2];
+  }
+}
+
+function fieldPathFor(state: PatchSideState, key: string): string {
+  return state.lastBlock ? `${state.lastBlock}.${key}` : key;
+}
+
+/**
+ * Identity used to decide whether a -/+ pair is the same field.
+ * Same key name is not enough — `scheduleSection.title` is not
+ * `contactSection.title`. A service `name` change is the identity
+ * itself, so it pairs on path alone.
+ */
+function semanticFieldId(state: PatchSideState, key: string): string {
+  const fieldPath = fieldPathFor(state, key);
+  if (key === "name") return fieldPath;
+  if (state.lastServiceName) return `${fieldPath}::${state.lastServiceName}`;
+  return fieldPath;
+}
+
+function lineInRange(
+  line: number,
+  range: { startLine: number; endLine: number },
+): boolean {
+  return line >= range.startLine && line <= range.endLine;
+}
+
+/**
+ * Last-resort visual from a unified diff. Requires BOTH complete file
+ * versions so the AST can place the exported `site` object on each
+ * side independently: a - line must fall inside the old export, a +
+ * line inside the new export. One side's range cannot authenticate
+ * the other half of a pair — that is how a helper object's removed
+ * wording is reported as the prior site copy. No source, no export,
+ * or no hunk header → no pairs. Key-name matching alone is not
+ * verification.
+ */
+export function visualPairsFromPatch(
+  patch: string,
+  afterSource?: string | null,
+  beforeSource?: string | null,
+): VisualPair[] {
+  if (afterSource == null || afterSource === "") return [];
+  if (beforeSource == null || beforeSource === "") return [];
+  const afterRange = exportedSiteObjectLineRange(afterSource);
+  const beforeRange = exportedSiteObjectLineRange(beforeSource);
+  if (!afterRange || !beforeRange) return [];
+
+  const lines = patch.split(/\r?\n/);
+  const pairs: VisualPair[] = [];
+  // Old and new sides of a unified diff are separate files. Sharing
+  // lastBlock / nestDepth / lastServiceName lets a removed block name
+  // the added block's values, or a removed `*/` "uncomment" added lines.
+  let oldSide = freshPatchSide();
+  let newSide = freshPatchSide();
+  let oldLine = 0;
+  let newLine = 0;
+  let hunkActive = false;
+
+  const keyLine = /^\s*([A-Za-z_$][\w$]*)\s*:\s*(["'])([\s\S]*)$/;
+
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i]!;
+    // A new hunk is a new context. Carrying a previous service name across
+    // @@ headers is how a later unnamed change gets labeled as plumbing.
+    if (/^@@ /.test(line)) {
+      oldSide = freshPatchSide();
+      newSide = freshPatchSide();
+      const hunk = parsePatchHunkHeader(line);
+      if (!hunk || hunk.oldStart < 1 || hunk.newStart < 1) {
+        hunkActive = false;
+        continue;
+      }
+      oldLine = hunk.oldStart;
+      newLine = hunk.newStart;
+      hunkActive = true;
+      continue;
+    }
+    if (line.startsWith("---") || line.startsWith("+++")) continue;
+    if (line.startsWith("\\")) continue;
+    if (!hunkActive) continue;
+
+    const isMinus = line.startsWith("-");
+    const isPlus = line.startsWith("+");
+    const thisOldLine = oldLine;
+    const thisNewLine = newLine;
+    if (isMinus) {
+      oldLine += 1;
+    } else if (isPlus) {
+      newLine += 1;
+    } else {
+      oldLine += 1;
+      newLine += 1;
+    }
+    const inOldRange = lineInRange(thisOldLine, beforeRange);
+    const inNewRange = lineInRange(thisNewLine, afterRange);
+
+    const body = patchLineBody(line);
+    if (isMinus) {
+      const scanned = takePatchLineCode(
+        body,
+        oldSide.inBlockComment,
+        oldSide.inTemplate,
+      );
+      oldSide.inBlockComment = scanned.inBlockComment;
+      oldSide.inTemplate = scanned.inTemplate;
+      const code = scanned.code;
+      if (!inOldRange || !code.trim()) continue;
+      applyPatchStructure(oldSide, code);
+
+      const minus = keyLine.exec(code);
+      if (!minus) continue;
+      const key = minus[1]!;
+      const quote = minus[2]!;
+      const minusRest = minus[3]!;
+      const before = extractQuotedTail(minusRest, quote);
+      if (before == null) continue;
+
+      const plusLine = lines[i + 1];
+      if (!plusLine?.startsWith("+")) continue;
+      // Lookahead only — the + iteration owns newSide comment/template state.
+      const plusScan = takePatchLineCode(
+        patchLineBody(plusLine),
+        newSide.inBlockComment,
+        newSide.inTemplate,
+      );
+      const plus = keyLine.exec(plusScan.code);
+      if (!plus || plus[1] !== key) continue;
+      const after = extractQuotedTail(plus[3]!, plus[2]!);
+      if (after == null) continue;
+      if (before === after) continue;
+      // The + line has not been consumed yet; it sits at thisNewLine.
+      if (!inNewRange) continue;
+
+      const newAtPlus = clonePatchSide(newSide);
+      applyPatchStructure(newAtPlus, plusScan.code);
+      if (semanticFieldId(oldSide, key) !== semanticFieldId(newAtPlus, key)) {
+        continue;
+      }
+
+      const fieldPath = fieldPathFor(oldSide, key);
+      const label = labelForSiteField(fieldPath, {
+        serviceName:
+          oldSide.lastBlock && oldSide.lastBlock !== "services"
+            ? undefined
+            : oldSide.lastServiceName,
+      });
+      if (!label) continue;
+      const clipped = clipChangedValues(before, after);
+      if (
+        clipped.before != null &&
+        clipped.after != null &&
+        clipped.before === clipped.after
+      ) {
+        continue;
+      }
+      pairs.push({
+        label,
+        before: clipped.before,
+        after: clipped.after,
+      });
+      continue;
+    }
+
+    if (isPlus) {
+      const scanned = takePatchLineCode(
+        body,
+        newSide.inBlockComment,
+        newSide.inTemplate,
+      );
+      newSide.inBlockComment = scanned.inBlockComment;
+      newSide.inTemplate = scanned.inTemplate;
+      if (!inNewRange || !scanned.code.trim()) continue;
+      applyPatchStructure(newSide, scanned.code);
+      continue;
+    }
+
+    const oldScan = takePatchLineCode(
+      body,
+      oldSide.inBlockComment,
+      oldSide.inTemplate,
+    );
+    oldSide.inBlockComment = oldScan.inBlockComment;
+    oldSide.inTemplate = oldScan.inTemplate;
+    const newScan = takePatchLineCode(
+      body,
+      newSide.inBlockComment,
+      newSide.inTemplate,
+    );
+    newSide.inBlockComment = newScan.inBlockComment;
+    newSide.inTemplate = newScan.inTemplate;
+    // Context exists on both sides. If comment structure has already
+    // diverged, the two "code" views disagree — do not guess which
+    // one is the site copy for labeling. Apply each side only when
+    // that side's line is inside its own export.
+    if (oldScan.code !== newScan.code) {
+      continue;
+    }
+    if (!oldScan.code.trim()) continue;
+    if (inOldRange) applyPatchStructure(oldSide, oldScan.code);
+    if (inNewRange) applyPatchStructure(newSide, newScan.code);
+  }
+  return dedupePairs(pairs);
+}
+
+function extractQuotedTail(rest: string, quote: string): string | null {
+  // rest is the inside of the string plus the closing quote and trailing comma.
+  let raw = "";
+  for (let i = 0; i < rest.length; i++) {
+    const c = rest[i]!;
+    if (c === "\\") {
+      const n = rest[i + 1];
+      if (n == null) return null;
+      raw += c + n;
+      i++;
+      continue;
+    }
+    if (c === quote) return unquote(raw, quote);
+    raw += c;
+  }
+  return null;
+}
+
+export function wrapOwnerText(
+  text: string,
+  width: number = OWNER_BUBBLE_WIDTH,
+): string {
+  return text
+    .split("\n")
+    .map((line) => wrapLine(line, width))
+    .join("\n");
+}
+
+function wrapLine(line: string, width: number): string {
+  if (line.length <= width) return line;
+  // Column-0 only. An indented untrusted URL or SHA must not be
+  // promoted to a verified identity line.
+  if (/^https?:\/\//i.test(line)) return line;
+  if (/^[0-9a-f]{40,64}$/i.test(line)) return line;
+  const bullet = line.match(/^(\s*•\s)/);
+  const indent = line.match(/^(\s+)/)?.[1] ?? "";
+  const prefix = bullet?.[1] ?? indent;
+  const rest = line.slice(prefix.length);
+  const words = rest.split(/\s+/).filter(Boolean);
+  if (words.length === 0) return line;
+  const out: string[] = [];
+  let cur = prefix;
+  // Always hang-indent continuations. A column-0 wrap of untrusted
+  // copy is how `https://…` or `Draft ready.` impersonates a status line.
+  const cont = bullet ? "  " : prefix || "  ";
+  for (const w of words) {
+    if (!cur.trim()) {
+      cur = (cur.startsWith(prefix) ? prefix : cont) + w;
+      continue;
+    }
+    if (`${cur} ${w}`.length <= width) {
+      cur = `${cur} ${w}`;
+    } else {
+      out.push(cur);
+      cur = cont + w;
+    }
+  }
+  if (cur) out.push(cur);
+  return out.join("\n");
+}
+
+/**
+ * GitHub environment identity for a deployment. Prefer the original
+ * name so a later rename does not split one project into two.
+ */
+export function draftEnvironmentIdentity(dep: {
+  environment?: string;
+  original_environment?: string;
+}): string {
+  const original = (dep.original_environment ?? "").trim().toLowerCase();
+  if (original) return original;
+  return (dep.environment ?? "").trim().toLowerCase();
+}
+
+/**
+ * GitHub-reported Vercel Git integration. A paid tier, a repo grant, and
+ * an environment named "Preview" are not a Vercel project binding — Chromatic,
+ * Storybook, and docs apps also create successful Preview deployments.
+ */
+export function isVercelHostingDeployment(dep: {
+  creator?: { login?: string } | null;
+  performed_via_github_app?: { slug?: string } | null;
+}): boolean {
+  const slug = String(dep.performed_via_github_app?.slug ?? "")
+    .trim()
+    .toLowerCase();
+  if (slug === "vercel") return true;
+  const login = String(dep.creator?.login ?? "").trim().toLowerCase();
+  return login === "vercel[bot]";
+}
+
+type GitHubDeploymentStatusJson = {
+  state?: string;
+  created_at?: string;
+  environment_url?: string | null;
+  log_url?: string | null;
+  target_url?: string | null;
+  creator?: { login?: string } | null;
+  performed_via_github_app?: { slug?: string } | null;
+};
+
+type GitHubDeploymentJson = {
+  id: number;
+  created_at?: string;
+  environment?: string;
+  original_environment?: string;
+  production_environment?: boolean;
+  transient_environment?: boolean;
+  creator?: { login?: string } | null;
+  performed_via_github_app?: { slug?: string } | null;
