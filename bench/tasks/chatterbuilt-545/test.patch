+function render(config: unknown): string {
+  const result = renderSiteTs(JSON.stringify(config));
+  if (!result.ok) {
+    throw new Error(result.errors.join("; "));
+  }
+  return result.source;
+}
+
+/** After-file whose exported site object covers `hours` at hunkStartLine. */
+function siteSourceHoursAt(hunkStartLine: number, detail: string): string {
+  const exportLine = hunkStartLine - 1;
+  const pads = Math.max(0, exportLine - 1);
+  return [
+    ...Array.from({ length: pads }, () => "// pad"),
+    "export const site = {",
+    "    hours: {",
+    '       note: "Mon–Fri 8am–5pm",',
+    `      detail: "${detail}",`,
+    "     },",
+    "};",
+  ].join("\n");
+}
