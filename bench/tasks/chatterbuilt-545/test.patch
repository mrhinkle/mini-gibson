+  it("production Vercel deploys are the live customer site; auxiliary production is not", () => {
+    expect(isCustomerSiteProductionDeployment(productionDeploy(1))).toBe(true);
+    expect(
+      isCustomerSiteProductionDeployment(
+        vercelDeploy(2, "production", { production_environment: true }),
+      ),
+    ).toBe(true);
+    expect(isCustomerSiteProductionDeployment(vercelDeploy(3))).toBe(false);
+    expect(
+      isCustomerSiteProductionDeployment({
+        environment: "Production",
+        production_environment: true,
+      }),
+    ).toBe(false);
+    expect(
+      isCustomerSiteProductionDeployment(
+        vercelDeploy(4, "Production – storybook", {
+          production_environment: true,
+        }),
+      ),
+    ).toBe(false);
+  });
+
+  it("compound environment names are not live production when GitHub says they are not", () => {
+    // `pre-production` matches the old substring regex: `-` is [^a-z]
+    // and the string ends on "production". GitHub already said this is
+    // not production (`production_environment: false`). Treating it as
+    // the live site lets a Preview from that staging project bind.
+    const compound = [
+      "pre-production",
+      "post-production",
+      "production-canary",
+      "production2",
+      "live-preview",
+      "prod-backup",
+      "my-production",
+    ];
+    for (const env of compound) {
+      expect(
+        isCustomerSiteProductionDeployment(
+          vercelDeploy(1, env, { production_environment: false }),
+        ),
+        env,
+      ).toBe(false);
+    }
+    // Exact names remain the fallback when the flag is missing/false.
+    expect(
+      isCustomerSiteProductionDeployment(
+        vercelDeploy(2, "production", { production_environment: false }),
+      ),
+    ).toBe(true);
+    expect(
+      isCustomerSiteProductionDeployment(
+        vercelDeploy(3, "Production", { production_environment: false }),
+      ),
+    ).toBe(true);
+    expect(
+      isCustomerSiteProductionDeployment(
+        vercelDeploy(4, "prod", { production_environment: false }),
+      ),
+    ).toBe(true);
+    expect(
+      isCustomerSiteProductionDeployment(
+        vercelDeploy(5, "live", { production_environment: false }),
+      ),
+    ).toBe(true);
+  });
+});
