+      await expect(
+        previewChange({
+          owner: "acme",
+          repo: "shop",
+          number: 12,
+        }),
+      ).rejects.toThrow(/authenticated Chatterbuilt account is required/i);
+      expect(fetchSpy).not.toHaveBeenCalled();
