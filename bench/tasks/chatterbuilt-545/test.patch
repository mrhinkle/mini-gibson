+    return vi.fn(async (input: RequestInfo | URL) => {
+      const url = String(input);
+      const kind = deploymentUrlKind(url);
+      if (kind === "statuses") {
+        const id = /\/deployments\/(\d+)\/statuses/.exec(url)?.[1] ?? "";
+        const body = opts.statuses?.[id] ?? opts.defaultStatuses ?? [];
+        return json(body);
