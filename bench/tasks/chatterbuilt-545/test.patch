+      isVercelHostingDeployment({
+        creator: { login: "chromatic-com[bot]" },
+        performed_via_github_app: { slug: "chromatic" },
+      }),
+    ).toBe(false);
+    expect(isVercelHostingDeployment(VERCEL_HOSTING)).toBe(true);
+  });
+
+  it("does not treat a transient non-preview app as the customer draft", () => {
+    expect(
+      isDraftPreviewEnvironment(
+        vercelDeploy(1, "storybook", { transient_environment: true }),
+      ),
+    ).toBe(false);
+    expect(
+      isDraftPreviewEnvironment(
+        vercelDeploy(2, "chromatic", { transient_environment: true }),
+      ),
+    ).toBe(false);
+    expect(
+      isDraftPreviewEnvironment(
+        vercelDeploy(3, "docs", { transient_environment: true }),
+      ),
+    ).toBe(false);
+    expect(
+      isDraftPreviewEnvironment({
+        transient_environment: true,
+        ...VERCEL_HOSTING,
+      }),
+    ).toBe(false);
+    expect(
+      isDraftPreviewEnvironment(vercelDeploy(4, "Preview – storybook")),
+    ).toBe(false);
