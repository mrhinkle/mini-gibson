+    };
+  }
+
+  function deploymentUrlKind(
+    url: string,
+  ): "sha" | "repo" | "statuses" | "other" {
+    if (url.includes("/statuses")) return "statuses";
+    if (!url.includes("/deployments")) return "other";
+    if (/[?&]sha=/.test(url)) return "sha";
+    return "repo";
