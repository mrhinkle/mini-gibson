+
+function makeClient(
+  overrides: Partial<PreviewDiffClient> & {
+    files?: PreviewFile[];
+    title?: string;
+    beforeSrc?: string | null;
+    afterSrc?: string | null;
+    /** Contents at the current base-branch tip (must not be used as "before"). */
+    baseTipSrc?: string | null;
+    mergeBaseSha?: string | null;
+    baseSha?: string;
+    headSha?: string;
+    baseRef?: string;
+    defaultBranch?: string;
+    state?: string;
+    merged?: boolean;
+    filesTruncated?: boolean;
+    changedFiles?: number | null;
+    deploy?: {
+      url: string | null;
+      status: "ready" | "building" | "failed" | "none" | "unavailable";
+      warning?: string | null;
+    };
+  } = {},
+): PreviewDiffClient {
+  const files =
+    overrides.files ??
+    ([{ filename: "content/site.ts", status: "modified" }] satisfies PreviewFile[]);
+  const headSha = overrides.headSha ?? "headsha";
+  const baseSha = overrides.baseSha ?? "basesha";
+  const mergeBaseSha =
+    overrides.mergeBaseSha === undefined ? "basesha" : overrides.mergeBaseSha;
+
+  return {
+    getPull: overrides.getPull ??
+      vi.fn().mockResolvedValue({
+        number: 12,
+        title: overrides.title ?? "Update Saturday hours",
+        headSha,
+        baseSha,
+        mergeBaseSha,
+        headRef: "feat/hours",
+        baseRef: overrides.baseRef ?? "main",
+        defaultBranch: overrides.defaultBranch ?? "main",
+        state: overrides.state ?? "open",
+        merged: overrides.merged ?? false,
+        changedFiles:
+          overrides.changedFiles === undefined
+            ? files.length
+            : overrides.changedFiles,
+        filesTruncated: overrides.filesTruncated ?? false,
+        files,
+      }),
+    getPreviewDeploy:
+      overrides.getPreviewDeploy ??
+      vi.fn().mockResolvedValue(
+        overrides.deploy ?? {
+          url: "https://northgate-git-feat-hours.vercel.app",
+          status: "ready",
+        },
+      ),
+    getFileAtRef:
+      overrides.getFileAtRef ??
+      vi.fn(async ({ ref }: { ref: string }) => {
+        if (mergeBaseSha && ref === mergeBaseSha) {
+          return overrides.beforeSrc ?? null;
+        }
+        if (ref === headSha) return overrides.afterSrc ?? null;
+        if (ref === baseSha) return overrides.baseTipSrc ?? null;
+        return null;
+      }),
+  };
+}
+
+function isIdentityLine(line: string): boolean {
+  if (/^\s*https?:\/\//i.test(line)) return true;
+  // Draft SHAs are the approval binding. Do not wrap or reject them.
+  if (/^[0-9a-f]{40,64}$/i.test(line.trim())) return true;
+  return false;
+}
+
+function assertOwnerSafe(text: string) {
+  for (const line of text.split("\n")) {
+    expect(looksLikeFilePathOrHunk(line), line).toBe(false);
+    expect(line).not.toMatch(/\bpull request\b/i);
+    expect(line).not.toMatch(/\bmerge\b/i);
+    expect(line).not.toMatch(/\bhunk\b/i);
+    if (!isIdentityLine(line)) {
+      expect(line.length, line).toBeLessThanOrEqual(OWNER_BUBBLE_WIDTH);
+    }
+  }
+}
