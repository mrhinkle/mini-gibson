+      globalThis.fetch = prevFetch;
+      if (originalGrants === undefined) {
+        delete process.env.UPDATE_BOT_REPO_GRANTS_JSON;
+      } else {
+        process.env.UPDATE_BOT_REPO_GRANTS_JSON = originalGrants;
