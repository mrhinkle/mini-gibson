-/**
- * Config keys that name tenant-internal rows. A manifest is portable content;
- * it must never carry database identity, which the seed assigns at apply time.
- * Checked on KEYS at every depth — a value-substring scan trips on ordinary
- * copy ("expectation" contains "cta") and on fields the schemas require
- * (AUDIENCE_BAND tiles need `source`, PLACE facts need an https `sourceHref`).
- */
-const RESTRICTED_CONFIG_KEY = /^(id|organizationId|eventId|sectionId)$/u;
-
-function collectKeys(value: unknown, into: string[] = []): string[] {
-  if (Array.isArray(value)) {
-    for (const item of value) collectKeys(item, into);
-  } else if (value !== null && typeof value === "object") {
-    for (const [key, child] of Object.entries(value)) {
-      into.push(key);
-      collectKeys(child, into);
-    }
-  }
-  return into;
-}
-
-function isPlainOwnDataRecord(
-  value: unknown,
-): value is Record<string, unknown> {
-  if (value === null || typeof value !== "object" || Array.isArray(value))
-    return false;
-  if (Object.getPrototypeOf(value) !== Object.prototype) return false;
-  return Reflect.ownKeys(value).every((key) => {
-    if (typeof key !== "string") return false;
-    const descriptor = Object.getOwnPropertyDescriptor(value, key);
-    return (
-      descriptor?.enumerable === true && Object.hasOwn(descriptor, "value")
-    );
-  });
-}
-
-function cloneJson<T>(value: T): T {
-  return JSON.parse(JSON.stringify(value)) as T;
-}
-
-function validateManifestContract(value: unknown): asserts value is Manifest {
-  if (!isPlainOwnDataRecord(value)) throw new Error("invalid envelope");
-  if (Reflect.ownKeys(value).sort().join(",") !== "sections,version") {
-    throw new Error("invalid envelope keys");
-  }
-  if (value.version !== 1 || !Array.isArray(value.sections)) {
-    throw new Error("invalid envelope");
-  }
-  if (value.sections.length !== EXPECTED_SECTIONS.length) {
-    throw new Error("invalid section count");
-  }
-
-  const seen = new Set<string>();
-  for (const [index, candidate] of value.sections.entries()) {
-    if (!isPlainOwnDataRecord(candidate)) throw new Error("invalid section");
-    if (
-      Reflect.ownKeys(candidate).sort().join(",") !==
-      "config,isVisible,key,type"
-    ) {
-      throw new Error("invalid section keys");
-    }
-
-    const expected = EXPECTED_SECTIONS[index]!;
-    if (
-      candidate.key !== expected.key ||
-      candidate.type !== expected.type ||
-      candidate.isVisible !== expected.isVisible
-    ) {
-      throw new Error("invalid section order or identity");
-    }
-    if (
-      typeof candidate.key !== "string" ||
-      candidate.key.length < MIN_HOMEPAGE_SECTION_KEY_LENGTH ||
-      candidate.key.length > MAX_HOMEPAGE_SECTION_KEY_LENGTH ||
-      seen.has(candidate.key) ||
-      !isHomepageSectionType(candidate.type) ||
-      !HOMEPAGE_SECTION_TYPES.includes(candidate.type)
-    ) {
-      throw new Error("invalid section identity");
-    }
-    if (!isPlainOwnDataRecord(candidate.config))
-      throw new Error("invalid config");
-    const restrictedKeys = collectKeys(candidate.config).filter((key) =>
-      RESTRICTED_CONFIG_KEY.test(key),
-    );
-    if (restrictedKeys.length > 0) {
-      throw new Error("restricted tenant identity in config");
-    }
-
-    if (candidate.isVisible) {
-      const normalized = parseHomepageSectionConfig(
-        candidate.type,
-        candidate.config,
-      );
-      if (!normalized) throw new Error("visible config does not parse");
-      // The organizer save action's round-trip gate: normalizing the
-      // normalized output must be a fixed point, or the row would drift on
-      // its first admin save.
-      const again = parseHomepageSectionConfig(candidate.type, normalized);
-      if (JSON.stringify(again) !== JSON.stringify(normalized)) {
-        throw new Error("visible config is not idempotent");
-      }
-      // The event page keeps its flip tiles; the root shows the wall of years.
-      const speakerStyle = candidate.key.startsWith("home-") ? "wall" : "flip";
-      if (candidate.type === "SPEAKERS" && normalized.style !== speakerStyle) {
-        throw new Error(`speakers must use the ${speakerStyle} style here`);
-      }
-    } else if (Reflect.ownKeys(candidate.config).length !== 0) {
-      throw new Error("hidden config must stay inert");
-    }
-    seen.add(candidate.key);
-  }
-}
-
-function parseManifest(bytes: Uint8Array = MANIFEST_BYTES): Manifest {
-  const value: unknown = JSON.parse(Buffer.from(bytes).toString("utf8"));
-  validateManifestContract(value);
-  return value;
-}
