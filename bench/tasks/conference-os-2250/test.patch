-/**
- * Owner-approved row identity for the All Things AI root homepage: the
- * 2027 comp approved 2026-09-05 (order, type, visibility). Content lives in
- * the manifest and is pinned by APPROVED_MANIFEST_SHA256 below — the same
- * value the production apply workflow (#1947) requires as its dispatch
- * input — so a content change is a deliberate, reviewed edit to this pin.
- *
- * Display-only types (PHOTO_COLLAGE, TESTIMONIALS, EVENTS_DIRECTORY,
- * SPONSOR_MARQUEE, SPONSORSHIP, NEWSLETTER, CONTACT) have no config schema
- * and can only be seeded hidden; TICKETS / SESSION_LIBRARY stay hidden until
- * their data exists. They are flipped visible after adoption, not here.
- *
- * The `home-*` rows are the events.allthingsai.org root (#1983): the homepage
- * surface split renders them on `/` only, and the featured event page keeps
- * the rows above.
- */
-interface ExpectedSection {
-  readonly key: string;
-  readonly type: HomepageSectionType;
-  readonly isVisible: boolean;
-}
-
