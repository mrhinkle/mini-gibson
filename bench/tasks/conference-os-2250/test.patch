-function createDatabaseHarness(initialRows: readonly StoredSection[] = []) {
-  const committed: StoredSection[] = cloneJson([...initialRows]);
-  const created: CreatedSection[] = [];
-  const eventReads: string[] = [];
-
-  function readClient(rows: StoredSection[]) {
-    return {
-      organization: {
-        async findMany() {
-          return [{ ...ORGANIZATION }];
-        },
-      },
-      event: {
-        async findUnique(args: { where: { slug: string } }) {
-          eventReads.push(args.where.slug);
-          return null;
-        },
-      },
-      homepageSection: {
-        async findMany(args: {
-          where: { organizationId: string; key: { in: string[] } };
-        }) {
-          const keys = new Set(args.where.key.in);
-          return cloneJson(rows.filter((row) => keys.has(row.key)));
-        },
-      },
-    };
-  }
-
-  const outer = readClient(committed);
-  const database = {
-    ...outer,
-    async $transaction<T>(callback: (tx: never) => Promise<T>): Promise<T> {
-      const working = cloneJson(committed);
-      const transaction = readClient(working);
-      const tx = {
-        ...transaction,
-        homepageSection: {
-          ...transaction.homepageSection,
-          async create(args: { data: CreatedSection }) {
-            const data = cloneJson(args.data);
-            created.push(data);
-            const { organizationId: _organizationId, ...row } = data;
-            working.push(row);
-            return { id: `created-${working.length}` };
-          },
-        },
-      };
-      const result = await callback(tx as never);
-      committed.splice(0, committed.length, ...working);
-      return result;
-    },
-    async $disconnect() {},
-  } as unknown as HomepageSeedDatabase;
-
-  return { database, committed, created, eventReads };
-}
-
-async function execute(
-  harness: ReturnType<typeof createDatabaseHarness>,
-  apply: boolean,
-) {
-  const output: string[] = [];
-  const code = await run({
-    argv: ["all-things-ai", MANIFEST_PATH, ...(apply ? ["--apply"] : [])],
-    env: { DATABASE_URL: SAFE_DATABASE_URL },
-    manifestBytes: MANIFEST_BYTES,
-    createDatabase: () => harness.database,
-    writeReceipt: (json) => {
-      output.push(json);
-    },
-    writeFallbackReceipt: () => {
-      throw new Error("unexpected fallback receipt");
-    },
-  });
-  return {
-    code,
-    receipt: JSON.parse(output[0]!) as HomepageSeedReceipt,
-  };
-}
-
-/** Mutants start from the REAL approved manifest so each change is the only defect. */
-function mutate(change: (manifest: MutableManifest) => void) {
-  const value = cloneJson(parseManifest()) as unknown as MutableManifest;
-  change(value);
-  return value;
-}
